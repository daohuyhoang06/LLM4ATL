<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="semPrePostDemo" nsURI="urn:llm4atl:efinder:sem-pre-post-demo"
    nsPrefix="demo">
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
  </eAnnotations>

  <!-- Source model: source-pre.ocl is injected into this classifier. -->
  <eClassifiers xsi:type="ecore:EClass" name="Input">
    <eAnnotations source="urn:llm4atl:provenance">
      <details key="origin" value="source"/>
      <details key="preConstraints" value=""/>
      <details key="postConstraints" value=""/>
      <details key="semConstraints" value=""/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Target model: target-post.ocl is injected into this classifier. -->
  <eClassifiers xsi:type="ecore:EClass" name="Output">
    <eAnnotations source="urn:llm4atl:provenance">
      <details key="origin" value="target"/>
      <details key="preConstraints" value=""/>
      <details key="postConstraints" value=""/>
      <details key="semConstraints" value=""/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Trace output used by the runner to require a concrete transformed Output. -->
  <eClassifiers xsi:type="ecore:EClass" name="Copy">
    <eAnnotations source="urn:llm4atl:provenance">
      <details key="origin" value="trace"/>
      <details key="atlRule" value="Copy"/>
      <details key="semConstraints" value="CopySemantics"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CopySemantics"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <!-- Sem: the trace copies the source value to the target. -->
      <details key="CopySemantics" value="self.output.value = self.input.value"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="input" lowerBound="1" eType="//Input"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="output" lowerBound="1" eType="//Output"/>
  </eClassifiers>
</ecore:EPackage>
