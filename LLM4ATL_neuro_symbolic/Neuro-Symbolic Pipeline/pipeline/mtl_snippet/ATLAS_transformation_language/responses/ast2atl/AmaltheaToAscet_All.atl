module AmaltheaToAscet_All;
create OUT : Ascet from IN : Amalthea;

rule ComponentContainer2AscetModule {
    from
        s : Amalthea!ComponentContainer
    to
        t : Ascet!AscetModule (
            tasks <- s.tasks->collect(task | thisModule.Task2SoftwareTask(task))
        )
}

rule TaskRoot2SoftwareTask {
    from
        s : Amalthea!Task (
            Amalthea!ComponentContainer.allInstances()->forAll(c | not c.tasks->includes(s))
        )
    to
        t : Ascet!SoftwareTask (
            name <- s.name
        )
}

lazy rule Task2SoftwareTask {
    from
        s : Amalthea!Task
    to
        t : Ascet!SoftwareTask (
            name <- s.name
        )
}

