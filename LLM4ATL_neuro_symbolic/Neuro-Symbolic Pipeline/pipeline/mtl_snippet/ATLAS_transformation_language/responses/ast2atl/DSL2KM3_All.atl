module DSL2KM3;
create OUT : KM3 from IN : DSL;

helper context DSL!Relationship def: needTurnOnClass() : Boolean =
    (((self.properties->size() > 0) or not self.superType.oclIsUndefined()) or (self.subTypes->size() > 0));

helper context DSL!Class def: getRoles() : Set(DSL!Role) =
    DSL!Role.allInstances()->select(r | ((r.source = self) and not r.relation.needTurnOnClass()));

helper context DSL!Role def: isEmbedding() : Boolean =
    self.relation.isEmbedding;

rule DomainModel {
    from
        s : DSL!DomainModel
    to
        m : KM3!Metamodel (
            contents <- Set{p, pt}
        ),
        p : KM3!Package (
            name <- s.name,
            contents <- s.classifiers
        ),
        pt : KM3!Package (
            name <- 'PrimitiveTypes',
            contents <- s.types
        )
}

rule Class {
    from
        s : DSL!Class
    to
        t : KM3!Class (
            name <- s.name,
            isAbstract <- s.isAbstract,
            supertypes <- if s.superType.oclIsUndefined() then
    Set{}
else
    Set{s.superType}
endif,
            structuralFeatures <- s.properties->union(s.getRoles())
        )
}

rule Relation2Class {
    from
        s : DSL!Relationship (
            s.needTurnOnClass()
        )
    to
        t : KM3!Class (
            name <- s.name,
            isAbstract <- s.isAbstract,
            supertypes <- if s.superType.oclIsUndefined() then
    Set{}
else
    Set{s.superType}
endif,
            structuralFeatures <- s.properties->union(s.roles)
        )
}

rule SimpleReference {
    from
        s : DSL!Role (
            not s.relation.needTurnOnClass()
        )
    to
        t : KM3!Reference (
            name <- s.name,
            lower <- s.min,
            upper <- s.max,
            isOrdered <- s.isOrdered,
            isUnique <- false,
            type <- s.type,
            isContainer <- s.isEmbedding(),
            opposite <- s.relation->reject(r | (r = s))
        )
}

rule ComplexReference {
    from
        s : DSL!Role (
            s.relation.needTurnOnClass()
        )
    to
        t : KM3!Reference (
            name <- s.name,
            lower <- s.min,
            upper <- s.max,
            isOrdered <- s.isOrdered,
            isUnique <- false,
            type <- s.type,
            isContainer <- s.isEmbedding()
        )
}

rule Attribute {
    from
        s : DSL!ValueProperty
    to
        t : KM3!Attribute (
            name <- s.name,
            lower <- 1,
            upper <- 1,
            isOrdered <- false,
            isUnique <- false,
            type <- s.type
        )
}

rule Enumeration {
    from
        s : DSL!Enumeration
    to
        t : KM3!Enumeration (
            name <- s.name,
            literals <- s.literals
        )
}

rule EnumLiteral {
    from
        s : DSL!EnumerationLiteral
    to
        t : KM3!EnumLiteral (
            name <- s.name
        )
}

rule DataType {
    from
        s : DSL!SimpleType
    to
        t : KM3!DataType (
            name <- s.name
        )
}

