module DSL2KM3;
create OUT : KM3 from IN : DSL;

helper context DSL!Relationship def: needTurnOnClass() : Boolean =
    (self.properties->notEmpty() or (not self.superType.oclIsUndefined() or self.subTypes->notEmpty()));

helper context DSL!Classifier def: getRoles() : Set(DSL!Role) =
    DSL!Role.allInstances()->select(r | ((r.source = self) and not r.relation.needTurnOnClass()));

helper context DSL!Role def: isEmbedding() : Boolean =
    self.relation.isEmbedding;

rule Metamodel {
    from
        dm : DSL!DomainModel
    to
        km3_metamodel : KM3!Metamodel (
            contents <- Set{main_package, prim_package}
        ),
        main_package : KM3!Package (
            name <- dm.name,
            contents <- dm.classifiers->union(dm.types)
        ),
        prim_package : KM3!Package (
            name <- 'PrimitiveTypes',
            contents <- Set{pt_boolean, pt_integer, pt_string}
        ),
        pt_boolean : KM3!DataType (
            name <- 'Boolean'
        ),
        pt_integer : KM3!DataType (
            name <- 'Integer'
        ),
        pt_string : KM3!DataType (
            name <- 'String'
        )
}

rule Class {
    from
        c : DSL!Class
    to
        k_class : KM3!Class (
            name <- c.name,
            isAbstract <- c.isAbstract,
            supertypes <- DSL!Classifier.allInstances()->select(x | (x = c.superType)),
            structuralFeatures <- c.properties->union(c.getRoles())
        )
}

rule Relation2Class {
    from
        rel : DSL!Relationship (
            rel.needTurnOnClass()
        )
    to
        c : KM3!Class (
            name <- rel.name,
            isAbstract <- rel.isAbstract,
            supertypes <- DSL!Classifier.allInstances()->select(x | (x = rel.superType)),
            structuralFeatures <- rel.properties->union(rel.roles)
        )
}

rule SimpleReference {
    from
        r : DSL!Role (
            not r.relation.needTurnOnClass()
        )
    to
        ref : KM3!Reference (
            name <- r.name,
            type <- r.type,
            lower <- r.min,
            upper <- r.max,
            isOrdered <- r.isOrdered,
            isUnique <- true,
            isContainer <- r.isEmbedding(),
            opposite <- r.relation.roles->reject(x | (x = r))->first()
        )
}

rule ComplexReference {
    from
        r : DSL!Role (
            r.relation.needTurnOnClass()
        )
    to
        ref : KM3!Reference (
            name <- r.name,
            type <- r.type,
            lower <- r.min,
            upper <- r.max,
            isOrdered <- r.isOrdered,
            isUnique <- true,
            isContainer <- r.isEmbedding()
        )
}

rule Attribute {
    from
        vp : DSL!ValueProperty
    to
        attr : KM3!Attribute (
            name <- vp.name,
            type <- vp.type,
            lower <- 1,
            upper <- 1,
            isOrdered <- false,
            isUnique <- true
        )
}

rule Enumeration {
    from
        e : DSL!Enumeration
    to
        k_enum : KM3!Enumeration (
            name <- e.name,
            literals <- e.literals
        )
}

rule EnumLiteral {
    from
        el : DSL!EnumerationLiteral
    to
        k_el : KM3!EnumLiteral (
            name <- el.name
        )
}

rule DataType {
    from
        st : DSL!SimpleType
    to
        dt : KM3!DataType (
            name <- st.name
        )
}

