module DSL2KM3;
create OUT : KM3 from IN : DSL;

helper context DSL!Classifier def: needTurnOnClass() : Boolean =
    if self.oclIsKindOf(DSL!Relationship) then
        (((not self.superType.oclIsUndefined() or self.subTypes->notEmpty()) or self.properties->notEmpty()) or DSL!Role.allInstances()->exists(role | (role.type = self)))
    else
        false
    endif;

helper context DSL!Role def: isEmbedding() : Boolean =
    self.relation.isEmbedding;

helper context DSL!Class def: getRoles() : Sequence(DSL!Role) =
    DSL!Role.allInstances()->select(r | ((r.source = self) and not r.relation.needTurnOnClass()));

rule Metamodel {
    from
        s : DSL!DomainModel
    to
        t : KM3!Metamodel (
            contents <- Set{p_main, p_prim}
        ),
        p_main : KM3!Package (
            name <- s.namespace,
            contents <- s.classifiers->select(c | (c.oclIsTypeOf(DSL!Class) or c.needTurnOnClass()))->union(s.types)
        ),
        p_prim : KM3!Package (
            name <- 'PrimitiveTypes',
            contents <- Set{dt_string, dt_int, dt_bool}
        ),
        dt_string : KM3!DataType (
            name <- 'String'
        ),
        dt_int : KM3!DataType (
            name <- 'Integer'
        ),
        dt_bool : KM3!DataType (
            name <- 'Boolean'
        )
}

rule Class {
    from
        s : DSL!Class
    to
        t : KM3!Class (
            name <- s.name,
            isAbstract <- s.isAbstract,
            supertypes <- if s.superType.oclIsUndefined() then
    Set{}
else
    Set{s.superType}
endif,
            structuralFeatures <- s.properties->union(s.getRoles())
        )
}

rule Relation2Class {
    from
        s : DSL!Relationship (
            s.needTurnOnClass()
        )
    to
        t : KM3!Class (
            name <- s.name,
            isAbstract <- s.isAbstract,
            supertypes <- if s.superType.oclIsUndefined() then
    Set{}
else
    Set{s.superType}
endif,
            structuralFeatures <- s.properties->union(s.roles)
        )
}

rule SimpleReference {
    from
        s : DSL!Role (
            s.relation.needTurnOnClass()
        )
    to
        t : KM3!Reference (
            name <- s.name,
            lower <- s.min,
            upper <- if s.isUnbounded then
    (0 - 1)
else
    s.max
endif,
            isOrdered <- s.isOrdered,
            isUnique <- true,
            type <- s.type,
            isContainer <- s.isEmbedding()
        )
}

rule ComplexReference {
    from
        s : DSL!Role (
            not s.relation.needTurnOnClass()
        )
    to
        t : KM3!Reference (
            name <- s.name,
            lower <- s.min,
            upper <- if s.isUnbounded then
    (0 - 1)
else
    s.max
endif,
            isOrdered <- s.isOrdered,
            isUnique <- true,
            type <- s.type,
            isContainer <- s.isEmbedding(),
            opposite <- s.relation.roles->any(r | (r <> s))
        )
}

rule Attribute {
    from
        s : DSL!ValueProperty
    to
        t : KM3!Attribute (
            name <- s.name,
            lower <- 1,
            upper <- 1,
            isOrdered <- false,
            isUnique <- true,
            type <- s.type
        )
}

rule Enumeration {
    from
        s : DSL!Enumeration
    to
        t : KM3!Enumeration (
            name <- s.name,
            literals <- s.literals
        )
}

rule EnumLiteral {
    from
        s : DSL!EnumerationLiteral
    to
        t : KM3!EnumLiteral (
            name <- s.name
        )
}

rule DataType {
    from
        s : DSL!SimpleType
    to
        t : KM3!DataType (
            name <- s.name
        )
}

