module IEEE1471_2_MoDAF;
create OUT : MoDAF from IN : IEEE1471;

helper def: rationale : String =
    let
        r : IEEE1471!Rationale = IEEE1471!Rationale.allInstances()->first()
    in
        if r.oclIsUndefined() then
        ''
    else
        (r.name + r.content)
    endif;

rule IEEE1471Model2MoDAFModel {
    from
        s : IEEE1471!IEEE1471Model
    to
        m : MoDAF!MoDAFModel (
            name <- s.name,
            content <- s.content,
            enterprise <- s.system,
            environment <- s.environment,
            operationalMissions <- s.missions,
            architectures <- s.architecture,
            architecturalDescription <- s.architecturalDescription,
            stakeholders <- s.stakeholders,
            architecturalFrameworks <- Set{af}->union(IEEE1471!LibraryViewpoint.allInstances())
        ),
        af : MoDAF!ArchitecturalFramework (
            name <- 'default',
            ownedMember <- IEEE1471!Viewpoint.allInstances()->select(v | v.hasSource.oclIsUndefined())
        )
}

rule System2Enterprise {
    from
        s : IEEE1471!System
    to
        t : MoDAF!Enterprise (
            name <- s.name,
            content <- s.content,
            inhabits <- s.inhabits,
            fulfills <- s.fulfills
        )
}

rule Environment2Environment {
    from
        s : IEEE1471!Environment
    to
        t : MoDAF!Environment (
            name <- s.name,
            content <- s.content,
            influences <- s.influences
        )
}

rule Mission2OperationalMission {
    from
        s : IEEE1471!Mission
    to
        t : MoDAF!OperationalMission (
            name <- s.name,
            content <- s.content
        )
}

rule Architecture2Architecture {
    from
        s : IEEE1471!Architecture
    to
        t : MoDAF!Architecture (
            name <- s.name,
            content <- s.content,
            describedBy <- s.describedBy
        )
}

rule AD2AD {
    from
        s : IEEE1471!ArchitecturalDescription
    to
        t : MoDAF!ArchitecturalDescription (
            name <- s.name,
            content <- s.content,
            viewpoints <- s.organizedBy,
            products <- s.organizedBy,
            approvialAuthority <- 'default',
            architect <- 'default',
            assumptionAndConstraints <- 'default',
            creatingOrganisation <- 'default',
            dateCompleted <- 'default',
            purpose <- 'default',
            recommendations <- 'default',
            summaryOfFindings <- thisModule.rationale,
            tollsUsed <- 'default'
        )
}

rule Stakeholder2Stakeholder {
    from
        s : IEEE1471!Stakeholder
    to
        t : MoDAF!Stakeholder (
            name <- s.name,
            content <- s.content
        )
}

rule Viewpoint2View {
    from
        s : IEEE1471!Viewpoint
    to
        t : MoDAF!View (
            name <- s.name,
            content <- s.content,
            viewName <- s.name,
            viewDescription <- if s.content.oclIsUndefined() then
    ''
else
    s.content
endif,
            viewCode <- s.name,
            framework <- if s.hasSource.oclIsUndefined() then
    'default'
else
    s.hasSource.name
endif,
            frameworkWebsite <- 'default',
            definingFramework <- s.hasSource
        )
}

rule View2ArchitecturalProduct {
    from
        s : IEEE1471!View
    to
        t : MoDAF!ArchitecturalProduct (
            name <- s.name,
            content <- s.content,
            description <- if s.content.oclIsUndefined() then
    ''
else
    s.content
endif,
            definingView <- s.conformsTo,
            architecturalElements <- s.consitsOf
        )
}

rule Model2Element {
    from
        s : IEEE1471!Model
    to
        t : MoDAF!Elements (
            name <- s.name,
            content <- s.content
        )
}

rule Concern2Concern {
    from
        s : IEEE1471!Concern
    to
        t : MoDAF!Concern (
            name <- s.name,
            content <- s.content
        )
}

rule LibraryViewpoint2ArchitecturalFramework {
    from
        s : IEEE1471!LibraryViewpoint
    to
        t : MoDAF!ArchitecturalFramework (
            name <- s.name,
            content <- s.content
        )
}

rule StakeholderHasConcern {
    from
        st : IEEE1471!Stakeholder,
        con : IEEE1471!Concern (
            st.has->includes(con)
        )
    to
        shc : MoDAF!StakeholderHasConcern (
            client <- st,
            supplier <- con,
            owner <- IEEE1471!IEEE1471Model.allInstances()->first()
        )
}

