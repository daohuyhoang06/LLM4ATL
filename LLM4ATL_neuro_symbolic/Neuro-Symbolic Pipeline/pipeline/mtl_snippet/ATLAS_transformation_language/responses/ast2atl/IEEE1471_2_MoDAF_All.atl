module IEEE1471_2_MoDAF;
create OUT : MoDAF from IN : IEEE1471;

helper context IEEE1471!IEEE1471Model def: rationale : String =
    IEEE1471!Rationale.allInstances()->first().name.concat(IEEE1471!Rationale.allInstances()->first().content);

rule IEEE1471Model2MoDAFModel {
    from
        s : IEEE1471!IEEE1471Model
    to
        t : MoDAF!MoDAFModel (
            name <- s.name,
            content <- s.content,
            enterprise <- s.system,
            environment <- s.environment,
            operationalMissions <- s.missions,
            architectures <- s.architecture,
            architecturalDescription <- s.architecturalDescription,
            stakeholders <- s.stakeholders,
            architecturalFrameworks <- IEEE1471!LibraryViewpoint.allInstances()->union(Set{af})
        ),
        af : MoDAF!ArchitecturalFramework (
            name <- 'Default Architectural Framework',
            content <- 'Contains all Viewpoints without a source.',
            ownedMember <- IEEE1471!Viewpoint.allInstances()->select(v | v.hasSource.oclIsUndefined())
        )
}

rule System2Enterprise {
    from
        s : IEEE1471!System
    to
        t : MoDAF!Enterprise (
            name <- s.name,
            content <- s.content,
            inhabits <- s.inhabits,
            fulfills <- s.fulfills
        )
}

rule Environment2Environment {
    from
        e : IEEE1471!Environment
    to
        t : MoDAF!Environment (
            name <- e.name,
            content <- e.content,
            influences <- e.influences
        )
}

rule Mission2OperationalMission {
    from
        m : IEEE1471!Mission
    to
        t : MoDAF!OperationalMission (
            name <- m.name,
            content <- m.content
        )
}

rule Architecture2Architecture {
    from
        a : IEEE1471!Architecture
    to
        t : MoDAF!Architecture (
            name <- a.name,
            content <- a.content,
            describedBy <- a.describedBy,
            enterprise <- IEEE1471!System.allInstances()->select(sys | (sys.hasAn = a))->first()
        )
}

rule AD2AD {
    from
        ad : IEEE1471!ArchitecturalDescription
    to
        t : MoDAF!ArchitecturalDescription (
            name <- ad.name,
            content <- ad.content,
            approvialAuthority <- ad.content,
            architect <- ad.content,
            assumptionAndConstraints <- ad.content,
            creatingOrganisation <- ad.content,
            dateCompleted <- ad.content,
            purpose <- ad.content,
            recommendations <- ad.content,
            summaryOfFindings <- ad.content,
            tollsUsed <- ad.content,
            viewpoints <- ad.selects,
            products <- ad.organizedBy,
            taxonomy <- tax
        ),
        tax : MoDAF!Taxonomy (
            name <- ad.name,
            content <- ad.content,
            date <- '2023-11-01',
            url <- 'http://modaf',
            version <- '1.0'
        )
}

rule Stakeholder2Stakeholder {
    from
        s : IEEE1471!Stakeholder
    to
        t : MoDAF!Stakeholder (
            name <- s.name,
            content <- s.content
        )
}

rule Viewpoint2View {
    from
        vp : IEEE1471!Viewpoint
    to
        t : MoDAF!View (
            name <- vp.name,
            content <- vp.content,
            framework <- 'MoDAF',
            frameworkWebsite <- 'http://modaf',
            viewCode <- vp.name,
            viewDescription <- vp.content,
            viewName <- vp.name,
            definingFramework <- if vp.hasSource.oclIsUndefined() then
    thisModule.resolveTemp(IEEE1471!IEEE1471Model.allInstances()->first(), 'af')
else
    vp.hasSource
endif,
            usedToCover <- vp.usedToCover
        )
}

rule View2ArchitecturalProduct {
    from
        v : IEEE1471!View
    to
        t : MoDAF!ArchitecturalProduct (
            name <- v.name,
            content <- v.content,
            description <- v.content,
            definingView <- v.conformsTo,
            architecturalElements <- v.consitsOf,
            addresses <- v.conformsTo.usedToCover
        )
}

rule Model2Element {
    from
        m : IEEE1471!Model
    to
        t : MoDAF!Elements (
            name <- m.name,
            content <- m.content
        )
}

rule Concern2Concern {
    from
        c : IEEE1471!Concern
    to
        t : MoDAF!Concern (
            name <- c.name,
            content <- c.content
        )
}

rule LibraryViewpoint2ArchitecturalFramework {
    from
        lvp : IEEE1471!LibraryViewpoint
    to
        t : MoDAF!ArchitecturalFramework (
            name <- lvp.name,
            content <- lvp.content,
            ownedMember <- IEEE1471!Viewpoint.allInstances()->select(vp | (vp.hasSource = lvp))
        )
}

rule StakeholderHasConcern {
    from
        st : IEEE1471!Stakeholder,
        c : IEEE1471!Concern (
            st.has->includes(c)
        )
    to
        shc : MoDAF!StakeholderHasConcern (
            client <- st,
            supplier <- c,
            owner <- IEEE1471!IEEE1471Model.allInstances()->first()
        )
}

