module CPL2SPL;
create OUT : SPL from IN : CPL;

helper def: locations : Set(SPL!URIConstant) =
    let
        parentLocations : Set(SPL!URIConstant) = if self.refImmediateComposite().oclIsUndefined() then
        Set{}
    else
        self.refImmediateComposite().locations
    endif
    in
        if self.oclIsTypeOf(CPL!Location) then
        parentLocations->union(Set{self})
    else
        parentLocations
    endif;

helper def: statement : SPL!Statement =
    if self.oclIsTypeOf(CPL!CPL) then
        if not self.incoming.oclIsUndefined() then
        self.incoming.statement
    else
        if not self.outgoing.oclIsUndefined() then
        self.outgoing.statement
    else
        OclUndefined
    endif
    endif
    else
        if self.oclIsKindOf(CPL!NodeContainer) then
        if not self.contents.oclIsUndefined() then
        self.contents.statement
    else
        OclUndefined
    endif
    else
        if self.oclIsKindOf(CPL!Node) then
        self
    else
        OclUndefined
    endif
    endif
    endif;

helper def: isSimple : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        c : CPL!CPL
    to
        p : SPL!Program (
            service <- s
        ),
        s : SPL!Service (
            name <- 'CPL Service',
            declarations <- c.subActions->union(Set{rdecl}),
            sessions <- if c.incoming.oclIsUndefined() then
    Set{}
else
    Set{c.incoming}
endif->union(if c.outgoing.oclIsUndefined() then
    Set{}
else
    Set{c.outgoing}
endif)
        ),
        rdecl : SPL!VariableDeclaration (
            name <- 'r',
            type <- rt
        ),
        rt : SPL!SimpleType (
            type <- #request
        )
}

rule SubAction2Function {
    from
        sa : CPL!SubAction
    to
        f : SPL!LocalFunctionDeclaration (
            name <- sa.id,
            returnType <- rt,
            statements <- if sa.statement.oclIsUndefined() then
    Set{}
else
    Set{sa.statement}
endif
        ),
        rt : SPL!SimpleType (
            type <- #void
        )
}

rule Incoming2Method {
    from
        i : CPL!Incoming
    to
        m : SPL!Method (
            type <- rt,
            direction <- #"in",
            methodName <- mn,
            statements <- if i.statement.oclIsUndefined() then
    Set{}
else
    Set{i.statement}
endif
        ),
        rt : SPL!SimpleType (
            type <- #void
        ),
        mn : SPL!SIPMethodName (
            name <- #INVITE
        )
}

rule Proxy2Return {
    from
        p : CPL!Proxy (
            p.isSimple
        )
    to
        r : SPL!ReturnStat (
            returnedValue <- fexp
        ),
        fexp : SPL!ForwardExp (
            isParallel <- (p.ordering = 'parallel'),
            exp <- p.locations
        )
}

rule Proxy2Select {
    from
        p : CPL!Proxy (
            not p.isSimple
        )
    to
        s : SPL!SelectStat (
            matchedExp <- re,
            selectCases <- if p.busy.oclIsUndefined() then
    Set{}
else
    Set{p.busy}
endif->union(if p.noAnswer.oclIsUndefined() then
    Set{}
else
    Set{p.noAnswer}
endif)->union(if p.redirection.oclIsUndefined() then
    Set{}
else
    Set{p.redirection}
endif)->union(if p.failure.oclIsUndefined() then
    Set{}
else
    Set{p.failure}
endif),
            selectDefault <- p.default
        ),
        re : SPL!ReasonExp (
        )
}

rule Busy2SelectCase {
    from
        b : CPL!Busy
    to
        sc : SPL!SelectCase (
            values <- Set{val},
            statements <- if b.statement.oclIsUndefined() then
    Set{}
else
    Set{b.statement}
endif
        ),
        val : SPL!ClientErrorResponse (
            errorKind <- #BUSY_HERE
        )
}

rule NoAnswer2SelectCase {
    from
        na : CPL!NoAnswer
    to
        sc : SPL!SelectCase (
            values <- Set{val},
            statements <- if na.statement.oclIsUndefined() then
    Set{}
else
    Set{na.statement}
endif
        ),
        val : SPL!ClientErrorResponse (
            errorKind <- #REQUEST_TIMEOUT
        )
}

rule Redirection2SelectCase {
    from
        r : CPL!Redirection
    to
        sc : SPL!SelectCase (
            values <- Set{val},
            statements <- if r.statement.oclIsUndefined() then
    Set{}
else
    Set{r.statement}
endif
        ),
        val : SPL!RedirectionErrorResponse (
            errorKind <- #MULTIPLE_CHOICES
        )
}

rule Default2SelectDefault {
    from
        d : CPL!Default
    to
        sd : SPL!SelectDefault (
            statements <- if d.statement.oclIsUndefined() then
    Set{}
else
    Set{d.statement}
endif
        )
}

rule SubCall2Return {
    from
        sc : CPL!SubCall
    to
        r : SPL!ReturnStat (
            returnedValue <- fcall
        ),
        fcall : SPL!FunctionCallExp (
            functionCall <- fc
        ),
        fc : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->select(sa | (sa.id = sc.ref))
        )
}

rule Redirect2Return {
    from
        r : CPL!Redirect
    to
        ret : SPL!ReturnStat (
            returnedValue <- fexp
        ),
        fexp : SPL!ForwardExp (
            isParallel <- false,
            exp <- r.locations
        )
}

rule AddressSwitch2SelectStat {
    from
        as : CPL!AddressSwitch
    to
        s : SPL!SelectStat (
            matchedExp <- pcall,
            selectCases <- as.addresses,
            selectDefault <- as.otherwise
        ),
        pcall : SPL!PropertyCallPlace (
            propName <- as.field,
            source <- v
        ),
        v : SPL!Variable (
            source <- SPL!VariableDeclaration.allInstances()->select(d | (d.name = 'r'))
        )
}

rule SwitchedAddress2SelectCase {
    from
        sa : CPL!SwitchedAddress
    to
        sc : SPL!SelectCase (
            values <- Set{val},
            statements <- if sa.statement.oclIsUndefined() then
    Set{}
else
    Set{sa.statement}
endif
        ),
        val : SPL!URIConstant (
            uri <- if not sa.is.oclIsUndefined() then
    sa.is
else
    if not sa.contains.oclIsUndefined() then
    sa.contains
else
    sa.subDomainOf
endif
endif
        )
}

rule Otherwise2SelectDefault {
    from
        o : CPL!Otherwise
    to
        sd : SPL!SelectDefault (
            statements <- if o.statement.oclIsUndefined() then
    Set{}
else
    Set{o.statement}
endif
        )
}

rule Location2URIConstant {
    from
        l : CPL!Location
    to
        u : SPL!URIConstant (
            uri <- l.url
        )
}

