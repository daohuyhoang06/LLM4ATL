module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
    BibTeX!Author.allInstances()->asSet();

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
    BibTeX!TitledEntry.allInstances()->asSet();

helper def: articleSet : Set(BibTeX!Article) =
    BibTeX!Article.allInstances()->asSet();

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    (((((((((((('[' + self.id) + '] ') + self.oclType().name) + if self.oclIsKindOf(BibTeX!TitledEntry) then
        (' ' + self.title)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!AuthoredEntry) then
        (' ' + self.authors->collect(e | e.author)->sum())
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!DatedEntry) then
        (' ' + self.year)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!BookTitledEntry) then
        (' ' + self.booktitle)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!ThesisEntry) then
        (' ' + self.school)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Article) then
        (' ' + self.journal)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Unpublished) then
        (' ' + self.note)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Book) then
        (' ' + self.publisher)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!InBook) then
        (' ' + self.chapter.toString())
    else
        ''
    endif);

rule Main {
    from
        bib : BibTeX!BibTeXFile
    to
        doc : DocBook!DocBook (
            books <- Set{book}
        ),
        book : DocBook!Book (
            articles <- Set{article}
        ),
        article : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Set{se1, se2, se3, se4}
        ),
        se1 : DocBook!Sect1 (
            title <- 'References List',
            paras <- BibTeX!BibTeXEntry.allInstances()->sortedBy(e | e.id)->collect(e | thisModule.resolveTemp(e, 'p'))
        ),
        se2 : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- thisModule.authorSet->sortedBy(e | e.author)->collect(e | thisModule.resolveTemp(e, 'p'))
        ),
        se3 : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- thisModule.titledEntrySet->sortedBy(e | e.title)->collect(e | thisModule.resolveTemp(e, 'p_title'))
        ),
        se4 : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- thisModule.articleSet->sortedBy(e | e.journal)->collect(e | thisModule.resolveTemp(e, 'p_journal'))
        )
}

rule Author {
    from
        s : BibTeX!Author (
            thisModule.authorSet->includes(s)
        )
    to
        p : DocBook!Para (
            content <- s.author
        )
}

rule UntitledEntry {
    from
        s : BibTeX!BibTeXEntry (
            not s.oclIsKindOf(BibTeX!TitledEntry)
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        s : BibTeX!TitledEntry (
            (not s.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(s))
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- s.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        s : BibTeX!TitledEntry (
            (not s.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(s))
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        )
}

rule Article_Title_Journal {
    from
        s : BibTeX!Article (
            (thisModule.titledEntrySet->includes(s) and thisModule.articleSet->includes(s))
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- s.title
        ),
        p_journal : DocBook!Para (
            content <- s.journal
        )
}

rule Article_NoTitle_Journal {
    from
        s : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(s) and thisModule.articleSet->includes(s))
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        ),
        p_journal : DocBook!Para (
            content <- s.journal
        )
}

rule Article_Title_NoJournal {
    from
        s : BibTeX!Article (
            (thisModule.titledEntrySet->includes(s) and not thisModule.articleSet->includes(s))
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- s.title
        )
}

rule Article_NoTitle_NoJournal {
    from
        s : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(s) and not thisModule.articleSet->includes(s))
        )
    to
        p : DocBook!Para (
            content <- s.buildEntryPara()
        )
}

