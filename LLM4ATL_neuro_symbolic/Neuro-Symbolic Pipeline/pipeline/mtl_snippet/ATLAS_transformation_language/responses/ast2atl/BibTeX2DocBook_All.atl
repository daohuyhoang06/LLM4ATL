module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
    BibTeX!Author.allInstances()->asSet();

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
    BibTeX!TitledEntry.allInstances()->asSet();

helper def: articleSet : Set(BibTeX!Article) =
    BibTeX!Article.allInstances()->asSet();

helper context BibTeX!BibTeXEntry def: get_entry_type() : String =
    if self.oclIsTypeOf(BibTeX!Article) then
        'Article'
    else
        if self.oclIsTypeOf(BibTeX!Book) then
        'Book'
    else
        if self.oclIsTypeOf(BibTeX!Booklet) then
        'Booklet'
    else
        if self.oclIsTypeOf(BibTeX!InBook) then
        'InBook'
    else
        if self.oclIsTypeOf(BibTeX!InCollection) then
        'InCollection'
    else
        if self.oclIsTypeOf(BibTeX!InProceedings) then
        'InProceedings'
    else
        if self.oclIsTypeOf(BibTeX!Manual) then
        'Manual'
    else
        if self.oclIsTypeOf(BibTeX!MasterThesis) then
        'MasterThesis'
    else
        if self.oclIsTypeOf(BibTeX!Misc) then
        'Misc'
    else
        if self.oclIsTypeOf(BibTeX!PhDThesis) then
        'PhDThesis'
    else
        if self.oclIsTypeOf(BibTeX!Proceedings) then
        'Proceedings'
    else
        if self.oclIsTypeOf(BibTeX!TechReport) then
        'TechReport'
    else
        if self.oclIsTypeOf(BibTeX!Unpublished) then
        'Unpublished'
    else
        'BibTeXEntry'
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif;

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    (((('[' + self.id) + '] ') + self.get_entry_type()) + if self.oclIsKindOf(BibTeX!TitledEntry) then
        (' ' + (let
        e : BibTeX!TitledEntry = self
    in
        e.title))
    else
        ''
    endif);

rule Main {
    from
        s : BibTeX!BibTeXFile
    to
        docbook : DocBook!DocBook (
            books <- book
        ),
        book : DocBook!Book (
            articles <- article
        ),
        article : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Set{sect1, sect2, sect3, sect4}
        ),
        sect1 : DocBook!Sect1 (
            title <- 'References List',
            paras <- s.entries
        ),
        sect2 : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- thisModule.authorSet
        ),
        sect3 : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- thisModule.titledEntrySet->collect(e | thisModule.resolveTemp(e, 'titlePara'))
        ),
        sect4 : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- thisModule.articleSet->collect(e | thisModule.resolveTemp(e, 'journalPara'))
        )
}

rule Author {
    from
        a : BibTeX!Author (
            thisModule.authorSet->includes(a)
        )
    to
        para : DocBook!Para (
            content <- a.author
        )
}

rule UntitledEntry {
    from
        e : BibTeX!BibTeXEntry (
            not e.oclIsKindOf(BibTeX!TitledEntry)
        )
    to
        para : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(e))
        )
    to
        entryPara : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        titlePara : DocBook!Para (
            content <- e.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(e))
        )
    to
        entryPara : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule Article_Title_Journal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        entryPara : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        titlePara : DocBook!Para (
            content <- e.title
        ),
        journalPara : DocBook!Para (
            content <- e.journal
        )
}

rule Article_NoTitle_Journal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        entryPara : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        journalPara : DocBook!Para (
            content <- e.journal
        )
}

rule Article_Title_NoJournal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        entryPara : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        titlePara : DocBook!Para (
            content <- e.title
        )
}

rule Article_NoTitle_NoJournal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        entryPara : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

