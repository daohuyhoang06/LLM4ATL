module XML2DSL;
create OUT : DSL from IN : XML;

helper def: dslElementsById : String =
    'dslElementsById';

helper def: getSubTypes(c : DSL!Classifier) : Bag(DSL!Classifier) =
    Bag{};

helper def: findType(name : String) : DSL!Type =
    OclUndefined;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    true;

helper context XML!Element def: getAttrVal(name : String) : String =
    '';

helper context XML!Element def: get(name : String) : XML!Element =
    OclUndefined;

helper context XML!Element def: getType() : String =
    '';

helper context XML!Element def: getEnumId() : String =
    '';

helper context XML!Element def: getText() : String =
    '';

helper context XML!Element def: getSeq(name : String) : Bag(XML!Element) =
    Bag{};

helper context XML!Element def: hasChildren(name : String) : Boolean =
    false;

helper context XML!Element def: hasAttr(name : String) : Boolean =
    false;

helper context XML!Element def: isAbstract() : Boolean =
    false;

rule DomainModel {
    from
        r : XML!Root
    to
        dm : DSL!DomainModel (
            name <- r.name,
            identity <- r.name,
            isLoaded <- true,
            namespace <- r.name,
            types <- Bag{stString, stInteger, stBoolean, stReal},
            classifiers <- r.children
        ),
        stString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        stInteger : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        stBoolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        stReal : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        e : XML!Element (
            (e.name = 'Class')
        )
    to
        c : DSL!Class (
            name <- e.name,
            identity <- e.name,
            isLoaded <- true,
            isAbstract <- false,
            namespace <- 'default',
            properties <- e.children
        )
}

rule Relationship {
    from
        e : XML!Element (
            (e.name = 'Relationship')
        )
    to
        r : DSL!Relationship (
            name <- e.name,
            identity <- e.name,
            isLoaded <- true,
            isAbstract <- false,
            isEmbedding <- false,
            namespace <- 'default',
            roles <- e.children
        )
}

rule Role {
    from
        e : XML!Element (
            (e.name = 'Role')
        )
    to
        ro : DSL!Role (
            name <- e.name,
            identity <- e.name,
            min <- 0,
            max <- 1,
            isUnbounded <- false,
            accepts <- '',
            isOrdered <- false,
            isNavigableFrom <- true,
            isPropertyGenerator <- false
        )
}

rule ValueProperty {
    from
        e : XML!Element (
            (e.name = 'ValueProperty')
        )
    to
        vp : DSL!ValueProperty (
            name <- e.name,
            identity <- e.name
        )
}

rule Enumeration {
    from
        e : XML!Element (
            (e.name = 'Enumeration')
        )
    to
        en : DSL!Enumeration (
            name <- e.name,
            identity <- e.name,
            namespace <- 'default',
            literals <- e.children
        )
}

rule EnumerationLiteral {
    from
        e : XML!Element (
            (e.name = 'EnumerationLiteral')
        )
    to
        el : DSL!EnumerationLiteral (
            name <- e.name,
            identity <- e.name,
            value <- 0
        )
}

