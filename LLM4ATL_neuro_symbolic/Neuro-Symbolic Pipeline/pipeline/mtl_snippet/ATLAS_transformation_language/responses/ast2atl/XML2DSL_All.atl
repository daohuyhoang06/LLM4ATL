module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
    self.children->asSet()->select(c | (c.oclIsTypeOf(XML!Attribute) and (c.name = name)))->asSet().first().value;

helper context XML!Element def: get(name : String) : String =
    self.getAttrVal(name);

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    (self.getAttrVal(name) = 'true');

helper context XML!Element def: getType(name : String) : String =
    let
        child : XML!Node = self.children->asSet()->select(c | (c.oclIsTypeOf(XML!Element) and (c.name = name)))->asSet().first()
    in
        if child.oclIsUndefined() then
        self.getAttrVal(name)
    else
        child.getAttrVal('name')
    endif;

helper context XML!Element def: getEnumId(name : String) : String =
    self.getAttrVal(name);

helper context XML!Element def: getText() : String =
    let
        t : XML!Node = self.children->asSet()->select(c | c.oclIsTypeOf(XML!Text))->asSet().first()
    in
        if t.oclIsUndefined() then
        ''
    else
        t.value
    endif;

helper context XML!Element def: getSeq(name : String) : Set(XML!Node) =
    self.children->asSet()->select(c | (c.oclIsTypeOf(XML!Element) and (c.name = name)))->asSet();

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->asSet()->select(c | (c.oclIsTypeOf(XML!Attribute) and (c.name = name)))->asSet()->notEmpty();

helper context XML!Element def: isAbstract() : Boolean =
    if self.hasAttr('isAbstract') then
        self.getAttrBool('isAbstract')
    else
        false
    endif;

helper def: dslElementsById(id : String) : DSL!NamedElement =
    DSL!NamedElement.allInstances()->asSet()->select(e | (e.identity = id))->asSet().first();

helper def: getSubTypes(classifier : DSL!Classifier) : Set(DSL!Classifier) =
    DSL!Classifier.allInstances()->asSet()->select(c | (c.superType = classifier))->asSet();

helper def: findType(name : String) : DSL!Type =
    DSL!Type.allInstances()->asSet()->select(t | (t.name = name))->asSet().first();

rule DomainModel {
    from
        r : XML!Root (
            (r.name = 'domainModel')
        )
    to
        dm : DSL!DomainModel (
            name <- r.getAttrVal('name'),
            identity <- r.getAttrVal('identity'),
            isLoaded <- r.getAttrBool('isLoaded'),
            namespace <- r.getAttrVal('namespace'),
            classifiers <- r.children->asSet()->select(c | ((c.name = 'class') or (c.name = 'relationship')))->asSet(),
            types <- Set{stringType, integerType, booleanType, realType}->union(r.children->asSet()->select(c | (c.name = 'enumeration'))->asSet())
        ),
        stringType : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        integerType : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        booleanType : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        realType : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        e : XML!Element (
            (e.name = 'class')
        )
    to
        c : DSL!Class (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            isLoaded <- e.getAttrBool('isLoaded'),
            namespace <- e.getAttrVal('namespace'),
            isAbstract <- e.isAbstract(),
            properties <- e.children->asSet()->select(ch | (ch.name = 'property'))->asSet(),
            superType <- if e.hasAttr('superType') then
    thisModule.dslElementsById(e.getAttrVal('superType'))
else
    OclUndefined
endif
        )
}

rule Relationship {
    from
        e : XML!Element (
            (e.name = 'relationship')
        )
    to
        r : DSL!Relationship (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            isLoaded <- e.getAttrBool('isLoaded'),
            namespace <- e.getAttrVal('namespace'),
            isAbstract <- e.isAbstract(),
            isEmbedding <- e.getAttrBool('isEmbedding'),
            properties <- e.children->asSet()->select(ch | (ch.name = 'property'))->asSet(),
            roles <- e.children->asSet()->select(ch | (ch.name = 'role'))->asSet(),
            superType <- if e.hasAttr('superType') then
    thisModule.dslElementsById(e.getAttrVal('superType'))
else
    OclUndefined
endif
        )
}

rule Role {
    from
        e : XML!Element (
            (e.name = 'role')
        )
    to
        ro : DSL!Role (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            min <- e.getAttrVal('min').toInteger(),
            max <- e.getAttrVal('max').toInteger(),
            isUnbounded <- e.getAttrBool('isUnbounded'),
            accepts <- e.getAttrVal('accepts'),
            isOrdered <- e.getAttrBool('isOrdered'),
            isNavigableFrom <- e.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- e.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById(e.getAttrVal('source')),
            type <- thisModule.dslElementsById(e.getAttrVal('type'))
        )
}

rule ValueProperty {
    from
        e : XML!Element (
            (e.name = 'property')
        )
    to
        vp : DSL!ValueProperty (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            type <- thisModule.findType(e.getAttrVal('type'))
        )
}

rule Enumeration {
    from
        e : XML!Element (
            (e.name = 'enumeration')
        )
    to
        en : DSL!Enumeration (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            literals <- e.children->asSet()->select(ch | (ch.name = 'literal'))->asSet()
        )
}

rule EnumerationLiteral {
    from
        e : XML!Element (
            (e.name = 'literal')
        )
    to
        el : DSL!EnumerationLiteral (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            value <- e.getAttrVal('value').toInteger()
        )
}

