module Grafcet2PetriNet;
create OUT : PetriNet from IN : Grafcet;

rule PetriNet {
    from
        g : Grafcet!Grafcet
    to
        p : PetriNet!PetriNet (
            location <- g.location,
            name <- g.name,
            elements <- g.elements,
            arcs <- g.connections
        )
}

rule Place {
    from
        s : Grafcet!Step
    to
        p : PetriNet!Place (
            location <- s.location,
            name <- s.name,
            net <- s.grafcet,
            incomingArc <- s.incomingConnections,
            outgoingArc <- s.outgoingConnections
        )
}

rule Transition {
    from
        t : Grafcet!Transition
    to
        p : PetriNet!Transition (
            location <- t.location,
            name <- t.name,
            net <- t.grafcet,
            incomingArc <- t.incomingConnections,
            outgoingArc <- t.outgoingConnections
        )
}

rule PlaceToTransition {
    from
        c : Grafcet!StepToTransition
    to
        a : PetriNet!PlaceToTransition (
            location <- c.location,
            name <- c.name,
            net <- c.grafcet,
            from <- c.from,
            to <- c.to
        )
}

rule TransitionToPlace {
    from
        c : Grafcet!TransitionToStep
    to
        a : PetriNet!TransitionToPlace (
            location <- c.location,
            name <- c.name,
            net <- c.grafcet,
            from <- c.from,
            to <- c.to
        )
}

