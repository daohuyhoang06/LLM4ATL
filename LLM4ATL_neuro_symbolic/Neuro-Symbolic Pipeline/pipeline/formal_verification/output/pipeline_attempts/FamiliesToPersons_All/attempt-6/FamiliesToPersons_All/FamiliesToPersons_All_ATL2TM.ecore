        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="match_Member2Male_cond" value="false"/>
                  
            <details key="bind_Member2Male_m_fullName" value="self.m.fullName = (self.mem.firstName + (' ' + ''))"/>
                  
    
