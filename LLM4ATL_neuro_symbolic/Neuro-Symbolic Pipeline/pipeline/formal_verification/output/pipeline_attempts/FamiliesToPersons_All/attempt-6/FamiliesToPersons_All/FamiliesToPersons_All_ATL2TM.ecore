        <eAnnotations source="urn:llm4atl:provenance">
                  
            <details key="origin" value="target"/>
                  
            <details key="originalName" value="Person"/>
                  
            <details key="atlRules" value="Member2Male Member2Female"/>
                  
            <details key="preConstraints" value=""/>
                  
            <details key="postConstraints" value=""/>
                  
            <details key="targetMultiplicityConstraints" value=""/>
                  
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value="targetMultiplicity_Person_fullName targetMultiplicity_Person_birthday"/>
                  
            <details key="semConstraints" value="create_Person"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="create_Person"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="create_Person" value="(if self.oclIsKindOf(Male) then (if self.oclAsType(Male).Member2Male_m.oclIsUndefined() then 0 else 1 endif) else 0 endif) + (if self.oclIsKindOf(Female) then (if self.oclAsType(Female).Member2Female_f.oclIsUndefined() then 0 else 1 endif) else 0 endif) = 1"/>
                
        </eAnnotations>
            
