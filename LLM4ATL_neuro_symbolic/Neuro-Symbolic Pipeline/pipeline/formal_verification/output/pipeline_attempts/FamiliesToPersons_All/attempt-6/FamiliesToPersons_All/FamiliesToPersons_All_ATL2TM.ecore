        <eStructuralFeatures eOpposite="//Family/daughters" eType="//Family" name="familyDaughter" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Family/father" eType="//Family" name="familyFather" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Family/mother" eType="//Family" name="familyMother" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
