    <eClassifiers abstract="true" name="Person" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="target"/>
                              
            
            <details key="originalName" value="Person"/>
                              
            
            <details key="atlRules" value="Member2Male Member2Female"/>
                              
            
            <details key="preConstraints" value="SourceFamilyInputIsValid"/>
                              
            
            <details key="postConstraints" value="PersonHasFullName"/>
                              
            
            <details key="targetMultiplicityConstraints" value=""/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value="targetMultiplicity_Person_fullName targetMultiplicity_Person_birthday"/>
                              
            
            <details key="semConstraints" value="create_Person"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="create_Person SourceFamilyInputIsValid __efinder_NOT_PersonHasFullName"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_Person" value="(if self.oclIsKindOf(Male) then (if self.oclAsType(Male).Member2Male_p.oclIsUndefined() then 0 else 1 endif) else 0 endif) + (if self.oclIsKindOf(Female) then (if self.oclAsType(Female).Member2Female_p.oclIsUndefined() then 0 else 1 endif) else 0 endif) = 1"/>
                            
        
            <details key="SourceFamilyInputIsValid" value="FamilyRegister.allInstances()-&gt;exists(r |&#10;    r.families-&gt;notEmpty() and&#10;    r.families-&gt;forAll(f |&#10;      f.lastName &lt;&gt; '' and&#10;      (f.sons-&gt;notEmpty() or f.daughters-&gt;notEmpty() or&#10;       not f.father.oclIsUndefined() or not f.mother.oclIsUndefined())&#10;    )&#10;  ) and&#10;  Member.allInstances()-&gt;forAll(m |&#10;    m.firstName &lt;&gt; '' and&#10;    (not m.familySon.oclIsUndefined() or not m.familyDaughter.oclIsUndefined() or&#10;     not m.familyFather.oclIsUndefined() or not m.familyMother.oclIsUndefined())&#10;  )"/>
            <details key="__efinder_NOT_PersonHasFullName" value="(Member2Male.allInstances()-&gt;exists(r | not (r.p.fullName &lt;&gt; '')) or Member2Female.allInstances()-&gt;exists(r | not (r.p.fullName &lt;&gt; '')))"/>
        </eAnnotations>
                    
        
        <eStructuralFeatures name="fullName" ordered="false" unique="false" xsi:type="ecore:EAttribute">
                              
            
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                    
        
        <eStructuralFeatures name="birthday" ordered="false" unique="false" xsi:type="ecore:EAttribute">
                              
            
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                  
    
    </eClassifiers>
          
    
    <eClassifiers eSuperTypes="//Person" name="Male" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="target"/>
                              
            
            <details key="originalName" value="Male"/>
                              
            
            <details key="atlRules" value="Member2Male"/>
                              
            
            <details key="preConstraints" value=""/>
                              
            
            <details key="postConstraints" value=""/>
                              
            
            <details key="targetMultiplicityConstraints" value=""/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value=""/>
                              
            
            <details key="semConstraints" value="create_Male"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="create_Male"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_Male" value="(if self.Member2Male_p.oclIsUndefined() then 0 else 1 endif) = 1"/>
                            
        
        </eAnnotations>
                    
        
        <eStructuralFeatures eOpposite="//Member2Male/p" eType="//Member2Male" name="Member2Male_p" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
          
    
    <eClassifiers eSuperTypes="//Person" name="Female" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="target"/>
                              
            
            <details key="originalName" value="Female"/>
                              
            
            <details key="atlRules" value="Member2Female"/>
                              
            
            <details key="preConstraints" value=""/>
                              
            
            <details key="postConstraints" value=""/>
                              
            
            <details key="targetMultiplicityConstraints" value=""/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value=""/>
                              
            
            <details key="semConstraints" value="create_Female"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="create_Female"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_Female" value="(if self.Member2Female_p.oclIsUndefined() then 0 else 1 endif) = 1"/>
                            
        
        </eAnnotations>
                    
        
        <eStructuralFeatures eOpposite="//Member2Female/p" eType="//Member2Female" name="Member2Female_p" xsi:type="ecore:EReference"/>
                  
    
