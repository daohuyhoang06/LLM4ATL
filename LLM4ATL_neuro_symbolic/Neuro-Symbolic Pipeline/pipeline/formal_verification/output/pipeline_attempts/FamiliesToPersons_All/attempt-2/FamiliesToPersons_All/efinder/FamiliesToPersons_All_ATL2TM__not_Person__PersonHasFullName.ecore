    <eClassifiers name="Member" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="source"/>
                              
            
            <details key="originalName" value="Member"/>
                              
            
            <details key="atlRules" value="Member2Male Member2Female"/>
                              
            
            <details key="preConstraints" value="SourceMemberHasFirstName"/>
                              
            
            <details key="postConstraints" value=""/>
                              
            
            <details key="targetMultiplicityConstraints" value=""/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value=""/>
                              
            
            <details key="semConstraints" value="match_Member2Male match_Member2Female mutex_Member2Male_Member2Female"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="match_Member2Male match_Member2Female mutex_Member2Male_Member2Female SourceMemberHasFirstName"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="match_Member2Male" value="Member.allInstances()-&gt;forAll(m : Member | ((not m.familyFather.oclIsUndefined()) or (not m.familySon.oclIsUndefined())) implies Member2Male.allInstances()-&gt;one(z : Member2Male | z.m = m))"/>
                              
            
            <details key="match_Member2Female" value="Member.allInstances()-&gt;forAll(m : Member | ((not m.familyMother.oclIsUndefined()) or (not m.familyDaughter.oclIsUndefined())) implies Member2Female.allInstances()-&gt;one(z : Member2Female | z.m = m))"/>
                              
            
            <details key="mutex_Member2Male_Member2Female" value="(Member.allInstances()-&gt;forAll(m : Member | not (Member2Male.allInstances()-&gt;exists(z1 : Member2Male | z1.m = m) and Member2Female.allInstances()-&gt;exists(z2 : Member2Female | z2.m = m))))"/>
                            
        
            <details key="SourceMemberHasFirstName" value="self.firstName &lt;&gt; '' and&#10;  (not self.familySon.oclIsUndefined() or not self.familyDaughter.oclIsUndefined() or&#10;   not self.familyFather.oclIsUndefined() or not self.familyMother.oclIsUndefined())"/>
        </eAnnotations>
                    
        
        <eStructuralFeatures name="firstName" ordered="false" unique="false" xsi:type="ecore:EAttribute">
                              
            
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                    
        
        <eStructuralFeatures eOpposite="//Family/sons" eType="//Family" name="familySon" ordered="false" unique="false" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Family/daughters" eType="//Family" name="familyDaughter" ordered="false" unique="false" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Family/father" eType="//Family" name="familyFather" ordered="false" unique="false" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Family/mother" eType="//Family" name="familyMother" ordered="false" unique="false" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Member2Male/m" eType="//Member2Male" name="Member2Male_m" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Member2Female/m" eType="//Member2Female" name="Member2Female_m" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
          
    
