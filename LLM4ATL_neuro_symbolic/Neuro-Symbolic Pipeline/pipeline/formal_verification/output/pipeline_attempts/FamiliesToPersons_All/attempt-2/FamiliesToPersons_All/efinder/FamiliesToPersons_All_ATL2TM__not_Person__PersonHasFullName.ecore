    <eClassifiers name="Member2Male" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="trace"/>
                              
            
            <details key="atlRule" value="Member2Male"/>
                              
            
            <details key="semConstraints" value="match_Member2Male_cond bind_Member2Male_p_fullName"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="match_Member2Male_cond bind_Member2Male_p_fullName"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="match_Member2Male_cond" value="((not self.m.familyFather.oclIsUndefined()) or (not self.m.familySon.oclIsUndefined()))"/>
                              
            
            <details key="bind_Member2Male_p_fullName" value="self.p.fullName = ((self.m.firstName + ' ') + (if (not self.m.familyFather.oclIsUndefined()) then self.m.familyFather.lastName else (if (not self.m.familyMother.oclIsUndefined()) then self.m.familyMother.lastName else (if (not self.m.familySon.oclIsUndefined()) then self.m.familySon.lastName else self.m.familyDaughter.lastName endif) endif) endif))"/>
                              
    
        
        </eAnnotations>
                    
        
        <eStructuralFeatures eOpposite="//Member/Member2Male_m" eType="//Member" lowerBound="1" name="m" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Male/Member2Male_p" eType="//Male" lowerBound="1" name="p" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
          
    
    <eClassifiers name="Member2Female" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="trace"/>
                              
            
            <details key="atlRule" value="Member2Female"/>
                              
            
            <details key="semConstraints" value="match_Member2Female_cond bind_Member2Female_p_fullName"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="match_Member2Female_cond bind_Member2Female_p_fullName"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="match_Member2Female_cond" value="((not self.m.familyMother.oclIsUndefined()) or (not self.m.familyDaughter.oclIsUndefined()))"/>
                              
            
            <details key="bind_Member2Female_p_fullName" value="self.p.fullName = ((self.m.firstName + ' ') + (if (not self.m.familyFather.oclIsUndefined()) then self.m.familyFather.lastName else (if (not self.m.familyMother.oclIsUndefined()) then self.m.familyMother.lastName else (if (not self.m.familySon.oclIsUndefined()) then self.m.familySon.lastName else self.m.familyDaughter.lastName endif) endif) endif))"/>
                              
    
        
        </eAnnotations>
                    
        
        <eStructuralFeatures eOpposite="//Member/Member2Female_m" eType="//Member" lowerBound="1" name="m" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Female/Member2Female_p" eType="//Female" lowerBound="1" name="p" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
        

