            <details key="semConstraints" value="create_PersonRegister"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="create_PersonRegister"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_PersonRegister" value="false"/>
                            
        
        </eAnnotations>
                    
        
        <eStructuralFeatures containment="true" eType="//Person" name="persons" ordered="false" upperBound="-1" xsi:type="ecore:EReference"/>
                    
        
