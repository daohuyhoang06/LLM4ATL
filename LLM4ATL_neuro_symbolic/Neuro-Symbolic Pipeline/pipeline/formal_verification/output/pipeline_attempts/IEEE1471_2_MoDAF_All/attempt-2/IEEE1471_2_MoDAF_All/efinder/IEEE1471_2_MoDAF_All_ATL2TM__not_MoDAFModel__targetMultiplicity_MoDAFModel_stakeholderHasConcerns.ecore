            <details key="bind_IEEE1471Model2MoDAFModel_tgtModel_operationalMissions" value="self.tgtModel.operationalMissions = Set { self.srcModel.missions-&gt;collect(x | (if x.oclIsKindOf(Mission) then Mission2OperationalMission.allInstances()-&gt;select(z : Mission2OperationalMission | z.srcMission = x.oclAsType(Mission))-&gt;collect(z | z.tgtOperationalMission) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                              
            
