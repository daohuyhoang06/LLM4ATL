        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_AscetModule" value="(if self.ComponentContainer2AscetModule_am.oclIsUndefined() then 0 else 1 endif) = 1"/>
                            
        
            <details key="SourceAmaltheaInputIsValid" value="ComponentContainer.allInstances()-&gt;exists(c | c.tasks-&gt;notEmpty()) and&#10;  Task__source.allInstances()-&gt;forAll(t | t.name &lt;&gt; '')&#10;&#10;-- The rule creates one AscetModule per source ComponentContainer."/>
            <details key="__efinder_NOT_AscetModuleMapsTasksToSoftwareTasks" value="ComponentContainer2AscetModule.allInstances()-&gt;exists(r | not (r.am.tasks-&gt;notEmpty() and&#10;  r.am.tasks-&gt;forAll(t | t.oclIsKindOf(SoftwareTask) and t.name &lt;&gt; '')))"/>
        </eAnnotations>
                    
        
        <eStructuralFeatures containment="true" eType="//Task__target" name="tasks" upperBound="-1" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//ComponentContainer2AscetModule/am" eType="//ComponentContainer2AscetModule" name="ComponentContainer2AscetModule_am" xsi:type="ecore:EReference"/>
                  
    
