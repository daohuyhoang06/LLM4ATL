    <eClassifiers name="Main" xsi:type="ecore:EClass">
            
        <eAnnotations source="urn:llm4atl:provenance">
                  
            <details key="origin" value="trace"/>
                  
            <details key="atlRule" value="Main"/>
                  
            <details key="semConstraints" value="bind_Main_docBook_books bind_Main_book_articles bind_Main_article_title bind_Main_article_sections_1 bind_Main_sect1_title bind_Main_sect1_paras bind_Main_sect2_title bind_Main_sect2_paras bind_Main_sect3_title bind_Main_sect3_paras bind_Main_sect4_title bind_Main_sect4_paras null_Main_sect1_sections_2 null_Main_sect2_sections_2 null_Main_sect3_sections_2 null_Main_sect4_sections_2"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="bind_Main_docBook_books bind_Main_book_articles bind_Main_article_title bind_Main_article_sections_1 bind_Main_sect1_title bind_Main_sect1_paras bind_Main_sect2_title bind_Main_sect2_paras bind_Main_sect3_title bind_Main_sect3_paras bind_Main_sect4_title bind_Main_sect4_paras null_Main_sect1_sections_2 null_Main_sect2_sections_2 null_Main_sect3_sections_2 null_Main_sect4_sections_2"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="bind_Main_docBook_books" value="self.docBook.books = self.book"/>
                  
            <details key="bind_Main_book_articles" value="self.book.articles = self.article"/>
                  
            <details key="bind_Main_article_title" value="self.article.title = 'BibTeXML to DocBook'"/>
                  
            <details key="bind_Main_article_sections_1" value="self.article.sections_1 = Set { self.sect1, self.sect2, self.sect3, self.sect4 }"/>
                  
            <details key="bind_Main_sect1_title" value="self.sect1.title = 'References List'"/>
                  
            <details key="bind_Main_sect1_paras" value="self.sect1.paras = BibTeXEntry.allInstances()-&gt;sortedBy(e | e.id)"/>
                  
            <details key="bind_Main_sect2_title" value="self.sect2.title = 'Authors list'"/>
                  
