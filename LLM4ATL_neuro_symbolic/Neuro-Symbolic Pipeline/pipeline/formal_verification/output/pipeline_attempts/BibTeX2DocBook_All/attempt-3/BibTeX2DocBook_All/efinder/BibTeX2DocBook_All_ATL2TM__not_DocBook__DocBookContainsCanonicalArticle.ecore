    <eClassifiers name="DocBook" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="target"/>
                              
            
            <details key="originalName" value="DocBook"/>
                              
            
            <details key="atlRules" value="Main"/>
                              
            
            <details key="preConstraints" value="SourceBibliographyInputIsValid"/>
                              
            
            <details key="postConstraints" value="targetMultiplicity_DocBook_books DocBookContainsCanonicalArticle"/>
                              
            
            <details key="targetMultiplicityConstraints" value="targetMultiplicity_DocBook_books"/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value=""/>
                              
            
            <details key="semConstraints" value="create_DocBook"/>
                              
            
            <details key="constraintRole.targetMultiplicity_DocBook_books" value="POST / TARGET_MULTIPLICITY"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="create_DocBook SourceBibliographyInputIsValid __efinder_NOT_DocBookContainsCanonicalArticle"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_DocBook" value="(if self.Main_db.oclIsUndefined() then 0 else 1 endif) = 1"/>
                              
            
                
        
            <details key="SourceBibliographyInputIsValid" value="BibTeXFile.allInstances()-&gt;exists(f | f.entries-&gt;notEmpty()) and&#10;  BibTeXEntry.allInstances()-&gt;forAll(e | e.id &lt;&gt; '')&#10;&#10;-- The canonical DocBook article is meaningful only for a non-empty bibliography."/>
            <details key="__efinder_NOT_DocBookContainsCanonicalArticle" value="Main.allInstances()-&gt;exists(r | not (r.db.books-&gt;size() = 1 and&#10;  r.db.books-&gt;forAll(b |&#10;    b.articles-&gt;size() = 1 and&#10;    b.articles-&gt;forAll(a |&#10;      a.title = 'BibTeXML to DocBook' and a.sections_1-&gt;size() = 4&#10;    )&#10;  )))"/>
        </eAnnotations>
                    
        
        <eStructuralFeatures containment="true" eType="//Book__target" name="books" upperBound="-1" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Main/db" eType="//Main" name="Main_db" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
          
    
