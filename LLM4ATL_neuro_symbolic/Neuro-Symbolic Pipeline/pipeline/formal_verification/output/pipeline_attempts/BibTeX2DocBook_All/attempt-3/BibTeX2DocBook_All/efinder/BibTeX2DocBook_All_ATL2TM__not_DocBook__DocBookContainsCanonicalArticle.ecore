        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="match_Main" value="BibTeXFile.allInstances()-&gt;forAll(f : BibTeXFile | Main.allInstances()-&gt;one(z : Main | z.f = f))"/>
                            
        
