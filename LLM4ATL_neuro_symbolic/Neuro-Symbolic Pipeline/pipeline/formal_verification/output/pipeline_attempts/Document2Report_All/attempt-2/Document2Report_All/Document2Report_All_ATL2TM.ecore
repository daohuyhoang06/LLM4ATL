            <details key="bind_Document2Report_tReport_sections" value="self.tReport.sections = Set { self.sDocument.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.sSection = x.oclAsType(Section__source))-&gt;collect(z | z.tSection) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                  
            <details key="bind_Document2Report_tReport_sections_size" value="(self.sDocument.sections)-&gt;size() = (Set { self.sDocument.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.sSection = x.oclAsType(Section__source))-&gt;collect(z | z.tSection) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                
