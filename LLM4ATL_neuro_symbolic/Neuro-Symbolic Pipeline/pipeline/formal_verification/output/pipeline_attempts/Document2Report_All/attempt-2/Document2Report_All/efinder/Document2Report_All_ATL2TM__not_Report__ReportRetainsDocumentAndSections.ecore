        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="create_Report SourceDocumentInputIsValid __efinder_NOT_ReportRetainsDocumentAndSections"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_Report" value="(if self.Document2Report_tReport.oclIsUndefined() then 0 else 1 endif) = 1"/>
                            
        
            <details key="SourceDocumentInputIsValid" value="DocumentModel.allInstances()-&gt;exists(dm |&#10;    dm.documents-&gt;notEmpty() and&#10;    dm.documents-&gt;forAll(d |&#10;      d.title &lt;&gt; '' and d.author &lt;&gt; '' and d.sections-&gt;notEmpty() and&#10;      d.sections-&gt;forAll(s | s.title &lt;&gt; '' and s.content &lt;&gt; '' and s.order &gt; 0)&#10;    )&#10;  )"/>
            <details key="__efinder_NOT_ReportRetainsDocumentAndSections" value="Document2Report.allInstances()-&gt;exists(r | not (Document.allInstances()-&gt;exists(d |&#10;      r.tReport.title = d.title and&#10;      r.tReport.author = d.author and&#10;&#10;      r.tReport.sections-&gt;size() = d.sections-&gt;size() and&#10;&#10;      d.sections-&gt;forAll(s |&#10;        d.sections-&gt;select(ss |&#10;          ss.title = s.title and&#10;          ss.content = s.content and&#10;          ss.order = s.order&#10;        )-&gt;size() =&#10;        r.tReport.sections-&gt;select(t |&#10;          t.title = s.title and&#10;          t.content = s.content and&#10;          t.order = s.order&#10;        )-&gt;size()&#10;      )&#10;  )))"/>
        </eAnnotations>
                    
        
