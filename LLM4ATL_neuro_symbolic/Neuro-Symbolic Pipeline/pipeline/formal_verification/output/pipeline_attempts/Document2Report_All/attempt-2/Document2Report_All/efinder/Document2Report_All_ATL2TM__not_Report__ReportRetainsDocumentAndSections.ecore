            <details key="atlRules" value="Document2Report"/>
                              
            
            <details key="preConstraints" value="SourceDocumentInputIsValid"/>
                              
            
            <details key="postConstraints" value="ReportRetainsDocumentAndSections"/>
                              
            
            <details key="targetMultiplicityConstraints" value=""/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value="targetMultiplicity_Report_title"/>
                              
            
            <details key="semConstraints" value="create_Report"/>
                            
        
