            <details key="bind_Document2Report_r_sections" value="self.r.sections = Set { self.d.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.s = x.oclAsType(Section__source))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                              
            
            <details key="bind_Document2Report_r_sections_size" value="(self.d.sections)-&gt;size() = (Set { self.d.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.s = x.oclAsType(Section__source))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                            
        
