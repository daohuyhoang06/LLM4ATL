            <details key="bind_UserModel2AccountModel_t_accounts" value="self.t.accounts = Set { self.s.users-&gt;collect(x | (if x.oclIsKindOf(User) then User2Account.allInstances()-&gt;select(z : User2Account | z.u = x.oclAsType(User))-&gt;collect(z | z.a) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                  
            <details key="bind_UserModel2AccountModel_t_accounts_size" value="(self.s.users)-&gt;size() = (Set { self.s.users-&gt;collect(x | (if x.oclIsKindOf(User) then User2Account.allInstances()-&gt;select(z : User2Account | z.u = x.oclAsType(User))-&gt;collect(z | z.a) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                
