    <eClassifiers name="ItemModel2ProductModel" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="trace"/>
                              
            
            <details key="atlRule" value="ItemModel2ProductModel"/>
                              
            
            <details key="semConstraints" value="bind_ItemModel2ProductModel_t_products bind_ItemModel2ProductModel_t_products_size"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="bind_ItemModel2ProductModel_t_products bind_ItemModel2ProductModel_t_products_size"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="bind_ItemModel2ProductModel_t_products" value="self.t.products = Set { self.s.items-&gt;collect(x | (if x.oclIsKindOf(Item) then Item2Product.allInstances()-&gt;select(z : Item2Product | z.s = x.oclAsType(Item))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                              
            
            <details key="bind_ItemModel2ProductModel_t_products_size" value="(self.s.items)-&gt;size() = (Set { self.s.items-&gt;collect(x | (if x.oclIsKindOf(Item) then Item2Product.allInstances()-&gt;select(z : Item2Product | z.s = x.oclAsType(Item))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                            
        
        </eAnnotations>
                    
        
        <eStructuralFeatures eOpposite="//ItemModel/ItemModel2ProductModel_s" eType="//ItemModel" lowerBound="1" name="s" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//ProductModel/ItemModel2ProductModel_t" eType="//ProductModel" lowerBound="1" name="t" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
          
    
    <eClassifiers name="Item2Product" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="trace"/>
                              
            
            <details key="atlRule" value="Item2Product"/>
                              
            
            <details key="semConstraints" value="bind_Item2Product_t_name bind_Item2Product_t_price bind_Item2Product_t_description bind_Item2Product_t_inStock bind_Item2Product_t_category"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="bind_Item2Product_t_name bind_Item2Product_t_price bind_Item2Product_t_description bind_Item2Product_t_inStock bind_Item2Product_t_category"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="bind_Item2Product_t_name" value="self.t.name = self.s.name"/>
                              
            
            <details key="bind_Item2Product_t_price" value="self.t.price = self.s.price"/>
                              
            
            <details key="bind_Item2Product_t_description" value="self.t.description = self.s.description"/>
                              
            
            <details key="bind_Item2Product_t_inStock" value="self.t.inStock = (self.s.quantity &gt; 0)"/>
                              
            
            <details key="bind_Item2Product_t_category" value="self.t.category = (if (self.s.type = 'Electronics') then 'Tech' else (if (self.s.type = 'Clothing') then 'Apparel' else 'General' endif) endif)"/>
                            
        
        </eAnnotations>
                    
        
        <eStructuralFeatures eOpposite="//Item/Item2Product_s" eType="//Item" lowerBound="1" name="s" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//Product/Item2Product_t" eType="//Product" lowerBound="1" name="t" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
        

</ecore:EPackage>
