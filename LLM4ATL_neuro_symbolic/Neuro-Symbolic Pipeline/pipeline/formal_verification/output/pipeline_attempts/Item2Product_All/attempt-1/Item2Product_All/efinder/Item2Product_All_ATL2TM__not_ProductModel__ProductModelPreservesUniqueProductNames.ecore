            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                    
        
        <eStructuralFeatures name="category" xsi:type="ecore:EAttribute">
                              
            
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                    
        
        <eStructuralFeatures name="inStock" xsi:type="ecore:EAttribute">
                              
            
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                    
        
        <eStructuralFeatures eOpposite="//Item2Product/t" eType="//Item2Product" name="Item2Product_t" xsi:type="ecore:EReference"/>
                  
    
