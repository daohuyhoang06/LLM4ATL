        </eStructuralFeatures>
                    
        
        <eStructuralFeatures name="quantity" xsi:type="ecore:EAttribute">
                              
            
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EInt" xsi:type="ecore:EDataType"/>
                            
        
        </eStructuralFeatures>
                    
        
        <eStructuralFeatures eOpposite="//Item2Product/s" eType="//Item2Product" name="Item2Product_s" xsi:type="ecore:EReference"/>
                  
    
