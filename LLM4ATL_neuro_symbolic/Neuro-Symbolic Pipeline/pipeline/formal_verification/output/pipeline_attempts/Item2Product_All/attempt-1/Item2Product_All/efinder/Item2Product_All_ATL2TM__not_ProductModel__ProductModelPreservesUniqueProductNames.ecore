        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="match_ItemModel2ProductModel" value="ItemModel.allInstances()-&gt;forAll(s : ItemModel | ItemModel2ProductModel.allInstances()-&gt;one(z : ItemModel2ProductModel | z.s = s))"/>
                            
        
            <details key="SourceItemModelIsNonEmpty" value="self.items-&gt;notEmpty() and self.items-&gt;isUnique(i | i.name)"/>
        </eAnnotations>
                    
        
        <eStructuralFeatures containment="true" eType="//Item" name="items" ordered="false" upperBound="-1" xsi:type="ecore:EReference"/>
                    
        
        <eStructuralFeatures eOpposite="//ItemModel2ProductModel/s" eType="//ItemModel2ProductModel" name="ItemModel2ProductModel_s" xsi:type="ecore:EReference"/>
                  
    
    </eClassifiers>
          
    
    <eClassifiers name="Item" xsi:type="ecore:EClass">
                    
        
        <eAnnotations source="urn:llm4atl:provenance">
                              
            
            <details key="origin" value="source"/>
                              
            
            <details key="originalName" value="Item"/>
                              
            
            <details key="atlRules" value="Item2Product"/>
                              
            
            <details key="preConstraints" value="SourceItemHasNonNegativePrice"/>
                              
            
            <details key="postConstraints" value=""/>
                              
            
            <details key="targetMultiplicityConstraints" value=""/>
                              
            
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value=""/>
                              
            
            <details key="semConstraints" value="match_Item2Product"/>
                            
        
        </eAnnotations>
                    
        
