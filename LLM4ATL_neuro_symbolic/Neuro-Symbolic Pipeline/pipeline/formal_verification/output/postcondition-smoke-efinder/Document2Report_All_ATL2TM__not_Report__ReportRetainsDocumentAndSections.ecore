        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="bind_Document2Report_t_title" value="self.t.title = self.s.title"/>
                              
            
            <details key="bind_Document2Report_t_author" value="self.t.author = self.s.author"/>
                              
            
            <details key="bind_Document2Report_t_sections" value="self.t.sections = Set { self.s.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.ss = x.oclAsType(Section__source))-&gt;collect(z | z.ts) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                              
            
            <details key="bind_Document2Report_t_sections_size" value="(self.s.sections)-&gt;size() = (Set { self.s.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.ss = x.oclAsType(Section__source))-&gt;collect(z | z.ts) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                            
        
