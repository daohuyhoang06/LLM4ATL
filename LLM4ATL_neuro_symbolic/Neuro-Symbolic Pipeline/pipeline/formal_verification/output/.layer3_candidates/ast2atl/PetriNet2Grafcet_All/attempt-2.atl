module PetriNet2Grafcet;
create OUT : Grafcet from IN : PetriNet;

rule Grafcet {
    from
        s : PetriNet!PetriNet
    to
        t : Grafcet!Grafcet (
            name <- if s.name.oclIsUndefined() then
    'defaultName'
else
    if (s.name = '') then
    'defaultName'
else
    s.name
endif
endif,
            location <- if s.location.oclIsUndefined() then
    'defaultLoc'
else
    if (s.location = '') then
    'defaultLoc'
else
    s.location
endif
endif,
            elements <- s.elements,
            connections <- s.arcs
        )
}

rule Step {
    from
        s : PetriNet!Place
    to
        t : Grafcet!Step (
            name <- if s.name.oclIsUndefined() then
    'defaultName'
else
    if (s.name = '') then
    'defaultName'
else
    s.name
endif
endif,
            location <- if s.location.oclIsUndefined() then
    'defaultLoc'
else
    if (s.location = '') then
    'defaultLoc'
else
    s.location
endif
endif,
            isInitial <- false,
            isActive <- false,
            action <- '',
            grafcet <- s.net,
            incomingConnections <- s.incomingArc,
            outgoingConnections <- s.outgoingArc
        )
}

rule Transition {
    from
        s : PetriNet!Transition
    to
        t : Grafcet!Transition (
            name <- if s.name.oclIsUndefined() then
    'defaultName'
else
    if (s.name = '') then
    'defaultName'
else
    s.name
endif
endif,
            location <- if s.location.oclIsUndefined() then
    'defaultLoc'
else
    if (s.location = '') then
    'defaultLoc'
else
    s.location
endif
endif,
            condition <- '',
            grafcet <- s.net,
            incomingConnections <- s.incomingArc,
            outgoingConnections <- s.outgoingArc
        )
}

rule StepToTransition {
    from
        s : PetriNet!PlaceToTransition
    to
        t : Grafcet!StepToTransition (
            name <- if s.name.oclIsUndefined() then
    'defaultName'
else
    if (s.name = '') then
    'defaultName'
else
    s.name
endif
endif,
            location <- if s.location.oclIsUndefined() then
    'defaultLoc'
else
    if (s.location = '') then
    'defaultLoc'
else
    s.location
endif
endif,
            grafcet <- s.net,
            from <- s.from,
            to <- s.to
        )
}

rule TransitionToStep {
    from
        s : PetriNet!TransitionToPlace
    to
        t : Grafcet!TransitionToStep (
            name <- if s.name.oclIsUndefined() then
    'defaultName'
else
    if (s.name = '') then
    'defaultName'
else
    s.name
endif
endif,
            location <- if s.location.oclIsUndefined() then
    'defaultLoc'
else
    if (s.location = '') then
    'defaultLoc'
else
    s.location
endif
endif,
            grafcet <- s.net,
            from <- s.from,
            to <- s.to
        )
}

