module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Proxy def: isSimple : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

helper context CPL!Element def: statement : CPL!Element =
    self;

helper context CPL!NodeContainer def: statement : CPL!Element =
    if self.contents.oclIsUndefined() then
        self
    else
        self.contents.statement
    endif;

helper context CPL!Element def: firstLocation : CPL!Location =
    if self.refImmediateComposite().oclIsUndefined() then
        OclUndefined
    else
        self.refImmediateComposite().firstLocation
    endif;

helper context CPL!Location def: firstLocation : CPL!Location =
    self;

helper context CPL!Element def: locations : Set(CPL!Location) =
    if self.refImmediateComposite().oclIsUndefined() then
        Set{}
    else
        self.refImmediateComposite().locations
    endif;

helper context CPL!Location def: locations : Set(CPL!Location) =
    Set{self}->union(if self.refImmediateComposite().oclIsUndefined() then
        Set{}
    else
        self.refImmediateComposite().locations
    endif);

rule CPL2Program {
    from
        cpl : CPL!CPL
    to
        p : SPL!Program (
            service <- s
        ),
        s : SPL!Service (
            name <- 'CPL',
            declarations <- cpl.subActions,
            sessions <- Set{cpl.incoming, cpl.outgoing}->reject(e | e.oclIsUndefined())
        )
}

rule SubAction2Function {
    from
        s : CPL!SubAction
    to
        t : SPL!LocalFunctionDeclaration (
            name <- s.id,
            returnType <- rt,
            statements <- s.statement
        ),
        rt : SPL!SimpleType (
            type <- #void
        )
}

rule Incoming2Method {
    from
        s : CPL!Incoming
    to
        t : SPL!Method (
            direction <- #"in",
            methodName <- mn,
            type <- rt,
            statements <- s.statement
        ),
        mn : SPL!SIPMethodName (
            name <- #INVITE
        ),
        rt : SPL!SimpleType (
            type <- #void
        )
}

rule Proxy2Return {
    from
        s : CPL!Proxy (
            s.isSimple
        )
    to
        t : SPL!ReturnStat (
            returnedValue <- thisModule.Location2URIConstant(s.firstLocation)
        )
}

rule Proxy2Select {
    from
        s : CPL!Proxy (
            not s.isSimple
        )
    to
        t : SPL!SelectStat (
            matchedExp <- me,
            selectCases <- Set{s.busy, s.noAnswer, s.redirection}->reject(e | e.oclIsUndefined()),
            selectDefault <- s.default
        ),
        me : SPL!RequestURIExp (
        )
}

rule Busy2SelectCase {
    from
        s : CPL!Busy
    to
        t : SPL!SelectCase (
            values <- Set{rc},
            statements <- s.statement
        ),
        rc : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #BUSY_HERE
        )
}

rule NoAnswer2SelectCase {
    from
        s : CPL!NoAnswer
    to
        t : SPL!SelectCase (
            values <- Set{rc},
            statements <- s.statement
        ),
        rc : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #REQUEST_TIMEOUT
        )
}

rule Redirection2SelectCase {
    from
        s : CPL!Redirection
    to
        t : SPL!SelectCase (
            values <- Set{rc},
            statements <- s.statement
        ),
        rc : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!RedirectionErrorResponse (
            errorKind <- #MULTIPLE_CHOICES
        )
}

rule Default2SelectDefault {
    from
        s : CPL!Default
    to
        t : SPL!SelectDefault (
            statements <- s.statement
        )
}

rule SubCall2Return {
    from
        s : CPL!SubCall
    to
        t : SPL!ReturnStat (
            returnedValue <- fce
        ),
        fce : SPL!FunctionCallExp (
            functionCall <- fc
        ),
        fc : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->any(sa | (sa.id = s.ref))
        )
}

rule Redirect2Return {
    from
        s : CPL!Redirect
    to
        t : SPL!ReturnStat (
            returnedValue <- rc
        ),
        rc : SPL!ConstantExp (
            value <- rconst
        ),
        rconst : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!RedirectionErrorResponse (
            errorKind <- if (s.permanent = 'true') then
    #MOVED_PERMANENTLY
else
    #MOVED_TEMPORARILY
endif
        )
}

rule AddressSwitch2SelectStat {
    from
        s : CPL!AddressSwitch
    to
        t : SPL!SelectStat (
            matchedExp <- hp,
            selectCases <- s.addresses,
            selectDefault <- s.otherwise
        ),
        hp : SPL!SIPHeaderPlace (
            header <- if (s.field = 'to') then
    #TO
else
    if (s.field = 'from') then
    #FROM
else
    #CONTACT
endif
endif
        )
}

rule SwitchedAddress2SelectCase {
    from
        s : CPL!SwitchedAddress
    to
        t : SPL!SelectCase (
            values <- Set{val},
            statements <- s.statement
        ),
        val : SPL!StringConstant (
            value <- if not s.is.oclIsUndefined() then
    s.is
else
    if not s.contains.oclIsUndefined() then
    s.contains
else
    s.subDomainOf
endif
endif
        )
}

rule Otherwise2SelectDefault {
    from
        s : CPL!Otherwise
    to
        t : SPL!SelectDefault (
            statements <- s.statement
        )
}

lazy rule Location2URIConstant {
    from
        s : CPL!Location
    to
        t : SPL!ConstantExp (
            value <- u
        ),
        u : SPL!URIConstant (
            uri <- s.url
        )
}

