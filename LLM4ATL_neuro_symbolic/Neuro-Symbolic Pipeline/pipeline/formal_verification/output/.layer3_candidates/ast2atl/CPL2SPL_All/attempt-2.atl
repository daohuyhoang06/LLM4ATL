module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!NodeContainer def: statement() : SPL!Statement =
    OclUndefined;

helper context CPL!Element def: locations() : String =
    '';

helper context CPL!Proxy def: isSimple : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        cpl : CPL!CPL
    to
        prog : SPL!Program (
            location <- cpl.locations(),
            service <- srv
        ),
        srv : SPL!Service (
            location <- cpl.locations(),
            name <- 'Service'
        )
}

rule SubAction2Function {
    from
        sa : CPL!SubAction
    to
        func : SPL!RemoteFunctionDeclaration (
            location <- sa.locations(),
            name <- sa.id,
            returnType <- retType,
            functionLocation <- #local
        ),
        retType : SPL!SimpleType (
            location <- sa.locations(),
            type <- #void
        )
}

rule Incoming2Method {
    from
        inc : CPL!Incoming
    to
        mth : SPL!Method (
            location <- inc.locations(),
            type <- mthType,
            direction <- #"in",
            methodName <- mthName,
            statements <- Set{retM},
            branches <- Set{br}
        ),
        mthType : SPL!SimpleType (
            location <- inc.locations(),
            type <- #request
        ),
        mthName : SPL!SIPMethodName (
            location <- inc.locations(),
            name <- #INVITE
        ),
        br : SPL!DefaultBranch (
            location <- inc.locations(),
            statements <- Set{retB}
        ),
        retM : SPL!ReturnStat (
            location <- inc.locations()
        ),
        retB : SPL!ReturnStat (
            location <- inc.locations()
        )
}

rule Proxy2Return {
    from
        prx : CPL!Proxy (
            prx.isSimple
        )
    to
        ret : SPL!ReturnStat (
            location <- prx.locations()
        )
}

rule Proxy2Select {
    from
        prx : CPL!Proxy (
            not prx.isSimple
        )
    to
        sel : SPL!SelectStat (
            location <- prx.locations(),
            matchedExp <- matched
        ),
        matched : SPL!ConstantExp (
            location <- prx.locations(),
            value <- bc
        ),
        bc : SPL!BooleanConstant (
            location <- prx.locations(),
            value <- true
        )
}

rule Busy2SelectCase {
    from
        busy : CPL!Busy
    to
        scase : SPL!SelectCase (
            location <- busy.locations(),
            values <- Set{sval}
        ),
        sval : SPL!StringConstant (
            location <- busy.locations(),
            value <- 'BUSY'
        )
}

rule NoAnswer2SelectCase {
    from
        noa : CPL!NoAnswer
    to
        scase : SPL!SelectCase (
            location <- noa.locations(),
            values <- Set{sval}
        ),
        sval : SPL!StringConstant (
            location <- noa.locations(),
            value <- 'NO_ANSWER'
        )
}

rule Redirection2SelectCase {
    from
        red : CPL!Redirection
    to
        scase : SPL!SelectCase (
            location <- red.locations(),
            values <- Set{sval}
        ),
        sval : SPL!StringConstant (
            location <- red.locations(),
            value <- 'REDIRECTION'
        )
}

rule Default2SelectDefault {
    from
        defIn : CPL!Default
    to
        sdef : SPL!SelectDefault (
            location <- defIn.locations()
        )
}

rule SubCall2Return {
    from
        sc : CPL!SubCall
    to
        ret : SPL!ReturnStat (
            location <- sc.locations(),
            returnedValue <- cexp
        ),
        cexp : SPL!ConstantExp (
            location <- sc.locations(),
            value <- sval
        ),
        sval : SPL!StringConstant (
            location <- sc.locations(),
            value <- sc.ref
        )
}

rule Redirect2Return {
    from
        rdr : CPL!Redirect
    to
        ret : SPL!ReturnStat (
            location <- rdr.locations(),
            returnedValue <- cexp
        ),
        cexp : SPL!ConstantExp (
            location <- rdr.locations(),
            value <- bval
        ),
        bval : SPL!BooleanConstant (
            location <- rdr.locations(),
            value <- true
        )
}

rule AddressSwitch2SelectStat {
    from
        asw : CPL!AddressSwitch
    to
        sel : SPL!SelectStat (
            location <- asw.locations(),
            matchedExp <- cexp
        ),
        cexp : SPL!ConstantExp (
            location <- asw.locations(),
            value <- bval
        ),
        bval : SPL!BooleanConstant (
            location <- asw.locations(),
            value <- true
        )
}

rule SwitchedAddress2SelectCase {
    from
        swAddr : CPL!SwitchedAddress
    to
        scase : SPL!SelectCase (
            location <- swAddr.locations(),
            values <- Set{sval}
        ),
        sval : SPL!StringConstant (
            location <- swAddr.locations(),
            value <- 'ADDRESS'
        )
}

rule Otherwise2SelectDefault {
    from
        oth : CPL!Otherwise
    to
        sdef : SPL!SelectDefault (
            location <- oth.locations()
        )
}

rule Location2URIConstant {
    from
        loc : CPL!Location
    to
        uri : SPL!URIConstant (
            location <- loc.locations(),
            uri <- loc.url
        )
}

