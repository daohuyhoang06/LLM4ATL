module Make2Ant;
create OUT : Ant from IN : Make;

rule Makefile2Project {
    from
        m : Make!Makefile
    to
        p : Ant!Project (
            name <- m.name,
            properties <- m.elements->select(e | e.oclIsKindOf(Make!Macro)),
            targets <- m.elements->select(e | e.oclIsKindOf(Make!Rule)),
            default <- m.elements->select(e | e.oclIsKindOf(Make!Rule))->first()
        )
}

rule Macro2Property {
    from
        mac : Make!Macro
    to
        prop : Ant!PropertyValue (
            name <- mac.name,
            value <- mac.value
        )
}

rule Rule2Target {
    from
        r : Make!Rule
    to
        t : Ant!Target (
            name <- r.name,
            tasks <- r.shellLines,
            depends <- r.dependencies->select(d | d.oclIsKindOf(Make!RuleDep))->collect(rd | rd.ruledep)
        )
}

rule ShellLine2Task_Display {
    from
        s : Make!ShellLine (
            (s.display = true)
        )
    to
        echo : Ant!Echo (
            message <- s.command
        ),
        exec : Ant!Exec (
            executable <- s.command,
            dir <- '.'
        )
}

rule ShellLine2Task_NoDisplay {
    from
        s : Make!ShellLine (
            (s.display = false)
        )
    to
        exec : Ant!Exec (
            executable <- s.command,
            dir <- '.'
        )
}

