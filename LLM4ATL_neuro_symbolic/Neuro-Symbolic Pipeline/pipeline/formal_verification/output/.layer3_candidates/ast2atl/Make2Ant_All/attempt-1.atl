module Make2Ant;
create OUT : Ant from IN : Make;

rule Makefile2Project {
    from
        m : Make!Makefile
    to
        p : Ant!Project (
            name <- m.name,
            properties <- m.elements->select(e | e.oclIsKindOf(Make!Macro)),
            targets <- m.elements->select(e | e.oclIsKindOf(Make!Rule)),
            default <- m.elements->select(e | e.oclIsKindOf(Make!Rule))->first()
        )
}

rule Macro2Property {
    from
        m : Make!Macro
    to
        p : Ant!PropertyValue (
            name <- m.name,
            value <- m.value
        )
}

rule Rule2Target {
    from
        r : Make!Rule
    to
        t : Ant!Target (
            name <- r.name,
            tasks <- r.shellLines,
            depends <- r.dependencies->select(d | d.oclIsKindOf(Make!RuleDep))->collect(d | d.ruledep)
        )
}

rule ShellLine2Task_Display {
    from
        s : Make!ShellLine (
            s.display
        )
    to
        echo : Ant!Echo (
            message <- s.command,
            target <- s.ruleShellLine
        ),
        exec : Ant!Exec (
            executable <- s.command,
            target <- s.ruleShellLine
        )
}

rule ShellLine2Task_NoDisplay {
    from
        s : Make!ShellLine (
            not s.display
        )
    to
        exec : Ant!Exec (
            executable <- s.command,
            target <- s.ruleShellLine
        )
}

