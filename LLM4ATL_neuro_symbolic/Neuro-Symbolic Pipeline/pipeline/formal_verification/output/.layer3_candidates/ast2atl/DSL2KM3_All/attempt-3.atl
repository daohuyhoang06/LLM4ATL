module DSL2KM3;
create OUT : KM3 from IN : DSL;

helper context DSL!Relationship def: needTurnOnClass() : Boolean =
    (((self.properties->notEmpty() or not self.superType.oclIsUndefined()) or self.subTypes->notEmpty()) or DSL!Role.allInstances()->exists(r | (r.type = self)));

helper def: getRoles(c : DSL!Class) : Set(DSL!Role) =
    DSL!Role.allInstances()->select(r | ((r.source = c) and not r.relation.needTurnOnClass()));

helper context DSL!Role def: isEmbedding() : Boolean =
    self.relation.isEmbedding;

rule Metamodel {
    from
        dm : DSL!DomainModel
    to
        mm : KM3!Metamodel (
            contents <- Set{mainPkg, primPkg}
        ),
        mainPkg : KM3!Package (
            name <- dm.namespace,
            contents <- dm.classifiers->union(dm.types)
        ),
        primPkg : KM3!Package (
            name <- 'PrimitiveTypes',
            contents <- Set{primBoolean, primInteger, primString}
        ),
        primBoolean : KM3!DataType (
            name <- 'Boolean'
        ),
        primInteger : KM3!DataType (
            name <- 'Integer'
        ),
        primString : KM3!DataType (
            name <- 'String'
        )
}

rule Class {
    from
        c : DSL!Class
    to
        out : KM3!Class (
            name <- c.name,
            isAbstract <- c.isAbstract,
            supertypes <- if c.superType.oclIsUndefined() then
    Set{}
else
    Set{c.superType}
endif,
            structuralFeatures <- c.properties->union(thisModule.getRoles(c))
        )
}

rule Relation2Class {
    from
        rel : DSL!Relationship (
            rel.needTurnOnClass()
        )
    to
        c : KM3!Class (
            name <- rel.name,
            isAbstract <- rel.isAbstract,
            supertypes <- if rel.superType.oclIsUndefined() then
    Set{}
else
    Set{rel.superType}
endif,
            structuralFeatures <- rel.properties->union(rel.roles)
        )
}

rule SimpleReference {
    from
        r : DSL!Role (
            not r.relation.needTurnOnClass()
        )
    to
        ref : KM3!Reference (
            name <- r.name,
            lower <- r.min,
            upper <- r.max,
            isOrdered <- r.isOrdered,
            isUnique <- false,
            type <- r.type,
            isContainer <- r.isEmbedding(),
            opposite <- r.relation.roles->reject(e | (e = r))->any(e | true)
        )
}

rule ComplexReference {
    from
        r : DSL!Role (
            r.relation.needTurnOnClass()
        )
    to
        ref : KM3!Reference (
            name <- r.name,
            lower <- r.min,
            upper <- r.max,
            isOrdered <- r.isOrdered,
            isUnique <- false,
            type <- r.type,
            isContainer <- r.isEmbedding()
        )
}

rule Attribute {
    from
        vp : DSL!ValueProperty
    to
        attr : KM3!Attribute (
            name <- vp.name,
            lower <- 1,
            upper <- 1,
            isOrdered <- false,
            isUnique <- false,
            type <- vp.type
        )
}

rule Enumeration {
    from
        e : DSL!Enumeration
    to
        ke : KM3!Enumeration (
            name <- e.name,
            literals <- e.literals
        )
}

rule EnumLiteral {
    from
        el : DSL!EnumerationLiteral
    to
        kel : KM3!EnumLiteral (
            name <- el.name
        )
}

rule DataType {
    from
        st : DSL!SimpleType
    to
        kd : KM3!DataType (
            name <- st.name
        )
}

