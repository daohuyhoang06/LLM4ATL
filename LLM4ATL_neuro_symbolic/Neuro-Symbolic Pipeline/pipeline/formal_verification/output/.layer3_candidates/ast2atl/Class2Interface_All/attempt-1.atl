module Class2Interface_All;
create OUT : Interface from IN : Class;

rule Class2Interface {
    from
        c : Class!Class
    to
        target : Interface!Interface (
            name <- c.name,
            methods <- c.methods
        )
}

rule Method2Method {
    from
        m : Class!Method
    to
        target : Interface!Method (
            name <- m.name,
            returnType <- m.returnType,
            parameters <- m.parameters
        )
}

rule Parameter2Parameter {
    from
        p : Class!Parameter
    to
        target : Interface!Parameter (
            name <- p.name,
            type <- p.type
        )
}

