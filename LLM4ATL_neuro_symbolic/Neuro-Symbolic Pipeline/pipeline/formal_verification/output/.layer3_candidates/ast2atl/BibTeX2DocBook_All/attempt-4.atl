module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    self.id;

helper context BibTeX!BibTeXFile def: authorSet : Set(BibTeX!Author) =
    Set{};

helper context BibTeX!BibTeXFile def: titledEntrySet : Set(BibTeX!TitledEntry) =
    Set{};

helper context BibTeX!BibTeXFile def: articleSet : Set(BibTeX!Article) =
    Set{};

rule Main {
    from
        f : BibTeX!BibTeXFile
    to
        db : DocBook!DocBook (
            books <- Set{b}
        ),
        b : DocBook!Book (
            articles <- Set{a}
        ),
        a : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Set{sRef, sAuthors, sTitles, sJournals}
        ),
        sRef : DocBook!Sect1 (
            title <- 'References List',
            paras <- f.entries->collect(e | thisModule.resolveTemp(e, 'refPara'))
        ),
        sAuthors : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- f.authorSet->collect(au | thisModule.resolveTemp(au, 'authorPara'))
        ),
        sTitles : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- f.titledEntrySet->collect(te | thisModule.resolveTemp(te, 'titlePara'))
        ),
        sJournals : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- f.articleSet->collect(ar | thisModule.resolveTemp(ar, 'journalPara'))
        )
}

rule Author {
    from
        a : BibTeX!Author
    to
        authorPara : DocBook!Para (
            content <- a.author
        )
}

rule UntitledEntry {
    from
        e : BibTeX!BibTeXEntry
    to
        refPara : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        te : BibTeX!TitledEntry
    to
        titlePara : DocBook!Para (
            content <- te.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        te : BibTeX!TitledEntry (
            false
        )
}

rule Article_Title_Journal {
    from
        ar : BibTeX!Article
    to
        journalPara : DocBook!Para (
            content <- ar.journal
        )
}

rule Article_NoTitle_Journal {
    from
        ar : BibTeX!Article (
            false
        )
}

rule Article_Title_NoJournal {
    from
        ar : BibTeX!Article (
            false
        )
}

rule Article_NoTitle_NoJournal {
    from
        ar : BibTeX!Article (
            false
        )
}

