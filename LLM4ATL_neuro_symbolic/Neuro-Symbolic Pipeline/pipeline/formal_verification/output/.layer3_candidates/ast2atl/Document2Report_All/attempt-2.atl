module Document2Report_All;
create OUT : Report from IN : Document;

rule Document2Report {
    from
        sDocument : Document!Document
    to
        tReport : Report!Report (
            title <- sDocument.title,
            author <- sDocument.author,
            sections <- sDocument.sections
        )
}

rule Section2Section {
    from
        sSection : Document!Section
    to
        tSection : Report!Section (
            title <- sSection.title,
            content <- sSection.content,
            order <- sSection.order
        )
}

