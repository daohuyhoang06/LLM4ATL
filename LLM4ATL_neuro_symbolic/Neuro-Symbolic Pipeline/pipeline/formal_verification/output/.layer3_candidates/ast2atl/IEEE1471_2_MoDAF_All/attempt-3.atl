module IEEE1471_2_MoDAF;
create OUT : MoDAF from IN : IEEE1471;

helper def: rationale : String =
    let
        firstRat : IEEE1471!Rationale = IEEE1471!Rationale.allInstances().first()
    in
        ((firstRat.name + ' ') + firstRat.content);

rule IEEE1471Model2MoDAFModel {
    from
        IN : IEEE1471!IEEE1471Model
    to
        out : MoDAF!MoDAFModel (
            name <- IN.name,
            content <- IN.content,
            enterprise <- IN.system,
            environment <- IN.environment,
            operationalMissions <- IN.missions,
            architectures <- IN.architecture,
            architecturalDescription <- IN.architecturalDescription,
            stakeholders <- IN.stakeholders,
            architecturalFrameworks <- IN.libraryViewpoints->asSet()->union(Set{defaultFramework})
        ),
        defaultFramework : MoDAF!ArchitecturalFramework (
            name <- 'Default Framework',
            ownedMember <- IN.viewpoints->select(v | v.hasSource.oclIsUndefined())
        )
}

rule System2Enterprise {
    from
        IN : IEEE1471!System
    to
        out : MoDAF!Enterprise (
            name <- IN.name,
            content <- IN.content,
            inhabits <- IN.inhabits,
            fulfills <- IN.fulfills
        )
}

rule Environment2Environment {
    from
        IN : IEEE1471!Environment
    to
        out : MoDAF!Environment (
            name <- IN.name,
            content <- IN.content,
            influences <- IN.influences
        )
}

rule Mission2OperationalMission {
    from
        IN : IEEE1471!Mission
    to
        out : MoDAF!OperationalMission (
            name <- IN.name,
            content <- IN.content
        )
}

rule Architecture2Architecture {
    from
        IN : IEEE1471!Architecture
    to
        out : MoDAF!Architecture (
            name <- IN.name,
            content <- IN.content,
            describedBy <- IN.describedBy,
            enterprise <- IEEE1471!System.allInstances().first()
        )
}

rule AD2AD {
    from
        IN : IEEE1471!ArchitecturalDescription
    to
        out : MoDAF!ArchitecturalDescription (
            name <- IN.name,
            content <- IN.content,
            viewpoints <- IN.selects,
            products <- IN.organizedBy,
            recommendations <- thisModule.rationale
        )
}

rule Stakeholder2Stakeholder {
    from
        IN : IEEE1471!Stakeholder
    to
        out : MoDAF!Stakeholder (
            name <- IN.name,
            content <- IN.content
        )
}

rule Viewpoint2View {
    from
        IN : IEEE1471!Viewpoint
    to
        out : MoDAF!View (
            name <- IN.name,
            content <- IN.content,
            viewName <- IN.name,
            viewDescription <- IN.content,
            usedToCover <- IN.usedToCover
        )
}

rule View2ArchitecturalProduct {
    from
        IN : IEEE1471!View
    to
        out : MoDAF!ArchitecturalProduct (
            name <- IN.name,
            content <- IN.content,
            description <- IN.content,
            definingView <- IN.conformsTo,
            architecturalElements <- IN.consitsOf
        )
}

rule Model2Element {
    from
        IN : IEEE1471!Model
    to
        out : MoDAF!Elements (
            name <- IN.name,
            content <- IN.content
        )
}

rule Concern2Concern {
    from
        IN : IEEE1471!Concern
    to
        out : MoDAF!Concern (
            name <- IN.name,
            content <- IN.content
        )
}

rule LibraryViewpoint2ArchitecturalFramework {
    from
        IN : IEEE1471!LibraryViewpoint
    to
        out : MoDAF!ArchitecturalFramework (
            name <- IN.name,
            content <- IN.content
        )
}

rule StakeholderHasConcern {
    from
        s : IEEE1471!Stakeholder,
        c : IEEE1471!Concern (
            s.has->includes(c)
        )
    to
        shc : MoDAF!StakeholderHasConcern (
            client <- s,
            supplier <- c,
            owner <- IEEE1471!IEEE1471Model.allInstances().first()
        )
}

