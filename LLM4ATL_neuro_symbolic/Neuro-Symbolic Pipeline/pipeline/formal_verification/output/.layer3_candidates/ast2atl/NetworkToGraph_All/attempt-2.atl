module NetworkToGraph_All;
create OUT : Graph from IN : Network;

lazy rule Component2Entity {
    from
        c : Network!Component
    to
        e : Graph!Entity (
            name <- c.name
        )
}

rule System2Root {
    from
        s : Network!System
    to
        r : Graph!Root (
            entities <- s.components->collect(c | thisModule.Component2Entity(c))
        )
}

rule Link2Link {
    from
        nl : Network!Link
    to
        gl : Graph!Link (
            Entitys <- nl.components->collect(c | thisModule.Component2Entity(c))
        )
}

