module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrBool(attrName : PrimitiveTypes!String) : Boolean =
    false;

helper context XML!Element def: getAttrVal(attrName : PrimitiveTypes!String) : String =
    '';

helper context XML!Element def: get(key : PrimitiveTypes!String) : String =
    self.name;

helper context XML!Element def: getType() : String =
    'Type';

helper context XML!Element def: getEnumId() : String =
    '';

helper context XML!Element def: getText() : String =
    self.value;

helper context XML!Element def: getSeq() : String =
    self.name;

helper context XML!Element def: hasChildren() : Boolean =
    self.children->notEmpty();

helper context XML!Element def: hasAttr(attrName : PrimitiveTypes!String) : Boolean =
    false;

helper context XML!Element def: isAbstract() : Boolean =
    false;

helper def: dslElementsById(id : PrimitiveTypes!String) : Set(DSL!NamedElement) =
    Set{};

helper def: getSubTypes(c : DSL!Classifier) : Set(DSL!Classifier) =
    Set{};

helper def: findType(name : PrimitiveTypes!String) : DSL!Type =
    None;

rule DomainModel {
    from
        r : XML!Root
    to
        dm : DSL!DomainModel (
            name <- r.name,
            identity <- r.name,
            namespace <- 'DefaultNamespace',
            isLoaded <- true,
            types <- Set{stBoolean, stInteger, stString, stEnumId}
        ),
        stBoolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        stInteger : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        stString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        stEnumId : DSL!SimpleType (
            name <- 'EnumId',
            identity <- 'EnumId',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        eClassXml : XML!Element (
            (eClassXml.name = 'Class')
        )
    to
        c : DSL!Class (
            name <- eClassXml.name,
            identity <- eClassXml.name,
            namespace <- 'DefaultNamespace',
            isLoaded <- true,
            isAbstract <- false,
            domainModel <- eClassXml.parent
        )
}

rule Relationship {
    from
        eRelXml : XML!Element (
            (eRelXml.name = 'Relationship')
        )
    to
        rel : DSL!Relationship (
            name <- eRelXml.name,
            identity <- eRelXml.name,
            namespace <- 'DefaultNamespace',
            isLoaded <- true,
            isAbstract <- false,
            domainModel <- eRelXml.parent,
            isEmbedding <- false
        )
}

rule Role {
    from
        eRoleXml : XML!Element (
            (eRoleXml.name = 'Role')
        )
    to
        role : DSL!Role (
            name <- eRoleXml.name,
            identity <- eRoleXml.name,
            min <- 0,
            max <- 1,
            isUnbounded <- false,
            accepts <- '*',
            isOrdered <- false,
            isNavigableFrom <- false,
            isPropertyGenerator <- false,
            relation <- eRoleXml.parent,
            source <- eRoleXml.parent,
            type <- eRoleXml.parent
        )
}

rule ValueProperty {
    from
        eVPXml : XML!Element (
            (eVPXml.name = 'ValueProperty')
        )
    to
        vp : DSL!ValueProperty (
            name <- eVPXml.name,
            identity <- eVPXml.name,
            owner <- eVPXml.parent,
            type <- None
        )
}

rule Enumeration {
    from
        eEnumXml : XML!Element (
            (eEnumXml.name = 'Enumeration')
        )
    to
        en : DSL!Enumeration (
            name <- eEnumXml.name,
            identity <- eEnumXml.name,
            namespace <- 'DefaultNamespace'
        )
}

rule EnumerationLiteral {
    from
        eLitXml : XML!Element (
            (eLitXml.name = 'EnumerationLiteral')
        )
    to
        lit : DSL!EnumerationLiteral (
            name <- eLitXml.name,
            identity <- eLitXml.name,
            value <- 0
        )
}

