module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
    let
        attr : XML!Attribute = XML!Attribute.allInstances()->select(a | ((a.parent = self) and (a.name = name))).first()
    in
        if attr.oclIsUndefined() then
        ''
    else
        attr.value
    endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    (self.getAttrVal(name) = 'true');

helper context XML!Element def: get(name : String) : XML!Element =
    XML!Element.allInstances()->select(e | ((e.parent = self) and (e.name = name))).first();

helper context XML!Element def: getType(name : String) : DSL!Type =
    thisModule.findType(self.getAttrVal(name));

helper context XML!Element def: getEnumId : String =
    self.getAttrVal('enum');

helper context XML!Element def: getText : String =
    let
        text : XML!Text = XML!Text.allInstances()->select(t | (t.parent = self)).first()
    in
        if text.oclIsUndefined() then
        ''
    else
        text.value
    endif;

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    XML!Element.allInstances()->select(e | ((e.parent = self) and (e.name = name)));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    XML!Attribute.allInstances()->exists(a | ((a.parent = self) and (a.name = name)));

helper context XML!Element def: isAbstract : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById(id : String) : DSL!Classifier =
    DSL!Classifier.allInstances()->select(e | (e.identity = id)).first();

helper def: getSubTypes(id : String) : Set(XML!Element) =
    XML!Element.allInstances()->select(e | (((e.name = 'class') or (e.name = 'relationship')) and (e.getAttrVal('superType') = id)));

helper def: findType(name : String) : DSL!Type =
    DSL!Type.allInstances()->select(t | (t.name = name)).first();

rule DomainModel {
    from
        s : XML!Root
    to
        t : DSL!DomainModel (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            classifiers <- s.getSeq('class')->union(s.getSeq('relationship')),
            types <- Set{stringType, integerType, booleanType, realType}->union(s.getSeq('enumeration'))
        ),
        stringType : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- s.getAttrVal('namespace')
        ),
        integerType : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- s.getAttrVal('namespace')
        ),
        booleanType : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- s.getAttrVal('namespace')
        ),
        realType : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- s.getAttrVal('namespace')
        )
}

rule Class {
    from
        s : XML!Element (
            (s.name = 'class')
        )
    to
        t : DSL!Class (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            namespace <- s.parent.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.isAbstract,
            properties <- s.getSeq('property'),
            superType <- thisModule.dslElementsById(s.getAttrVal('superType'))
        )
}

rule Relationship {
    from
        s : XML!Element (
            (s.name = 'relationship')
        )
    to
        t : DSL!Relationship (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            namespace <- s.parent.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.isAbstract,
            isEmbedding <- s.getAttrBool('isEmbedding'),
            properties <- s.getSeq('property'),
            superType <- thisModule.dslElementsById(s.getAttrVal('superType')),
            roles <- s.getSeq('role')
        )
}

rule Role {
    from
        s : XML!Element (
            (s.name = 'role')
        )
    to
        t : DSL!Role (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            min <- s.getAttrVal('min').toInteger(),
            max <- s.getAttrVal('max').toInteger(),
            isUnbounded <- s.getAttrBool('isUnbounded'),
            accepts <- s.getAttrVal('accepts'),
            isOrdered <- s.getAttrBool('isOrdered'),
            isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById(s.getAttrVal('source')),
            type <- thisModule.dslElementsById(s.getAttrVal('type'))
        )
}

rule ValueProperty {
    from
        s : XML!Element (
            (s.name = 'property')
        )
    to
        t : DSL!ValueProperty (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            type <- if s.hasAttr('type') then
    s.getType('type')
else
    s.getType('enum')
endif
        )
}

rule Enumeration {
    from
        s : XML!Element (
            (s.name = 'enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            namespace <- s.parent.getAttrVal('namespace'),
            literals <- s.getSeq('literal')
        )
}

rule EnumerationLiteral {
    from
        s : XML!Element (
            (s.name = 'literal')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('id'),
            value <- s.getAttrVal('value').toInteger()
        )
}

