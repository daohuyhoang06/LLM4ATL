-- User2Account preserves the two identifying fields under the source profile.
context Account
inv AccountHasIdentifiers:
  self.username <> '' and self.email <> '' and
  (self.active = true or self.active = false)

context AccountModel
inv AccountModelPreservesUniqueUsernames:
  self.accounts->notEmpty() and self.accounts->isUnique(a | a.username)
