# Copy this file to .env before running the pipeline.
# Keep the real .env file private; it contains your LLM API key.
GEMINI_API_KEY=your_llm_api_key_here

# Validation and generation layers. Omit a variable to use the default value: true.
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER2_TYPE_CHECK=true
ABLATION_ENABLE_LAYER2_EXISTENCE_CHECK=true
ABLATION_ENABLE_LAYER2_NULL_SAFETY=true
ABLATION_ENABLE_LAYER3_GENERATION=true

# eFinder bounded-search settings. Increase EFINDER_SCOPE when the
# transformation needs more objects; larger values may increase solver time.
EFINDER_SCOPE=8
EFINDER_REFERENCE_SCOPE=8
EFINDER_TIMEOUT_MS=300000
