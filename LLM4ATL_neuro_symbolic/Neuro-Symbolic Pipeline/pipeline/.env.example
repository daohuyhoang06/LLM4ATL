# Choose one provider for each pipeline run: gemini, openai, or claude.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_MAX_OUTPUT_TOKENS=32768
OPENAI_REASONING_EFFORT=medium
# Claude Sonnet 4.5 extended-thinking configuration. This increases token
# usage and latency; the required API output cap is managed internally.
ANTHROPIC_THINKING_BUDGET_TOKENS=8192
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: useful for OpenAI-compatible gateways or an Anthropic proxy.
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-endpoint

# Validation and generation layers. Omit a variable to use the default value: true.
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER2_TYPE_CHECK=true
ABLATION_ENABLE_LAYER2_EXISTENCE_CHECK=true
ABLATION_ENABLE_LAYER2_NULL_SAFETY=true
ABLATION_ENABLE_LAYER3_GENERATION=true

# eFinder bounded-search settings. Increase EFINDER_SCOPE when the
# transformation needs more objects; larger values may increase solver time.
EFINDER_SCOPE=8
EFINDER_REFERENCE_SCOPE=8
EFINDER_TIMEOUT_MS=300000
