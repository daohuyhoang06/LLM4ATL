-- Shows the validator really evaluates OCL:
--   uniqueCode forbids two Items with the same code.
--   With 3 Items and only 2 String atoms  -> UNSATISFIABLE (pigeonhole).
--   With 3 Items and >= 3 String atoms     -> SATISFIABLE.
model Pigeonhole

class Item
attributes
  code : String
end

constraints

context Item inv uniqueCode:
  Item.allInstances->forAll(i, j | i.code = j.code implies i = j)
