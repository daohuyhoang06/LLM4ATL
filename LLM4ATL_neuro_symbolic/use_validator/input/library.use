-- A free-form UML/OCL model (not a transformation model): navigation, forAll,
-- exists, size, closure, associations.  Exercises the validator the way the
-- "specification + search configuration -> import validator" step needs.
model Library

class Library
attributes
  name : String
end

class Book
attributes
  title : String
  copies : Integer
end

class Member
attributes
  name : String
end

association Holdings between
  Library[1] role library
  Book[*] role books
end

association Membership between
  Library[1] role library
  Member[*] role members
end

association Loan between
  Member[*] role borrowers
  Book[*] role borrowed
end

constraints

context Library inv uniqueBookTitles:
  self.books->forAll(b1, b2 | b1.title = b2.title implies b1 = b2)

context Book inv positiveCopies:
  self.copies >= 1

context Book inv notOverLent:
  self.borrowers->size() <= self.copies

context Member inv borrowsFromOwnLibrary:
  self.borrowed->forAll(b | b.library = self.library)

context Library inv hasAtLeastOneBook:
  self.books->size() >= 1
