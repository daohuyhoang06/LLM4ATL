module IndirectRecursiveHelper;

create OUT : TGT from IN : SRC;

-- ATL2TM must reject this indirect recursion: first() -> second() -> first().
helper context SRC!A def: first(value : String) : Boolean =
    self.second(value);

helper context SRC!A def: second(value : String) : Boolean =
    self.first(value);

rule A2B {
    from
        a : SRC!A (a.first('x'))
    to
        b : TGT!B
}
