module HelperParams;

create OUT : TGT from IN : SRC;

-- Non-recursive chain: isWanted() -> hasKind(value).
helper context SRC!A def: hasKind(value : String) : Boolean =
    let local : String = value in
        self.kind = local;

-- Iterator value shadow formal value inside the exists body.
helper context SRC!A def: hasAnyKind(value : String) : Boolean =
    Sequence { value }->exists(value | self.kind = value);

helper context SRC!A def: isWanted() : Boolean =
    self.hasKind('x') and self.hasAnyKind('x');

rule A2B {
    from
        a : SRC!A (a.isWanted())
    to
        b : TGT!B
}
