    <eClassifiers name="FamilyRegisterToPersonRegister" xsi:type="ecore:EClass">
            
        <eAnnotations source="urn:llm4atl:provenance">
                  
            <details key="origin" value="trace"/>
                  
            <details key="atlRule" value="FamilyRegisterToPersonRegister"/>
                  
            <details key="semConstraints" value="bind_FamilyRegisterToPersonRegister_t_id null_FamilyRegisterToPersonRegister_t_persons"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="bind_FamilyRegisterToPersonRegister_t_id null_FamilyRegisterToPersonRegister_t_persons"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="bind_FamilyRegisterToPersonRegister_t_id" value="self.t.id = self.s.id"/>
                  
            <details key="null_FamilyRegisterToPersonRegister_t_persons" value="self.t.persons-&gt;isEmpty()"/>
                
        </eAnnotations>
            
        <eStructuralFeatures eOpposite="//FamilyRegister/FamilyRegisterToPersonRegister_s" eType="//FamilyRegister" lowerBound="1" name="s" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//PersonRegister/FamilyRegisterToPersonRegister_t" eType="//PersonRegister" lowerBound="1" name="t" xsi:type="ecore:EReference"/>
          
