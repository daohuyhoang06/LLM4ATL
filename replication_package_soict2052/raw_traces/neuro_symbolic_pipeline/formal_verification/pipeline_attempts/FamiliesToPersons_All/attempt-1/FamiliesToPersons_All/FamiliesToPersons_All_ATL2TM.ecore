    <eClassifiers name="MemberToMale" xsi:type="ecore:EClass">
            
        <eAnnotations source="urn:llm4atl:provenance">
                  
            <details key="origin" value="trace"/>
                  
            <details key="atlRule" value="MemberToMale"/>
                  
            <details key="semConstraints" value="match_MemberToMale_cond bind_MemberToMale_t_fullName"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="match_MemberToMale_cond bind_MemberToMale_t_fullName"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="match_MemberToMale_cond" value="((not self.s.familyFather.oclIsUndefined()) or (not self.s.familySon.oclIsUndefined()))"/>
                  
            <details key="bind_MemberToMale_t_fullName" value="self.t.fullName = ((self.s.firstName + ' ') + (if (not self.s.familyFather.oclIsUndefined()) then self.s.familyFather.lastName else (if (not self.s.familyMother.oclIsUndefined()) then self.s.familyMother.lastName else (if (not self.s.familySon.oclIsUndefined()) then self.s.familySon.lastName else self.s.familyDaughter.lastName endif) endif) endif))"/>
                  
    
        </eAnnotations>
            
        <eStructuralFeatures eOpposite="//Member/MemberToMale_s" eType="//Member" lowerBound="1" name="s" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Male/MemberToMale_t" eType="//Male" lowerBound="1" name="t" xsi:type="ecore:EReference"/>
          
    </eClassifiers>
      
