    <eClassifiers name="Member" xsi:type="ecore:EClass">
            
        <eAnnotations source="urn:llm4atl:provenance">
                  
            <details key="origin" value="source"/>
                  
            <details key="originalName" value="Member"/>
                  
            <details key="atlRules" value="MemberToMale MemberToFemale"/>
                  
            <details key="preConstraints" value=""/>
                  
            <details key="postConstraints" value=""/>
                  
            <details key="targetMultiplicityConstraints" value=""/>
                  
            <details key="unsupportedPrimitiveTargetMultiplicityConstraints" value=""/>
                  
            <details key="semConstraints" value="match_MemberToMale match_MemberToFemale mutex_MemberToMale_MemberToFemale"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="match_MemberToMale match_MemberToFemale mutex_MemberToMale_MemberToFemale"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="match_MemberToMale" value="Member.allInstances()-&gt;forAll(s : Member | ((not s.familyFather.oclIsUndefined()) or (not s.familySon.oclIsUndefined())) implies MemberToMale.allInstances()-&gt;one(z : MemberToMale | z.s = s))"/>
                  
            <details key="match_MemberToFemale" value="Member.allInstances()-&gt;forAll(s : Member | ((not s.familyMother.oclIsUndefined()) or (not s.familyDaughter.oclIsUndefined())) implies MemberToFemale.allInstances()-&gt;one(z : MemberToFemale | z.s = s))"/>
                  
            <details key="mutex_MemberToMale_MemberToFemale" value="(Member.allInstances()-&gt;forAll(s : Member | not (MemberToMale.allInstances()-&gt;exists(z1 : MemberToMale | z1.s = s) and MemberToFemale.allInstances()-&gt;exists(z2 : MemberToFemale | z2.s = s))))"/>
                
        </eAnnotations>
            
        <eStructuralFeatures name="firstName" ordered="false" unique="false" xsi:type="ecore:EAttribute">
                  
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                
        </eStructuralFeatures>
            
        <eStructuralFeatures eOpposite="//Family/sons" eType="//Family" name="familySon" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Family/daughters" eType="//Family" name="familyDaughter" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Family/father" eType="//Family" name="familyFather" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Family/mother" eType="//Family" name="familyMother" ordered="false" unique="false" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//MemberToMale/s" eType="//MemberToMale" name="MemberToMale_s" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//MemberToFemale/s" eType="//MemberToFemale" name="MemberToFemale_s" xsi:type="ecore:EReference"/>
          
    </eClassifiers>
      
