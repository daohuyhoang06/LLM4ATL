        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="match_MemberToFemale_cond bind_MemberToFemale_t_fullName"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="match_MemberToFemale_cond" value="((not self.s.familyMother.oclIsUndefined()) or (not self.s.familyDaughter.oclIsUndefined()))"/>
                  
            <details key="bind_MemberToFemale_t_fullName" value="self.t.fullName = ((self.s.firstName + ' ') + (if (not self.s.familyFather.oclIsUndefined()) then self.s.familyFather.lastName else (if (not self.s.familyMother.oclIsUndefined()) then self.s.familyMother.lastName else (if (not self.s.familySon.oclIsUndefined()) then self.s.familySon.lastName else self.s.familyDaughter.lastName endif) endif) endif))"/>
                  
    
        </eAnnotations>
            
        <eStructuralFeatures eOpposite="//Member/MemberToFemale_s" eType="//Member" lowerBound="1" name="s" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//Female/MemberToFemale_t" eType="//Female" lowerBound="1" name="t" xsi:type="ecore:EReference"/>
          
    </eClassifiers>
    
