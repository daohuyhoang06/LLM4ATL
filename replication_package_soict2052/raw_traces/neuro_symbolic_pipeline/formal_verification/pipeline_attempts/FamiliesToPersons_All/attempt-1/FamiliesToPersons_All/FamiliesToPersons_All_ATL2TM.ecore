            <details key="semConstraints" value="create_Person"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                  
            <details key="constraints" value="create_Person"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="create_Person" value="(if self.oclIsKindOf(Male) then (if self.oclAsType(Male).MemberToMale_t.oclIsUndefined() then 0 else 1 endif) else 0 endif) + (if self.oclIsKindOf(Female) then (if self.oclAsType(Female).MemberToFemale_t.oclIsUndefined() then 0 else 1 endif) else 0 endif) = 1"/>
                
        </eAnnotations>
            
