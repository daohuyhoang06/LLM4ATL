        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="ER_attrOwnerXor" value="self.entity.oclIsUndefined() &lt;&gt; self.relship.oclIsUndefined()"/>
                  
            <details key="match_EA2A" value="ERAttribute.allInstances()-&gt;forAll(att : ERAttribute | Entity.allInstances()-&gt;forAll(ent : Entity | (att.entity = ent) implies EA2A.allInstances()-&gt;one(z : EA2A | z.att = att and z.ent = ent)))"/>
                  
            <details key="match_RA2A" value="ERAttribute.allInstances()-&gt;forAll(att : ERAttribute | Relship.allInstances()-&gt;forAll(rs : Relship | (att.relship = rs) implies RA2A.allInstances()-&gt;one(z : RA2A | z.att = att and z.rs = rs)))"/>
                  
            <details key="match_RA2AK" value="ERAttribute.allInstances()-&gt;forAll(att : ERAttribute | RelshipEnd.allInstances()-&gt;forAll(rse : RelshipEnd | ((att.entity = rse.entity) and att.isKey) implies RA2AK.allInstances()-&gt;one(z : RA2AK | z.att = att and z.rse = rse)))"/>
                
        </eAnnotations>
            
        <eStructuralFeatures lowerBound="1" name="name" xsi:type="ecore:EAttribute">
                  
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EString" xsi:type="ecore:EDataType"/>
                
        </eStructuralFeatures>
            
        <eStructuralFeatures lowerBound="1" name="isKey" xsi:type="ecore:EAttribute">
                  
            <eType href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" xsi:type="ecore:EDataType"/>
                
        </eStructuralFeatures>
            
