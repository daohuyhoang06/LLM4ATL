        <eStructuralFeatures eOpposite="//Relship/attrs" eType="//Relship" name="relship" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//EA2A/att" eType="//EA2A" name="EA2A_att" upperBound="-1" xsi:type="ecore:EReference"/>
            
        <eStructuralFeatures eOpposite="//RA2A/att" eType="//RA2A" name="RA2A_att" upperBound="-1" xsi:type="ecore:EReference"/>
            
