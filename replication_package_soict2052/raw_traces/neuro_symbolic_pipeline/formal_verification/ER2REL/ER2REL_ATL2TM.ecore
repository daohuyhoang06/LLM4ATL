        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="bind_S2S_t_relations" value="self.t.relations = Set { self.s.entities-&gt;collect(x | (if x.oclIsKindOf(Entity) then E2R.allInstances()-&gt;select(z : E2R | z.s = x.oclAsType(Entity))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten(), self.s.relships-&gt;collect(x | (if x.oclIsKindOf(Relship) then R2R.allInstances()-&gt;select(z : R2R | z.s = x.oclAsType(Relship))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                  
            <details key="bind_S2S_t_relations_size" value="(self.s.entities-&gt;union(self.s.relships))-&gt;size() = (Set { self.s.entities-&gt;collect(x | (if x.oclIsKindOf(Entity) then E2R.allInstances()-&gt;select(z : E2R | z.s = x.oclAsType(Entity))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten(), self.s.relships-&gt;collect(x | (if x.oclIsKindOf(Relship) then R2R.allInstances()-&gt;select(z : R2R | z.s = x.oclAsType(Relship))-&gt;collect(z | z.t) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                
        </eAnnotations>
            
