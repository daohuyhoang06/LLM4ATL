module network2graph;
create OUT : Graph from IN : Network;

rule System {
    from
        s : Network!System
    to
        t : Graph!Root (
            entities <- s.components
        )
}

rule Component {
    from
        c : Network!Component
    to
        e : Graph!Entity (
            name <- c.name
        )
}

rule Link {
    from
        l : Network!Link
    to
        gl : Graph!Link (
            Entitys <- l.components
        )
}

