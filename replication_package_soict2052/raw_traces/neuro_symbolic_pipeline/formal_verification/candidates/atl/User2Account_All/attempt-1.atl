module User2Account;
create OUT : Account from IN : User;

rule UserModel2AccountModel {
    from
        s : User!UserModel
    to
        t : Account!AccountModel (
            accounts <- s.users
        )
}

rule User2Account {
    from
        s : User!User
    to
        t : Account!Account (
            username <- s.username,
            email <- s.email,
            createdDate <- s.registrationDate,
            active <- ((s.status = 'Active') or (s.status = 'Enabled'))
        )
}

