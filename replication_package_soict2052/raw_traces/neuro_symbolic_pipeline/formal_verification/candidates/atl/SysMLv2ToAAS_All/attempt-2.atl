rule AttributeDefinition2Property {
    from
        e : sysml!AttributeDefinition
    to
        prop : AAS!Property (
            idShort <- if e.declaredName.oclIsUndefined() then
    'AttributeDefinition'
else
    e.declaredName
endif,
            value <- '',
            qualifier <- q
        ),
        q : AAS!Qualifier (
            type <- 'AttributeDefinition',
            value <- 'SysMLv2'
        )
}

