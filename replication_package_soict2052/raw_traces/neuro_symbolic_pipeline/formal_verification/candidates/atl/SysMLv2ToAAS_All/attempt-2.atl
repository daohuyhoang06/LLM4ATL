module SysMLv2ToAAS_All;
create OUT : AAS from IN : SysMLv2;

helper context sysml!Element def: getOwnedElements() : Set(sysml!Element) =
    self.ownedRelationship->collect(r | r.ownedRelatedElement)->asSet();

rule Package2AasModelRoot {
    from
        p : sysml!Package
    to
        root : AAS!AasModelRoot (
            name <- if p.declaredName.oclIsUndefined() then
    'Package'
else
    p.declaredName
endif,
            assetadministrationshells <- Bag{aas}
        ),
        aas : AAS!AssetAdministrationShell (
            idShort <- if p.declaredName.oclIsUndefined() then
    'Package'
else
    p.declaredName
endif,
            assetInformation <- info,
            asset <- asset,
            submodel <- Bag{sm}
        ),
        info : AAS!AssetInformation (
            assetKind <- #Instance
        ),
        asset : AAS!Asset (
            idShort <- if p.declaredName.oclIsUndefined() then
    'Asset'
else
    (p.declaredName + '_Asset')
endif,
            kind <- #Instance,
            identification <- assetId
        ),
        assetId : AAS!Identifier (
            id <- if p.declaredName.oclIsUndefined() then
    'Asset'
else
    (p.declaredName + '_Asset')
endif,
            idType <- #Custom
        ),
        sm : AAS!Submodel (
            idShort <- 'Hierarchical Structures',
            identification <- smId,
            submodelelement <- p.getOwnedElements()
        ),
        smId : AAS!Identifier (
            id <- 'Hierarchical_Structures',
            idType <- #Custom
        )
}

rule PartDefinition2Entity {
    from
        e : sysml!PartDefinition
    to
        ent : AAS!Entity (
            idShort <- if e.declaredName.oclIsUndefined() then
    'PartDefinition'
else
    e.declaredName
endif,
            entityType <- #SelfManagedEntity,
            qualifier <- q,
            submodelelement <- e.getOwnedElements()
        ),
        q : AAS!Qualifier (
            type <- 'PartDefinition',
            value <- 'SysMLv2'
        )
}

