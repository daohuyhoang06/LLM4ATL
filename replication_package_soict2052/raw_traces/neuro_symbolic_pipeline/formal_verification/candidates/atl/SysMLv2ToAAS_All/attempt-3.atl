module SysMLv2ToAAS_All;
create OUT : AAS from IN : sysml;

helper context sysml!Element def: getOwnedElements() : Set(sysml!Element) =
    sysml!Element.allInstances()->select(e | if e.owningRelationship.oclIsUndefined() then
        false
    else
        (e.owningRelationship.owningRelatedElement = self)
    endif);

rule PackageToAAS {
    from
        s : sysml!Package (
            s.oclIsTypeOf(sysml!Package)
        )
    to
        root : AAS!AasModelRoot (
            name <- if s.declaredName.oclIsUndefined() then
    'Package'
else
    s.declaredName
endif,
            assetadministrationshells <- Set{aas}
        ),
        aas : AAS!AssetAdministrationShell (
            idShort <- if s.declaredName.oclIsUndefined() then
    'Package'
else
    s.declaredName
endif,
            identification <- aasId,
            assetInformation <- assetInfo,
            asset <- asset,
            submodel <- Set{submodel}
        ),
        aasId : AAS!Identifier (
            idType <- #IRI,
            id <- if s.declaredName.oclIsUndefined() then
    'urn:sysml:package'
else
    ('urn:sysml:' + s.declaredName)
endif
        ),
        assetInfo : AAS!AssetInformation (
            assetKind <- #Instance
        ),
        asset : AAS!Asset (
            idShort <- if s.declaredName.oclIsUndefined() then
    'Asset'
else
    (s.declaredName + '_Asset')
endif,
            kind <- #Instance,
            identification <- assetId
        ),
        assetId : AAS!Identifier (
            idType <- #IRI,
            id <- if s.declaredName.oclIsUndefined() then
    'urn:sysml:asset'
else
    ('urn:sysml:asset:' + s.declaredName)
endif
        ),
        submodel : AAS!Submodel (
            idShort <- 'Hierarchical Structures',
            identification <- submodelId,
            submodelelement <- s.getOwnedElements()
        ),
        submodelId : AAS!Identifier (
            idType <- #IRI,
            id <- 'urn:sysml:submodel:hierarchical_structures'
        )
}

rule PartDefinitionToEntity {
    from
        s : sysml!PartDefinition (
            s.oclIsTypeOf(sysml!PartDefinition)
        )
    to
        out : AAS!Entity (
            idShort <- if s.declaredName.oclIsUndefined() then
    'unnamed'
else
    s.declaredName
endif,
            entityType <- #SelfManagedEntity,
            qualifier <- q,
            submodelelement <- s.getOwnedElements()
        ),
        q : AAS!Qualifier (
            type <- 'PartDefinition',
            value <- if s.declaredName.oclIsUndefined() then
    'PartDefinition'
else
    s.declaredName
endif
        )
}

