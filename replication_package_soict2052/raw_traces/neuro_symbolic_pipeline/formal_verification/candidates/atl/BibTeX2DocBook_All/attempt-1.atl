module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
    BibTeX!Author.allInstances()->select(e | (BibTeX!Author.allInstances()->select(f | (f.author = e.author))->first() = e));

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
    BibTeX!TitledEntry.allInstances()->select(e | (BibTeX!TitledEntry.allInstances()->select(f | (f.title = e.title))->first() = e));

helper def: articleSet : Set(BibTeX!Article) =
    BibTeX!Article.allInstances()->select(e | (BibTeX!Article.allInstances()->select(f | (f.journal = e.journal))->first() = e));

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    ((((self.id + if self.oclIsKindOf(BibTeX!TitledEntry) then
        (' ' + self.title)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!DatedEntry) then
        (' ' + self.year)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!BookTitledEntry) then
        (' ' + self.booktitle)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Article) then
        (' ' + self.journal)
    else
        ''
    endif);

rule Main {
    from
        e : BibTeX!BibTeXFile
    to
        docbook : DocBook!DocBook (
            books <- book
        ),
        book : DocBook!Book (
            articles <- article
        ),
        article : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Bag{se1, se2, se3, se4}
        ),
        se1 : DocBook!Sect1 (
            title <- 'References List',
            paras <- BibTeX!BibTeXEntry.allInstances()->sortedBy(e | e.id)
        ),
        se2 : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- thisModule.authorSet->sortedBy(a | a.author)
        ),
        se3 : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- thisModule.titledEntrySet->sortedBy(e | e.title)->collect(e | thisModule.resolveTemp(e, 't'))
        ),
        se4 : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- thisModule.articleSet->sortedBy(e | e.journal)->collect(e | thisModule.resolveTemp(e, 'j'))
        )
}

rule Author {
    from
        a : BibTeX!Author (
            thisModule.authorSet->includes(a)
        )
    to
        p : DocBook!Para (
            content <- a.author
        )
}

rule UntitledEntry {
    from
        e : BibTeX!BibTeXEntry (
            not e.oclIsKindOf(BibTeX!TitledEntry)
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        t : DocBook!Para (
            content <- e.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule Article_Title_Journal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        t : DocBook!Para (
            content <- e.title
        ),
        j : DocBook!Para (
            content <- e.journal
        )
}

rule Article_NoTitle_Journal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        j : DocBook!Para (
            content <- e.journal
        )
}

rule Article_Title_NoJournal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        t : DocBook!Para (
            content <- e.title
        )
}

rule Article_NoTitle_NoJournal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

