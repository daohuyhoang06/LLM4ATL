module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
 let attr : XML!Attribute = self.children->any(c | c.oclIsTypeOf(XML!Attribute) and c.name = name) in
 if attr.oclIsUndefined() then
  ''
 else
  attr.value
 endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
 self.getAttrVal(name) = 'true';

helper context XML!Element def: get(name : String) : XML!Element =
 self.children->any(c | c.oclIsTypeOf(XML!Element) and c.name = name);

helper context XML!Element def: getType(name : String) : XML!Element =
 let typeId : String = self.getAttrVal(name) in
 thisModule.dslElementsById.get(typeId);

helper context XML!Element def: getEnumId(name : String) : String =
 self.getAttrVal(name);

helper context XML!Element def: getText(name : String) : String =
 let e : XML!Element = self.get(name) in
 if e.oclIsUndefined() then
  ''
 else
  let t : XML!Text = e.children->any(c | c.oclIsTypeOf(XML!Text)) in
  if t.oclIsUndefined() then '' else t.value endif
 endif;

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
 let direct : Sequence(XML!Element) = self.children->select(c | c.oclIsTypeOf(XML!Element) and c.name = name) in
 if direct.isEmpty() then
  let wrapper : XML!Element = self.children->any(c | c.oclIsTypeOf(XML!Element) and c.name = name) in
  if wrapper.oclIsUndefined() then
   Sequence{}
  else
   wrapper.children->select(e | e.oclIsTypeOf(XML!Element))
  endif
 else
  direct
 endif;

helper context XML!Element def: hasChildren(name : String) : Boolean =
 self.getSeq(name).size() > 0;

helper context XML!Element def: hasAttr(name : String) : Boolean =
 not self.children->any(c | c.oclIsTypeOf(XML!Attribute) and c.name = name).oclIsUndefined();

helper context XML!Element def: isAbstract : Boolean =
 self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
 XML!Element.allInstances()->iterate(e; acc : Map(String, XML!Element) = Map{} |
  let id : String = if e.hasAttr('id') then e.getAttrVal('id') else e.getAttrVal('identity') endif in
  if id = '' then
   acc
  else
   acc.insert(id, e)
  endif
 );

helper def: getSubTypes(id : String) : Sequence(XML!Element) =
 XML!Element.allInstances()
  ->select(e | e.name = 'Class' or e.name = 'Relationship')
  ->select(e | e.getAttrVal('superType') = id);

helper def: findType(id : String) : DSL!Type =
 let xmlEl : XML!Element = thisModule.dslElementsById.get(id) in
 if xmlEl.oclIsUndefined() then
  let simpleTypes : Sequence(DSL!SimpleType) = DSL!SimpleType.allInstances() in
  if id = 'String' or id = 'string' then
   simpleTypes->any(t | t.name = 'String')
  else if id = 'Integer' or id = 'integer' or id = 'int' then
   simpleTypes->any(t | t.name = 'Integer')
  else if id = 'Boolean' or id = 'boolean' then
   simpleTypes->any(t | t.name = 'Boolean')
  else if id = 'Double' or id = 'double' or id = 'Real' or id = 'real' then
   simpleTypes->any(t | t.name = 'Double')
  else
   OclUndefined
  endif endif endif endif
 else
  xmlEl
 endif;

rule DomainModel {
 from
  s : XML!Root (s.name = 'DomainModel')
 to
  t : DSL!DomainModel (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   isLoaded <- s.getAttrBool('isLoaded'),
   namespace <- s.getAttrVal('namespace'),
   classifiers <- s.getSeq('classifiers'),
   types <- s.getSeq('types')->union(Sequence{stringType, integerType, booleanType, doubleType})
  ),
  stringType : DSL!SimpleType (
   name <- 'String',
   identity <- 'String',
   namespace <- s.getAttrVal('namespace')
  ),
  integerType : DSL!SimpleType (
   name <- 'Integer',
   identity <- 'Integer',
   namespace <- s.getAttrVal('namespace')
  ),
  booleanType : DSL!SimpleType (
   name <- 'Boolean',
   identity <- 'Boolean',
   namespace <- s.getAttrVal('namespace')
  ),
  doubleType : DSL!SimpleType (
   name <- 'Double',
   identity <- 'Double',
   namespace <- s.getAttrVal('namespace')
  )
}

rule Class {
 from
  s : XML!Element (s.name = 'Class')
 to
  t : DSL!Class (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   isLoaded <- s.getAttrBool('isLoaded'),
   namespace <- s.getAttrVal('namespace'),
   isAbstract <- s.isAbstract,
   properties <- s.getSeq('properties'),
   superType <- s.getType('superType'),
   subTypes <- thisModule.getSubTypes(s.getAttrVal('id'))
  )
}

rule Relationship {
 from
  s : XML!Element (s.name = 'Relationship')
 to
  t : DSL!Relationship (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   isLoaded <- s.getAttrBool('isLoaded'),
   namespace <- s.getAttrVal('namespace'),
   isAbstract <- s.isAbstract,
   isEmbedding <- s.getAttrBool('isEmbedding'),
   properties <- s.getSeq('properties'),
   roles <- s.getSeq('roles'),
   superType <- s.getType('superType'),
   subTypes <- thisModule.getSubTypes(s.getAttrVal('id'))
  )
}

rule Role {
 from
  s : XML!Element (s.name = 'Role')
 to
  t : DSL!Role (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   min <- if s.hasAttr('min') then s.getAttrVal('min').toInteger() else 0 endif,
   max <- if s.hasAttr('max') then s.getAttrVal('max').toInteger() else 0 endif,
   isUnbounded <- s.getAttrBool('isUnbounded'),
   accepts <- s.getAttrVal('accepts'),
   isOrdered <- s.getAttrBool('isOrdered'),
   isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
   isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
   source <- s.getType('source'),
   type <- s.getType('type')
  )
}

rule ValueProperty {
 from
  s : XML!Element (s.name = 'ValueProperty')
 to
  t : DSL!ValueProperty (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   type <- thisModule.findType(s.getAttrVal('type'))
  )
}

rule Enumeration {
 from
  s : XML!Element (s.name = 'Enumeration')
 to
  t : DSL!Enumeration (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   namespace <- s.getAttrVal('namespace'),
   literals <- s.getSeq('literals')
  )
}

rule EnumerationLiteral {
 from
  s : XML!Element (s.name = 'EnumerationLiteral')
 to
  t : DSL!EnumerationLiteral (
   name <- s.getAttrVal('name'),
   identity <- s.getAttrVal('id'),
   value <- if s.hasAttr('value') then s.getAttrVal('value').toInteger() else 0 endif
  )
}