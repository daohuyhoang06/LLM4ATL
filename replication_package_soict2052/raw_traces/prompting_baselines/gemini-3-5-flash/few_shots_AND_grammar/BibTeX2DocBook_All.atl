module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
  BibTeX!Author.allInstances()->iterate(e; res : Set(BibTeX!Author) = Set{} |
    if res->exists(a | a.name = e.name) then
      res
    else
      res->including(e)
    endif
  );

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
  BibTeX!TitledEntry.allInstances()->iterate(e; res : Set(BibTeX!TitledEntry) = Set{} |
    if res->exists(t | t.title = e.title) then
      res
    else
      res->including(e)
    endif
  );

helper def: articleSet : Set(BibTeX!Article) =
  BibTeX!Article.allInstances()->iterate(e; res : Set(BibTeX!Article) = Set{} |
    if res->exists(a | a.journal = e.journal) then
      res
    else
      res->including(e)
    endif
  );

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
  let typeName : String = self.oclType().name in
  let titleStr : String =
    if self.oclIsKindOf(BibTeX!TitledEntry) then
      ' ' + self.title
    else
      ''
    endif
  in
  let authorsStr : String =
    if self.oclIsKindOf(BibTeX!AuthoredEntry) then
      self.authors->iterate(e; acc : String = '' |
        acc + ' ' + e.name
      )
    else
      ''
    endif
  in
  let yearStr : String =
    if self.year.oclIsUndefined() then
      ''
    else
      ' ' + self.year
    endif
  in
  let booktitleStr : String =
    if self.oclIsKindOf(BibTeX!BookTitledEntry) then
      ' ' + self.booktitle
    else
      ''
    endif
  in
  let schoolStr : String =
    if self.oclIsKindOf(BibTeX!ThesisEntry) then
      ' ' + self.school
    else
      ''
    endif
  in
  let journalStr : String =
    if self.oclIsKindOf(BibTeX!Article) then
      ' ' + self.journal
    else
      ''
    endif
  in
  let noteStr : String =
    if self.note.oclIsUndefined() then
      ''
    else
      ' ' + self.note
    endif
  in
  let publisherStr : String =
    if self.oclIsKindOf(BibTeX!Book) then
      ' ' + self.publisher
    else
      ''
    endif
  in
  let chapterStr : String =
    if self.oclIsKindOf(BibTeX!InBook) then
      ' ' + self.chapter.toString()
    else
      ''
    endif
  in
  '[' + self.id + '] ' + typeName + titleStr + authorsStr + yearStr + booktitleStr + schoolStr + journalStr + noteStr + publisherStr + chapterStr;

rule Main {
  from
    bib : BibTeX!BibTeXFile
  to
    doc : DocBook!DocBook (
      books <- Sequence{book}
    ),
    book : DocBook!Book (
      articles <- Sequence{art}
    ),
    art : DocBook!Article (
      title <- 'BibTeXML to DocBook',
      sections_1 <- Sequence{sec1, sec2, sec3, sec4}
    ),
    sec1 : DocBook!Sect1 (
      title <- 'References List',
      paras <- BibTeX!BibTeXEntry.allInstances()->sortedBy(e | e.id)->collect(e | thisModule.resolveTemp(e, 'p'))
    ),
    sec2 : DocBook!Sect1 (
      title <- 'Authors list',
      paras <- thisModule.authorSet->sortedBy(a | a.name)->collect(a | thisModule.resolveTemp(a, 'p'))
    ),
    sec3 : DocBook!Sect1 (
      title <- 'Titles List',
      paras <- thisModule.titledEntrySet->sortedBy(e | e.title)->collect(e | thisModule.resolveTemp(e, 'tp'))
    ),
    sec4 : DocBook!Sect1 (
      title <- 'Journals List',
      paras <- thisModule.articleSet->sortedBy(e | e.journal)->collect(e | thisModule.resolveTemp(e, 'jp'))
    )
}

rule Author {
  from
    a : BibTeX!Author (
      thisModule.authorSet->includes(a)
    )
  to
    p : DocBook!Para (
      content <- a.name
    )
}

rule UntitledEntry {
  from
    e : BibTeX!BibTeXEntry (
      not e.oclIsKindOf(BibTeX!TitledEntry)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    )
}

rule TitledEntry_Title_NoArticle {
  from
    e : BibTeX!TitledEntry (
      not e.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(e)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    ),
    tp : DocBook!Para (
      content <- e.title
    )
}

rule TitledEntry_NoTitle_NoArticle {
  from
    e : BibTeX!TitledEntry (
      not e.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(e)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    )
}

rule Article_Title_Journal {
  from
    e : BibTeX!Article (
      thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    ),
    tp : DocBook!Para (
      content <- e.title
    ),
    jp : DocBook!Para (
      content <- e.journal
    )
}

rule Article_NoTitle_Journal {
  from
    e : BibTeX!Article (
      not thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    ),
    jp : DocBook!Para (
      content <- e.journal
    )
}

rule Article_Title_NoJournal {
  from
    e : BibTeX!Article (
      thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    ),
    tp : DocBook!Para (
      content <- e.title
    )
}

rule Article_NoTitle_NoJournal {
  from
    e : BibTeX!Article (
      not thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e)
    )
  to
    p : DocBook!Para (
      content <- e.buildEntryPara()
    )
}