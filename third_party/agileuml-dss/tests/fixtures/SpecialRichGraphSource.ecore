<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="richGraphSource" nsURI="http://example.org/rich/source"
    nsPrefix="richSource">
  <eClassifiers xsi:type="ecore:EEnum" name="NodeKind">
    <eLiterals name="ROOT" value="0"/>
    <eLiterals name="LEAF" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GraphModel">
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodes"
        upperBound="-1" eType="#//Node" containment="true" ordered="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Node">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" eType="#//NodeKind"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        upperBound="-1" eType="#//Node" containment="true"/>
  </eClassifiers>
</ecore:EPackage>
