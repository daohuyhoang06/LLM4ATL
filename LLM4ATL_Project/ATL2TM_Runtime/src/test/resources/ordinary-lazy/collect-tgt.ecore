<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="Target" nsURI="http://example.org/ordinaryLazyCollectTarget" nsPrefix="Target">
  <eClassifiers xsi:type="ecore:EClass" name="BoxOut">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="atMostOneTag emptyInputHasEmptyTags"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="atMostOneTag" value="self.tags->size() &lt;= 1"/>
      <details key="emptyInputHasEmptyTags" value="self.Box2Box_t.s.items->isEmpty() implies self.tags->isEmpty()"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tags" eType="#//Tag"
        upperBound="-1" ordered="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tag1" eType="#//Tag"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Tag">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
