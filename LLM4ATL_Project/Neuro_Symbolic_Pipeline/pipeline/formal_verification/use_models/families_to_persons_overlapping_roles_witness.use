-- USE model for the overlapping-family-roles counterexample in the paper.
-- Load the companion .soil file to instantiate the witness object diagram,
-- then run `check`.  The rule-guard invariants hold, whereas the verification
-- property NoOverlappingRuleTraces is intentionally violated.

model FamiliesToPersons_OverlappingRoles_Witness

class FamilyRegister
attributes
  id : String
end

class Family
attributes
  lastName : String
end

class Member
attributes
  firstName : String
end

class PersonRegister
attributes
  id : String
end

abstract class Person
attributes
  fullName : String
  birthday : String
end

class Male < Person
end

class Female < Person
end

-- Trace classes generated by the two overlapping ATL matched rules.
class Member2Male
end

class Member2Female
end

association FamilyRegisterFamilies between
  FamilyRegister[0..1] role register
  Family[0..*] role families
end

association FamilySons between
  Family[0..1] role familySon
  Member[0..*] role sons
end

association FamilyDaughters between
  Family[0..1] role familyDaughter
  Member[0..*] role daughters
end

association FamilyFather between
  Family[0..1] role familyFather
  Member[0..1] role father
end

association FamilyMother between
  Family[0..1] role familyMother
  Member[0..1] role mother
end

association PersonRegisterPersons between
  PersonRegister[0..1] role register
  Person[0..*] role persons
end

association Member2Male_mem between
  Member2Male[0..1] role Member2Male_mem
  Member[1] role mem
end

association Member2Male_m between
  Member2Male[0..1] role Member2Male_m
  Male[1] role m
end

association Member2Female_mem between
  Member2Female[0..1] role Member2Female_mem
  Member[1] role mem
end

association Member2Female_f between
  Member2Female[0..1] role Member2Female_f
  Female[1] role f
end

constraints

-- The trace objects must satisfy the guards of their corresponding ATL rules.
context Member2Male inv Member2MaleGuard:
  not self.mem.familyFather.oclIsUndefined() or
  not self.mem.familySon.oclIsUndefined()

context Member2Female inv Member2FemaleGuard:
  not self.mem.familyMother.oclIsUndefined() or
  not self.mem.familyDaughter.oclIsUndefined()

-- Verification obligation, not an assumed mutex semantic constraint.
-- Its violation is what makes the companion snapshot a counterexample.
context Member inv NoOverlappingRuleTraces:
  self.Member2Male_mem.oclIsUndefined() or
  self.Member2Female_mem.oclIsUndefined()
