-- @hot-atl2tm-part 0091
helper def : isDirectResolveTempBinding(b : ATL!Binding) : Boolean =
    if b.outPatternElement.outPattern.rule.oclIsTypeOf(ATL!MatchedRule)
       and b.value.oclIsTypeOf(ATL!OperationCallExp) then
        let e : ATL!OperationCallExp = b.value
        in
        e.operationName = 'resolveTemp'
        and thisModule.isModuleReceiver(e.source)
        and e.arguments->size() = 2
        and e.arguments->last().oclIsTypeOf(ATL!StringExp)
    else
        false
    endif;

-- @hot-atl2tm-part 0092
helper def : directResolveTempExpr(
    r : ATL!MatchedRule,
    b : ATL!Binding
) : String =
    let e : ATL!OperationCallExp = b.value
    in
    let sourceExpr : ATL!OclExpression = e.arguments->first()
    in
    let outputName : String = e.arguments->last().stringSymbol
    in
    let sourceTypeName : String = thisModule.sourceExprTypeName(sourceExpr, r)
    in
    if sourceTypeName = ''
       or thisModule.sourceExprIsCollection(sourceExpr, r) then
        '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
    else
        let rules : Sequence(ATL!MatchedRule) =
            ATL!MatchedRule.allInstancesFrom('IN')
                ->select(candidate |
                    candidate.oclIsTypeOf(ATL!MatchedRule)
                    and
                    if candidate.inPattern.elements->size() <> 1 then
                        false
                    else
                        candidate.inPattern.filter.oclIsUndefined()
                        and candidate.inPattern.elements->first().type.name
                            = sourceTypeName
                        and candidate.outPattern.elements
                            ->select(o |
                                o.oclIsTypeOf(ATL!SimpleOutPatternElement)
                                and o.varName = outputName
                            )->size() = 1
                    endif
                )->asSequence()
        in
        if rules->size() <> 1 then
            '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
        else
            let resolver : ATL!MatchedRule = rules->first()
            in
            let input : ATL!SimpleInPatternElement =
                resolver.inPattern.elements->first()
            in
            let output : ATL!SimpleOutPatternElement =
                resolver.outPattern.elements
                    ->select(o |
                        o.oclIsTypeOf(ATL!SimpleOutPatternElement)
                        and o.varName = outputName
                    )->first()
            in
            let features : Sequence(ECORE!EStructuralFeature) =
                thisModule.targetEClassOf(b.outPatternElement)
                    .eAllStructuralFeatures
                    ->select(f | f.name = b.propertyName)->asSequence()
            in
            if features->size() <> 1 then
                '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
            else
                if not features->first().oclIsKindOf(ECORE!EReference)
                   or features->first().upperBound <> 1
                   or features->first().eType.name <> output.type.name then
                    '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
                else
                    '(' + thisModule.ruleExpr(r, sourceExpr) + ')'
                    + '.oclAsType(' + input.type.name + ')'
                    + '.' + resolver.name + '_' + input.varName
                    + '.' + output.varName
                endif
            endif
        endif
    endif;

-- @hot-atl2tm-part 0199
-- The supported collection is either Source!Type.allInstances() or a
-- module attribute whose declared type is Set(Source!Type).
helper def : collectResolveSourceTypeName(
    e : ATL!OclExpression,
    r : ATL!MatchedRule
) : String =
    if e.oclIsTypeOf(ATL!OperationCallExp) then
        if e.operationName = 'allInstances'
           and e.arguments->isEmpty()
           and e.source.oclIsTypeOf(ATL!OclModelElement) then
            e.source.name
        else
            thisModule.sourceCollectionElementTypeName(e, r)
        endif
    else
        if e.oclIsTypeOf(ATL!NavigationOrAttributeCallExp)
           and thisModule.isModuleReceiver(e.source) then
            let helpers : Sequence(ATL!Helper) =
                thisModule.helperAttributeCandidates(e.name)
            in
            if helpers->size() = 1
               and thisModule.helperAttributeIsCollection(helpers->first()) then
                thisModule.helperAttributeElementTypeName(helpers->first())
            else
                thisModule.sourceCollectionElementTypeName(e, r)
            endif
        else
            thisModule.sourceCollectionElementTypeName(e, r)
        endif
    endif;

-- @hot-atl2tm-part 0200
helper def : isCollectResolveTempBinding(b : ATL!Binding) : Boolean =
    if b.outPatternElement.outPattern.rule.oclIsTypeOf(ATL!MatchedRule)
       and b.value.oclIsTypeOf(ATL!IteratorExp) then
        let iterator : ATL!IteratorExp = b.value
        in
        if iterator.name = 'collect'
           and iterator.iterators->size() = 1
           and iterator.body.oclIsTypeOf(ATL!OperationCallExp) then
            let call : ATL!OperationCallExp = iterator.body
            in
            call.operationName = 'resolveTemp'
            and thisModule.isModuleReceiver(call.source)
            and call.arguments->size() = 2
            and call.arguments->first().oclIsTypeOf(ATL!VariableExp)
            and call.arguments->first().referredVariable
                = iterator.iterators->first()
            and call.arguments->last().oclIsTypeOf(ATL!StringExp)
        else
            false
        endif
    else
        false
    endif;

-- @hot-atl2tm-part 0201
-- Read existing matched-rule traces. A filtered rule contributes only if
-- its trace exists; no filter is re-evaluated while resolving the output.
helper def : collectResolveTraceTargets(
    collectionExpr : String,
    resolver : ATL!MatchedRule,
    outputName : String
) : String =
    let input : ATL!SimpleInPatternElement =
        resolver.inPattern.elements->first()
    in
    resolver.name + '.allInstances()->select(z : '
    + resolver.name + ' | (' + collectionExpr + ')->includes(z.'
    + thisModule.matchInputVarName(input) + '))'
    + '->collect(z | z.' + outputName + ')';

-- @hot-atl2tm-part 0202
helper def : collectResolveTempExpr(
    r : ATL!MatchedRule,
    b : ATL!Binding
) : String =
    let iterator : ATL!IteratorExp = b.value
    in
    let call : ATL!OperationCallExp = iterator.body
    in
    let outputName : String = call.arguments->last().stringSymbol
    in
    let sourceTypeName : String =
        thisModule.collectResolveSourceTypeName(iterator.source, r)
    in
    let features : Sequence(ECORE!EStructuralFeature) =
        thisModule.targetEClassOf(b.outPatternElement)
            .eAllStructuralFeatures
            ->select(f | f.name = b.propertyName)->asSequence()
    in
    if sourceTypeName = '' or features->size() <> 1 then
        '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
    else
        let feature : ECORE!EStructuralFeature = features->first()
        in
        if not feature.oclIsKindOf(ECORE!EReference)
           or feature.upperBound = 1 then
            '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
        else
            let resolvers : Sequence(ATL!MatchedRule) =
                ATL!MatchedRule.allInstancesFrom('IN')
                    ->select(candidate |
                        candidate.oclIsTypeOf(ATL!MatchedRule)
                        and candidate.inPattern.elements->size() = 1
                        and thisModule.sourceTypesCompatible(
                            sourceTypeName,
                            candidate.inPattern.elements->first().type.name
                        )
                        and candidate.outPattern.elements
                            ->exists(o |
                                o.oclIsTypeOf(ATL!SimpleOutPatternElement)
                                and o.varName = outputName
                                and o.type.name = feature.eType.name
                            )
                    )->asSequence()
            in
            if resolvers->isEmpty() then
                '__ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__'
            else
                let collectionExpr : String =
                    thisModule.ruleExpr(r, iterator.source)
                in
                '(' + resolvers->iterate(
                    resolver;
                    acc : String = '' |
                    let part : String =
                        thisModule.collectResolveTraceTargets(
                            collectionExpr, resolver, outputName
                        )
                    in
                    if acc = '' then part
                    else acc + '->union(' + part + ')'
                    endif
                ) + ')->asSet()'
            endif
        endif
    endif;
