module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    if self.hasAttr(name) then
        (self.getAttrVal(name) = 'true')
    else
        false
    endif;

helper context XML!Element def: getAttrVal(name : String) : String =
    self.children->select(c | c.oclIsTypeOf(XML!Attribute))->select(c | (c.name = name))->first().value;

helper context XML!Element def: get(name : String) : XML!Element =
    self.children->select(c | c.oclIsTypeOf(XML!Element))->select(c | (c.name = name))->first();

helper context XML!Element def: getType(name : String) : DSL!Type =
    thisModule.findType(self.getAttrVal(name));

helper context XML!Element def: getEnumId(name : String) : String =
    self.getAttrVal(name);

helper context XML!Element def: getText() : String =
    self.children->select(c | c.oclIsTypeOf(XML!Text))->first().value;

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    self.children->select(c | c.oclIsTypeOf(XML!Element))->select(c | (c.name = name));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->select(c | c.oclIsTypeOf(XML!Attribute))->select(c | (c.name = name))->notEmpty();

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('IsAbstract');

helper def: dslElementsById(id : String) : XML!Element =
    XML!Element.allInstances()->select(e | e.hasAttr('Identity'))->select(e | (e.getAttrVal('Identity') = id))->first();

helper def: getSubTypes(c : DSL!Classifier) : Set(DSL!Classifier) =
    DSL!Classifier.allInstances()->select(e | (e.superType = c));

helper def: findType(id : String) : DSL!Type =
    DSL!Type.allInstances()->select(t | (t.identity = id))->first();

rule DomainModel {
    from
        s : XML!Element (
            (s.name = 'DomainModel')
        )
    to
        t : DSL!DomainModel (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            namespace <- s.getAttrVal('Namespace'),
            isLoaded <- s.getAttrBool('IsLoaded'),
            classifiers <- s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | ((e.name = 'Class') or (e.name = 'Relationship'))),
            types <- s.getSeq('Enumeration')->asSet()->union(Set{st1, st2, st3, st4})
        ),
        st1 : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'System'
        ),
        st2 : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'System'
        ),
        st3 : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'System'
        ),
        st4 : DSL!SimpleType (
            name <- 'Double',
            identity <- 'Double',
            namespace <- 'System'
        )
}

rule Class {
    from
        s : XML!Element (
            (s.name = 'Class')
        )
    to
        t : DSL!Class (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            namespace <- s.getAttrVal('Namespace'),
            isLoaded <- s.getAttrBool('IsLoaded'),
            isAbstract <- s.getAttrBool('IsAbstract'),
            properties <- s.getSeq('ValueProperty'),
            superType <- if s.hasAttr('SuperClass') then
    thisModule.dslElementsById(s.getAttrVal('SuperClass'))
else
    OclUndefined
endif
        )
}

rule Relationship {
    from
        s : XML!Element (
            (s.name = 'Relationship')
        )
    to
        t : DSL!Relationship (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            namespace <- s.getAttrVal('Namespace'),
            isLoaded <- s.getAttrBool('IsLoaded'),
            isAbstract <- s.getAttrBool('IsAbstract'),
            isEmbedding <- s.getAttrBool('IsEmbedding'),
            roles <- s.getSeq('Role'),
            properties <- s.getSeq('ValueProperty')
        )
}

rule Role {
    from
        s : XML!Element (
            (s.name = 'Role')
        )
    to
        t : DSL!Role (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            min <- s.getAttrVal('Min').toInteger(),
            max <- s.getAttrVal('Max').toInteger(),
            isUnbounded <- s.getAttrBool('IsUnbounded'),
            accepts <- s.getAttrVal('Accepts'),
            isOrdered <- s.getAttrBool('IsOrdered'),
            isNavigableFrom <- s.getAttrBool('IsNavigableFrom'),
            isPropertyGenerator <- s.getAttrBool('IsPropertyGenerator'),
            source <- thisModule.dslElementsById(s.getAttrVal('Source')),
            type <- thisModule.dslElementsById(s.getAttrVal('Type'))
        )
}

rule ValueProperty {
    from
        s : XML!Element (
            (s.name = 'ValueProperty')
        )
    to
        t : DSL!ValueProperty (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            type <- s.getType('Type')
        )
}

rule Enumeration {
    from
        s : XML!Element (
            (s.name = 'Enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            namespace <- s.getAttrVal('Namespace'),
            literals <- s.getSeq('EnumerationLiteral')
        )
}

rule EnumerationLiteral {
    from
        s : XML!Element (
            (s.name = 'EnumerationLiteral')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- s.getAttrVal('Name'),
            identity <- s.getAttrVal('Identity'),
            value <- s.getAttrVal('Value').toInteger()
        )
}

