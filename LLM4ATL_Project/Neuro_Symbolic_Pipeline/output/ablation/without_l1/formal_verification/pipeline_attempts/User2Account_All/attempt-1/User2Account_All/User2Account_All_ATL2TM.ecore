            <details key="constraints" value="bind_User2Account_a_username bind_User2Account_a_email bind_User2Account_a_active bind_User2Account_a_createdDate"/>
                
        </eAnnotations>
            
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                  
            <details key="bind_User2Account_a_username" value="self.a.username = self.u.username"/>
                  
            <details key="bind_User2Account_a_email" value="self.a.email = self.u.email"/>
                  
            <details key="bind_User2Account_a_active" value="self.a.active = ((self.u.status = 'Active') or (self.u.status = 'Enabled'))"/>
                  
            <details key="bind_User2Account_a_createdDate" value="self.a.createdDate = self.u.registrationDate"/>
                
        </eAnnotations>
            
