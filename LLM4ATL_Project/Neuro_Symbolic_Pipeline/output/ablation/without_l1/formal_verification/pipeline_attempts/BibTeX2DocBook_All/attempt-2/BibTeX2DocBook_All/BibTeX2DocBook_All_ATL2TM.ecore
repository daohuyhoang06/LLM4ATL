            <details key="bind_Main_article_title" value="self.article.title = 'BibTeXML to DocBook'"/>
                  
            <details key="bind_Main_article_sections_1" value="self.article.sections_1 = Set { self.se1, self.se2, self.se3, self.se4 }"/>
                  
            <details key="bind_Main_se1_title" value="self.se1.title = 'References List'"/>
                  
            <details key="bind_Main_se1_paras" value="self.se1.paras = self.bib.entries-&gt;sortedBy(e | e.id)"/>
                  
            <details key="bind_Main_se2_title" value="self.se2.title = 'Authors List'"/>
                  
            <details key="bind_Main_se2_paras" value="self.se2.paras = Author__trace.allInstances()-&gt;select(e | (Author__trace.allInstances()-&gt;select(f | (f.author = e.author))-&gt;first() = e))-&gt;sortedBy(e | e.author)"/>
                  
            <details key="bind_Main_se3_title" value="self.se3.title = 'Titles List'"/>
                  
            <details key="bind_Main_se3_paras" value="self.se3.paras = TitledEntry.allInstances()-&gt;select(e | (TitledEntry.allInstances()-&gt;select(f | (f.title = e.title))-&gt;first() = e))-&gt;sortedBy(e | e.title)-&gt;collect(e | __ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__)"/>
                  
            <details key="bind_Main_se4_title" value="self.se4.title = 'Journals List'"/>
                  
            <details key="bind_Main_se4_paras" value="self.se4.paras = Article__source.allInstances()-&gt;select(e | (Article__source.allInstances()-&gt;select(f | (f.journal = e.journal))-&gt;first() = e))-&gt;sortedBy(e | e.journal)-&gt;collect(e | __ATL2TM_UNSUPPORTED_FEATURE__RESOLVE_TEMP__)"/>
                  
            <details key="null_Main_se1_sections_2" value="self.se1.sections_2-&gt;isEmpty()"/>
                  
            <details key="null_Main_se2_sections_2" value="self.se2.sections_2-&gt;isEmpty()"/>
                  
            <details key="null_Main_se3_sections_2" value="self.se3.sections_2-&gt;isEmpty()"/>
                  
            <details key="null_Main_se4_sections_2" value="self.se4.sections_2-&gt;isEmpty()"/>
                
        </eAnnotations>
            
