module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : CPL!Element =
    if self.oclIsKindOf(CPL!NodeContainer) then
        if self.contents.oclIsUndefined() then
        self
    else
        self.contents.statement
    endif
    else
        self
    endif;

helper context CPL!Element def: locations : Set(CPL!Location) =
    if self.oclIsKindOf(CPL!Location) then
        if self.contents.oclIsUndefined() then
        Set{self}
    else
        Set{self}->union(self.contents.locations)
    endif
    else
        if self.oclIsKindOf(CPL!NodeContainer) then
        if self.contents.oclIsUndefined() then
        Set{}
    else
        self.contents.locations
    endif
    else
        Set{}
    endif
    endif;

helper context CPL!Proxy def: isSimple : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        c : CPL!CPL
    to
        p : SPL!Program (
            service <- s
        ),
        s : SPL!Service (
            name <- 'unnamed',
            declarations <- c.subActions,
            sessions <- c.incoming
        )
}

rule SubAction2Function {
    from
        s : CPL!SubAction
    to
        f : SPL!LocalFunctionDeclaration (
            name <- s.id,
            returnType <- t,
            statements <- s.statement
        ),
        t : SPL!SimpleType (
            type <- #void
        )
}

rule Incoming2Method {
    from
        i : CPL!Incoming
    to
        m : SPL!Method (
            type <- t,
            direction <- #"in",
            methodName <- mn,
            statements <- i.statement
        ),
        t : SPL!SimpleType (
            type <- #void
        ),
        mn : SPL!SIPMethodName (
            name <- #INVITE
        )
}

rule Proxy2Return {
    from
        p : CPL!Proxy (
            p.isSimple
        )
    to
        r : SPL!ReturnStat (
            returnedValue <- f
        ),
        f : SPL!ForwardExp (
            isParallel <- (p.ordering = 'parallel'),
            exp <- ce
        ),
        ce : SPL!ConstantExp (
            value <- thisModule.Location2URIConstant(p.locations->first())
        )
}

rule Proxy2Select {
    from
        p : CPL!Proxy (
            not p.isSimple
        )
    to
        s : SPL!SelectStat (
            matchedExp <- re,
            selectCases <- Set{p.busy, p.noAnswer, p.redirection, p.failure}->select(c | not c.oclIsUndefined()),
            selectDefault <- p.default
        ),
        re : SPL!ReasonExp (
        )
}

rule Busy2SelectCase {
    from
        b : CPL!Busy
    to
        sc : SPL!SelectCase (
            values <- c,
            statements <- b.statement
        ),
        c : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #BUSY_HERE
        )
}

rule NoAnswer2SelectCase {
    from
        n : CPL!NoAnswer
    to
        sc : SPL!SelectCase (
            values <- c,
            statements <- n.statement
        ),
        c : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #REQUEST_TIMEOUT
        )
}

rule Redirection2SelectCase {
    from
        rd : CPL!Redirection
    to
        sc : SPL!SelectCase (
            values <- c,
            statements <- rd.statement
        ),
        c : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!RedirectionErrorResponse (
            errorKind <- #MULTIPLE_CHOICES
        )
}

rule Default2SelectDefault {
    from
        d : CPL!Default
    to
        sd : SPL!SelectDefault (
            statements <- d.statement
        )
}

rule SubCall2Return {
    from
        sc : CPL!SubCall
    to
        r : SPL!ReturnStat (
            returnedValue <- fc
        ),
        fc : SPL!FunctionCallExp (
            functionCall <- call
        ),
        call : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->select(a | (a.id = sc.ref))->first()
        )
}

rule Redirect2Return {
    from
        r : CPL!Redirect
    to
        ret : SPL!ReturnStat (
            returnedValue <- f
        ),
        f : SPL!ForwardExp (
            isParallel <- false,
            exp <- ce
        ),
        ce : SPL!ConstantExp (
            value <- thisModule.Location2URIConstant(r.locations->first())
        )
}

rule AddressSwitch2SelectStat {
    from
        a : CPL!AddressSwitch
    to
        s : SPL!SelectStat (
            matchedExp <- v,
            selectCases <- a.addresses,
            selectDefault <- a.otherwise
        ),
        v : SPL!Variable (
            source <- vd
        ),
        vd : SPL!VariableDeclaration (
            name <- a.field
        )
}

rule SwitchedAddress2SelectCase {
    from
        sa : CPL!SwitchedAddress
    to
        sc : SPL!SelectCase (
            values <- c,
            statements <- sa.statement
        ),
        c : SPL!StringConstant (
            value <- if not sa.is.oclIsUndefined() then
    sa.is
else
    if not sa.contains.oclIsUndefined() then
    sa.contains
else
    sa.subDomainOf
endif
endif
        )
}

rule Otherwise2SelectDefault {
    from
        o : CPL!Otherwise
    to
        sd : SPL!SelectDefault (
            statements <- o.statement
        )
}

lazy rule Location2URIConstant {
    from
        l : CPL!Location
    to
        u : SPL!URIConstant (
            uri <- l.url
        )
}

