module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrBool(attr : String) : Boolean =
    (self.getAttrVal(attr) = 'true');

helper context XML!Element def: getAttrVal(attr : String) : String =
    self.children->select(c | (c.oclIsKindOf(XML!Attribute) and (c.name = attr)))->first().value;

helper context XML!Element def: get(name : String) : XML!Element =
    self.children->select(c | (c.oclIsKindOf(XML!Element) and (c.name = name)))->first();

helper context XML!Element def: getType() : DSL!Type =
    thisModule.findType(self.getAttrVal('type'));

helper context XML!Element def: getEnumId() : String =
    self.getAttrVal('identity');

helper context XML!Element def: getText() : String =
    self.children->select(c | c.oclIsKindOf(XML!Text))->first().value;

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    self.children->select(c | (c.oclIsKindOf(XML!Element) and (c.name = name)));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(attr : String) : Boolean =
    not self.getAttrVal(attr).oclIsUndefined();

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById : Set(XML!Element) =
    XML!Element.allInstances()->select(e | e.hasAttr('identity'));

helper def: getSubTypes(elem : XML!Element) : Set(XML!Element) =
    XML!Element.allInstances()->select(e | (e.getAttrVal('superType') = elem.getAttrVal('identity')));

helper def: findType(name : String) : DSL!Type =
    DSL!Type.allInstances()->select(t | (t.name = name))->first();

rule DomainModel {
    from
        e : XML!Element (
            (e.name = 'DomainModel')
        )
    to
        dm : DSL!DomainModel (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            isLoaded <- e.getAttrBool('isLoaded'),
            classifiers <- e.getSeq('Class')->union(e.getSeq('Relationship')),
            types <- Set{stString, stInt, stBool, stReal}->union(e.getSeq('Enumeration'))
        ),
        stString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- e.getAttrVal('namespace')
        ),
        stInt : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- e.getAttrVal('namespace')
        ),
        stBool : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- e.getAttrVal('namespace')
        ),
        stReal : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- e.getAttrVal('namespace')
        )
}

rule Class {
    from
        e : XML!Element (
            (e.name = 'Class')
        )
    to
        c : DSL!Class (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            isLoaded <- e.getAttrBool('isLoaded'),
            isAbstract <- e.isAbstract(),
            properties <- e.getSeq('properties'),
            superType <- thisModule.dslElementsById->select(x | (x.getAttrVal('identity') = e.getAttrVal('superType')))->first()
        )
}

rule Relationship {
    from
        e : XML!Element (
            (e.name = 'Relationship')
        )
    to
        r : DSL!Relationship (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            isLoaded <- e.getAttrBool('isLoaded'),
            isAbstract <- e.isAbstract(),
            isEmbedding <- e.getAttrBool('isEmbedding'),
            properties <- e.getSeq('properties'),
            roles <- e.getSeq('roles')
        )
}

rule Role {
    from
        e : XML!Element (
            (e.name = 'Role')
        )
    to
        r : DSL!Role (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            min <- e.getAttrVal('min').toInteger(),
            max <- e.getAttrVal('max').toInteger(),
            isUnbounded <- e.getAttrBool('isUnbounded'),
            accepts <- e.getAttrVal('accepts'),
            isOrdered <- e.getAttrBool('isOrdered'),
            isNavigableFrom <- e.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- e.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById->select(x | (x.getAttrVal('identity') = e.getAttrVal('source')))->first(),
            type <- thisModule.dslElementsById->select(x | (x.getAttrVal('identity') = e.getAttrVal('type')))->first()
        )
}

rule ValueProperty {
    from
        e : XML!Element (
            (e.name = 'ValueProperty')
        )
    to
        p : DSL!ValueProperty (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            type <- e.getType()
        )
}

rule Enumeration {
    from
        e : XML!Element (
            (e.name = 'Enumeration')
        )
    to
        enum : DSL!Enumeration (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            literals <- e.getSeq('literals')
        )
}

rule EnumerationLiteral {
    from
        e : XML!Element (
            (e.name = 'EnumerationLiteral')
        )
    to
        el : DSL!EnumerationLiteral (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            value <- e.getAttrVal('value').toInteger()
        )
}

