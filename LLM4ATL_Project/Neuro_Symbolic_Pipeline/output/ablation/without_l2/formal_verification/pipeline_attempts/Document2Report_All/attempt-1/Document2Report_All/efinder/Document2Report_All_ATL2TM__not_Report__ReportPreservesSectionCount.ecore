            <details key="constraints" value="create_Report SourceDocumentInputIsValid __efinder_NOT_ReportPreservesSectionCount"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="create_Report" value="(if self.Document2Report_rep.oclIsUndefined() then 0 else 1 endif) = 1"/>
                            
        
            <details key="SourceDocumentInputIsValid" value="DocumentModel.allInstances()-&gt;exists(dm |&#13;&#10;    dm.documents-&gt;notEmpty() and&#13;&#10;    dm.documents-&gt;forAll(d |&#13;&#10;      d.title &lt;&gt; '' and d.author &lt;&gt; '' and d.sections-&gt;notEmpty() and&#13;&#10;      d.sections-&gt;forAll(s | s.title &lt;&gt; '' and s.content &lt;&gt; '' and s.order &gt; 0)&#13;&#10;    )&#13;&#10;  )"/>
            <details key="__efinder_NOT_ReportPreservesSectionCount" value="Document2Report.allInstances()-&gt;exists(r | not (Document.allInstances()-&gt;exists(d |&#10;    r.rep.title = d.title and r.rep.sections-&gt;size() = d.sections-&gt;size()&#10;  )))"/>
        </eAnnotations>
                    
        
