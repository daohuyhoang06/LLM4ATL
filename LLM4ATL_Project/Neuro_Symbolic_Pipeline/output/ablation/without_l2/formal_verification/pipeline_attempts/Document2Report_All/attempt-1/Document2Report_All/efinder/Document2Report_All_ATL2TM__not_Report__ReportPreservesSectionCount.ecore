        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="match_Document2Report" value="Document.allInstances()-&gt;forAll(doc : Document | Document2Report.allInstances()-&gt;one(z : Document2Report | z.doc = doc))"/>
                            
        
            <details key="SourceDocumentHasSections" value="self.title &lt;&gt; '' and self.author &lt;&gt; '' and self.sections-&gt;notEmpty()"/>
