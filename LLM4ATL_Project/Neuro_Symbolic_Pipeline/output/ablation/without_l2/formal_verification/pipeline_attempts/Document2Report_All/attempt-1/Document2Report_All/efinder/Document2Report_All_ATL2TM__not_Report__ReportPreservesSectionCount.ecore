            <details key="origin" value="trace"/>
                              
            
            <details key="atlRule" value="Document2Report"/>
                              
            
            <details key="semConstraints" value="bind_Document2Report_rep_title bind_Document2Report_rep_author bind_Document2Report_rep_sections bind_Document2Report_rep_sections_size"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
                              
            
            <details key="constraints" value="bind_Document2Report_rep_title bind_Document2Report_rep_author bind_Document2Report_rep_sections bind_Document2Report_rep_sections_size"/>
                            
        
        </eAnnotations>
                    
        
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
                              
            
            <details key="bind_Document2Report_rep_title" value="self.rep.title = self.doc.title"/>
                              
            
            <details key="bind_Document2Report_rep_author" value="self.rep.author = self.doc.author"/>
                              
            
            <details key="bind_Document2Report_rep_sections" value="self.rep.sections = Set { self.doc.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.sec = x.oclAsType(Section__source))-&gt;collect(z | z.outSec) else Sequence {} endif))-&gt;flatten() }-&gt;flatten()"/>
                              
            
            <details key="bind_Document2Report_rep_sections_size" value="(self.doc.sections)-&gt;size() = (Set { self.doc.sections-&gt;collect(x | (if x.oclIsKindOf(Section__source) then Section2Section.allInstances()-&gt;select(z : Section2Section | z.sec = x.oclAsType(Section__source))-&gt;collect(z | z.outSec) else Sequence {} endif))-&gt;flatten() }-&gt;flatten())-&gt;size()"/>
                            
        
        </eAnnotations>
                    
        
