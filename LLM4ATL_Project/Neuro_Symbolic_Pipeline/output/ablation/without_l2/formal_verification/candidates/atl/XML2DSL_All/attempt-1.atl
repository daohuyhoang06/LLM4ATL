module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
    let
        attr : XML!Attribute = self.children->select(c | c.oclIsKindOf(XML!Attribute))->any(c | (c.name = name))
    in
        if attr.oclIsUndefined() then
        ''
    else
        attr.value
    endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    (self.getAttrVal(name) = 'true');

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->select(c | c.oclIsKindOf(XML!Attribute))->exists(c | (c.name = name));

helper context XML!Element def: get(name : String) : XML!Element =
    self.children->select(c | c.oclIsKindOf(XML!Element))->any(c | (c.name = name));

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    self.children->select(c | c.oclIsKindOf(XML!Element))->select(c | (c.name = name))->asSet();

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.children->select(c | c.oclIsKindOf(XML!Element))->exists(c | (c.name = name));

helper context XML!Element def: getText() : String =
    let
        textNode : XML!Text = self.children->select(c | c.oclIsKindOf(XML!Text))->any(c | true)
    in
        if textNode.oclIsUndefined() then
        ''
    else
        textNode.value
    endif;

helper context XML!Element def: getType() : DSL!Type =
    thisModule.findType(self.getAttrVal('type'));

helper context XML!Element def: getEnumId() : String =
    self.getAttrVal('identity');

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById : Set(XML!Element) =
    XML!Element.allInstances()->select(e | e.hasAttr('identity'));

helper def: getSubTypes(c : XML!Element) : Set(XML!Element) =
    XML!Element.allInstances()->select(e | ((e.name = 'Class') or (e.name = 'Relationship')))->select(e | (e.hasAttr('superType') and (e.getAttrVal('superType') = c.getAttrVal('identity'))));

helper def: findType(name : String) : DSL!Type =
    DSL!Type.allInstances()->any(t | (t.name = name));

rule DomainModel {
    from
        s : XML!Element (
            (s.name = 'DomainModel')
        )
    to
        t : DSL!DomainModel (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            classifiers <- s.getSeq('Class')->union(s.getSeq('Relationship')),
            types <- s.getSeq('Enumeration')->union(Set{stString, stBoolean, stInteger, stReal})
        ),
        stString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        stBoolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        stInteger : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        stReal : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        s : XML!Element (
            (s.name = 'Class')
        )
    to
        t : DSL!Class (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.isAbstract(),
            properties <- s.getSeq('ValueProperty'),
            superType <- s.get('superType')
        )
}

rule Relationship {
    from
        s : XML!Element (
            (s.name = 'Relationship')
        )
    to
        t : DSL!Relationship (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.isAbstract(),
            isEmbedding <- s.getAttrBool('isEmbedding'),
            roles <- s.getSeq('Role'),
            properties <- s.getSeq('ValueProperty'),
            superType <- s.get('superType')
        )
}

rule Role {
    from
        s : XML!Element (
            (s.name = 'Role')
        )
    to
        t : DSL!Role (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            min <- s.getAttrVal('min').toInteger(),
            max <- s.getAttrVal('max').toInteger(),
            isUnbounded <- s.getAttrBool('isUnbounded'),
            accepts <- s.getAttrVal('accepts'),
            isOrdered <- s.getAttrBool('isOrdered'),
            isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
            source <- s.get('source'),
            type <- s.get('type')
        )
}

rule ValueProperty {
    from
        s : XML!Element (
            (s.name = 'ValueProperty')
        )
    to
        t : DSL!ValueProperty (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            type <- s.getType()
        )
}

rule Enumeration {
    from
        s : XML!Element (
            (s.name = 'Enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            literals <- s.getSeq('EnumerationLiteral')
        )
}

rule EnumerationLiteral {
    from
        s : XML!Element (
            (s.name = 'EnumerationLiteral')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            value <- s.getAttrVal('value').toInteger()
        )
}

