module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : SPL!Statement =
    if self.oclIsKindOf(CPL!NodeContainer) then
        if self.contents.oclIsUndefined() then
        OclUndefined
    else
        self.contents.statement
    endif
    else
        self
    endif;

helper context CPL!Element def: locations : Set(CPL!Location) =
    if self.oclIsKindOf(CPL!Location) then
        Set{self}->union(if self.contents.oclIsUndefined() then
        Set{}
    else
        self.contents.locations
    endif)
    else
        if self.oclIsKindOf(CPL!NodeContainer) then
        if self.contents.oclIsUndefined() then
        Set{}
    else
        self.contents.locations
    endif
    else
        Set{}
    endif
    endif;

helper context CPL!Proxy def: isSimple : Boolean =
    (((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        c : CPL!CPL
    to
        p : SPL!Program (
            service <- s
        ),
        s : SPL!Service (
            name <- 'CPL',
            declarations <- c.subActions,
            sessions <- c.incoming
        )
}

rule SubAction2Function {
    from
        s : CPL!SubAction
    to
        f : SPL!LocalFunctionDeclaration (
            name <- s.id,
            returnType <- v,
            statements <- s.statement
        ),
        v : SPL!SimpleType (
            type <- #void
        )
}

rule Incoming2Method {
    from
        i : CPL!Incoming
    to
        m : SPL!Method (
            type <- t,
            direction <- #"in",
            methodName <- n,
            statements <- i.statement
        ),
        t : SPL!SimpleType (
            type <- #void
        ),
        n : SPL!SIPMethodName (
            name <- #INVITE
        )
}

rule Proxy2Return {
    from
        p : CPL!Proxy (
            p.isSimple
        )
    to
        ret : SPL!ReturnStat (
            returnedValue <- fw
        ),
        fw : SPL!ForwardExp (
            isParallel <- (p.ordering = 'parallel'),
            exp <- seq
        ),
        seq : SPL!SequenceConstant (
            values <- p.locations->collect(l | thisModule.Location2URIConstant(l))
        )
}

rule Proxy2Select {
    from
        p : CPL!Proxy (
            not p.isSimple
        )
    to
        sel : SPL!SelectStat (
            matchedExp <- fw,
            selectCases <- Set{p.busy, p.noAnswer, p.redirection}->reject(e | e.oclIsUndefined()),
            selectDefault <- p.default
        ),
        fw : SPL!ForwardExp (
            isParallel <- (p.ordering = 'parallel'),
            exp <- seq
        ),
        seq : SPL!SequenceConstant (
            values <- p.locations->collect(l | thisModule.Location2URIConstant(l))
        )
}

rule Busy2SelectCase {
    from
        b : CPL!Busy
    to
        c : SPL!SelectCase (
            values <- v,
            statements <- b.statement
        ),
        v : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #BUSY_HERE
        )
}

rule NoAnswer2SelectCase {
    from
        n : CPL!NoAnswer
    to
        c : SPL!SelectCase (
            values <- v,
            statements <- n.statement
        ),
        v : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #REQUEST_TIMEOUT
        )
}

rule Redirection2SelectCase {
    from
        r : CPL!Redirection
    to
        c : SPL!SelectCase (
            values <- v,
            statements <- r.statement
        ),
        v : SPL!ResponseConstant (
            response <- re
        ),
        re : SPL!RedirectionErrorResponse (
            errorKind <- #MULTIPLE_CHOICES
        )
}

rule Default2SelectDefault {
    from
        d : CPL!Default
    to
        c : SPL!SelectDefault (
            statements <- d.statement
        )
}

rule SubCall2Return {
    from
        s : CPL!SubCall
    to
        r : SPL!ReturnStat (
            returnedValue <- f
        ),
        f : SPL!FunctionCallExp (
            functionCall <- c
        ),
        c : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->select(sa | (sa.id = s.ref)).first()
        )
}

rule Redirect2Return {
    from
        r : CPL!Redirect
    to
        ret : SPL!ReturnStat (
            returnedValue <- with
        ),
        with : SPL!WithExp (
            exp <- seq
        ),
        seq : SPL!SequenceConstant (
            values <- r.locations->collect(l | thisModule.Location2URIConstant(l))
        )
}

rule AddressSwitch2SelectStat {
    from
        a : CPL!AddressSwitch
    to
        s : SPL!SelectStat (
            matchedExp <- p,
            selectCases <- a.addresses,
            selectDefault <- a.otherwise
        ),
        p : SPL!SIPHeaderPlace (
            header <- if (a.field = 'origin') then
    #FROM
else
    #TO
endif
        )
}

rule SwitchedAddress2SelectCase {
    from
        a : CPL!SwitchedAddress
    to
        c : SPL!SelectCase (
            values <- v,
            statements <- a.statement
        ),
        v : SPL!StringConstant (
            value <- if a.is.oclIsUndefined() then
    a.contains
else
    a.is
endif
        )
}

rule Otherwise2SelectDefault {
    from
        o : CPL!Otherwise
    to
        s : SPL!SelectDefault (
            statements <- o.statement
        )
}

lazy rule Location2URIConstant {
    from
        l : CPL!Location
    to
        u : SPL!URIConstant (
            uri <- l.url
        )
}

