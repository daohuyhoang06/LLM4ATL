module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Node def: statement() : CPL!Node =
    if self.oclIsKindOf(CPL!Location) then
        if self.contents.oclIsUndefined() then
        OclUndefined
    else
        self.contents.statement()
    endif
    else
        self
    endif;

helper context CPL!Node def: locations() : Set(CPL!Location) =
    if self.oclIsKindOf(CPL!Location) then
        if self.contents.oclIsUndefined() then
        Set{self}
    else
        self.contents.locations()->including(self)
    endif
    else
        Set{}
    endif;

helper context CPL!Proxy def: isSimple() : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        c : CPL!CPL
    to
        p : SPL!Program (
            service <- s
        ),
        s : SPL!Service (
            name <- 'unnamed',
            declarations <- c.subActions,
            sessions <- c.incoming
        )
}

rule SubAction2Function {
    from
        s : CPL!SubAction
    to
        f : SPL!LocalFunctionDeclaration (
            name <- s.id,
            returnType <- rt,
            statements <- if s.contents.oclIsUndefined() then
    Set{}
else
    s.contents.statement()
endif
        ),
        rt : SPL!SimpleType (
            type <- #void
        )
}

rule Incoming2Method {
    from
        i : CPL!Incoming
    to
        m : SPL!Method (
            type <- t,
            direction <- #"in",
            methodName <- mn,
            statements <- if i.contents.oclIsUndefined() then
    Set{}
else
    i.contents.statement()
endif
        ),
        t : SPL!SimpleType (
            type <- #void
        ),
        mn : SPL!SIPMethodName (
            name <- #INVITE
        )
}

rule Proxy2Return {
    from
        p : CPL!Proxy (
            p.isSimple()
        )
    to
        r : SPL!ReturnStat (
            returnedValue <- e
        ),
        e : SPL!ForwardExp (
            isParallel <- false,
            exp <- if p.locations()->isEmpty() then
    OclUndefined
else
    thisModule.Location2URIConstant(p.locations()->any(l | true))
endif
        )
}

rule Proxy2Select {
    from
        p : CPL!Proxy (
            not p.isSimple()
        )
    to
        s : SPL!SelectStat (
            matchedExp <- e,
            selectCases <- Set{p.busy, p.noAnswer, p.redirection, p.failure}->reject(c | c.oclIsUndefined()),
            selectDefault <- p.default
        ),
        e : SPL!ReasonExp (
        )
}

rule Busy2SelectCase {
    from
        b : CPL!Busy
    to
        c : SPL!SelectCase (
            values <- Set{v},
            statements <- if b.contents.oclIsUndefined() then
    Set{}
else
    b.contents.statement()
endif
        ),
        v : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #BUSY_HERE
        )
}

rule NoAnswer2SelectCase {
    from
        n : CPL!NoAnswer
    to
        c : SPL!SelectCase (
            values <- Set{v},
            statements <- if n.contents.oclIsUndefined() then
    Set{}
else
    n.contents.statement()
endif
        ),
        v : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!ClientErrorResponse (
            errorKind <- #REQUEST_TIMEOUT
        )
}

rule Redirection2SelectCase {
    from
        rd : CPL!Redirection
    to
        c : SPL!SelectCase (
            values <- Set{v},
            statements <- if rd.contents.oclIsUndefined() then
    Set{}
else
    rd.contents.statement()
endif
        ),
        v : SPL!ResponseConstant (
            response <- r
        ),
        r : SPL!RedirectionErrorResponse (
            errorKind <- #MULTIPLE_CHOICES
        )
}

rule Default2SelectDefault {
    from
        d : CPL!Default
    to
        cd : SPL!SelectDefault (
            statements <- if d.contents.oclIsUndefined() then
    Set{}
else
    d.contents.statement()
endif
        )
}

rule SubCall2Return {
    from
        sc : CPL!SubCall
    to
        r : SPL!ReturnStat (
            returnedValue <- e
        ),
        e : SPL!FunctionCallExp (
            functionCall <- fc
        ),
        fc : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->select(sa | (sa.id = sc.ref))->any(sa | true)
        )
}

rule Redirect2Return {
    from
        r : CPL!Redirect
    to
        ret : SPL!ReturnStat (
            returnedValue <- e
        ),
        e : SPL!WithExp (
            exp <- re,
            msgFields <- Set{mf}
        ),
        re : SPL!ReasonExp (
        ),
        mf : SPL!HeadedMessageField (
            headerId <- 'Contact',
            exp <- p
        ),
        p : SPL!PropertyCallPlace (
            propName <- 'Contact'
        )
}

rule AddressSwitch2SelectStat {
    from
        a : CPL!AddressSwitch
    to
        s : SPL!SelectStat (
            matchedExp <- e,
            selectCases <- a.addresses,
            selectDefault <- a.otherwise
        ),
        e : SPL!SIPHeaderPlace (
            header <- #FROM
        )
}

rule SwitchedAddress2SelectCase {
    from
        sa : CPL!SwitchedAddress
    to
        c : SPL!SelectCase (
            values <- Set{v},
            statements <- if sa.contents.oclIsUndefined() then
    Set{}
else
    sa.contents.statement()
endif
        ),
        v : SPL!StringConstant (
            value <- if sa.is.oclIsUndefined() then
    if sa.contains.oclIsUndefined() then
    sa.subDomainOf
else
    sa.contains
endif
else
    sa.is
endif
        )
}

rule Otherwise2SelectDefault {
    from
        o : CPL!Otherwise
    to
        cd : SPL!SelectDefault (
            statements <- if o.contents.oclIsUndefined() then
    Set{}
else
    o.contents.statement()
endif
        )
}

lazy rule Location2URIConstant {
    from
        l : CPL!Location
    to
        u : SPL!ConstantExp (
            value <- uri
        ),
        uri : SPL!URIConstant (
            uri <- l.url
        )
}

