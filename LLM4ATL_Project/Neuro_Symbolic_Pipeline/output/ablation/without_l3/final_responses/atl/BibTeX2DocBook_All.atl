module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
    BibTeX!Author.allInstances()->select(e | (BibTeX!Author.allInstances()->select(f | (f.author = e.author)).first() = e))->sortedBy(e | e.author);

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
    BibTeX!TitledEntry.allInstances()->select(e | (BibTeX!TitledEntry.allInstances()->select(f | (f.title = e.title)).first() = e))->sortedBy(e | e.title);

helper def: articleSet : Set(BibTeX!Article) =
    BibTeX!Article.allInstances()->select(e | (BibTeX!Article.allInstances()->select(f | (f.journal = e.journal)).first() = e))->sortedBy(e | e.journal);

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    self.id;

rule Main {
    from
        e : BibTeX!BibTeXFile
    to
        out : DocBook!DocBook (
            books <- Set{bk}
        ),
        bk : DocBook!Book (
            articles <- Set{article}
        ),
        article : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Set{se1, se2, se3, se4}
        ),
        se1 : DocBook!Sect1 (
            title <- 'References List',
            paras <- BibTeX!BibTeXEntry.allInstances()->sortedBy(e | e.id)
        ),
        se2 : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- thisModule.authorSet
        ),
        se3 : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- thisModule.titledEntrySet->collect(e | thisModule.resolveTemp(e, 'myP'))
        ),
        se4 : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- thisModule.articleSet->collect(e | thisModule.resolveTemp(e, 'myP2'))
        )
}

rule Author {
    from
        e : BibTeX!Author (
            thisModule.authorSet->includes(e)
        )
    to
        p : DocBook!Para (
            content <- e.author
        )
}

rule UntitledEntry {
    from
        e : BibTeX!BibTeXEntry (
            not e.oclIsKindOf(BibTeX!TitledEntry)
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        myP : DocBook!Para (
            content <- e.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule Article_Title_Journal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        myP : DocBook!Para (
            content <- e.title
        ),
        myP2 : DocBook!Para (
            content <- e.journal
        )
}

rule Article_NoTitle_Journal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        myP2 : DocBook!Para (
            content <- e.journal
        )
}

rule Article_Title_NoJournal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        myP : DocBook!Para (
            content <- e.title
        )
}

rule Article_NoTitle_NoJournal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

