module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    (self.getAttrVal(name) = 'true');

helper context XML!Element def: getAttrVal(name : String) : String =
    self.children->any(c | (c.oclIsKindOf(XML!Attribute) and (c.name = name))).value;

helper context XML!Element def: get(name : String) : XML!Element =
    self.children->any(c | (c.oclIsKindOf(XML!Element) and (c.name = name)));

helper context XML!Element def: getType() : String =
    self.getAttrVal('type');

helper context XML!Element def: getEnumId() : String =
    self.getAttrVal('enum');

helper context XML!Element def: getText() : String =
    self.children->any(c | c.oclIsKindOf(XML!Text)).value;

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    self.children->select(c | (c.oclIsKindOf(XML!Element) and (c.name = name)));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->exists(c | (c.oclIsKindOf(XML!Attribute) and (c.name = name)));

helper context XML!Element def: isAbstract() : Boolean =
    if self.hasAttr('isAbstract') then
        self.getAttrBool('isAbstract')
    else
        false
    endif;

helper def: dslElementsById : Set(XML!Element) =
    XML!Element.allInstances()->select(e | e.hasAttr('identity'));

helper def: getSubTypes(e : XML!Element) : Set(XML!Element) =
    XML!Element.allInstances()->select(c | (((c.name = 'Class') or (c.name = 'Relationship')) and (c.hasAttr('superType') and (c.getAttrVal('superType') = e.getAttrVal('identity')))));

helper def: findType(id : String) : DSL!Type =
    DSL!Type.allInstances()->any(t | ((t.identity = id) or (t.name = id)));

rule DomainModel {
    from
        e : XML!Element (
            (e.name = 'DomainModel')
        )
    to
        out : DSL!DomainModel (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            isLoaded <- e.getAttrBool('isLoaded'),
            classifiers <- e.children->select(c | ((c.name = 'Class') or (c.name = 'Relationship'))),
            types <- Set{stString, stInteger, stBoolean, stReal}->union(e.children->select(c | (c.name = 'Enumeration')))
        ),
        stString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        stInteger : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        stBoolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        stReal : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        e : XML!Element (
            (e.name = 'Class')
        )
    to
        out : DSL!Class (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            isLoaded <- e.getAttrBool('isLoaded'),
            isAbstract <- e.isAbstract(),
            properties <- e.children->select(c | (c.name = 'ValueProperty')),
            superType <- if e.hasAttr('superType') then
    XML!Element.allInstances()->any(c | (c.getAttrVal('identity') = e.getAttrVal('superType')))
else
    OclUndefined
endif
        )
}

rule Relationship {
    from
        e : XML!Element (
            (e.name = 'Relationship')
        )
    to
        out : DSL!Relationship (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            isLoaded <- e.getAttrBool('isLoaded'),
            isAbstract <- e.isAbstract(),
            isEmbedding <- e.getAttrBool('isEmbedding'),
            roles <- e.children->select(c | (c.name = 'Role')),
            properties <- e.children->select(c | (c.name = 'ValueProperty')),
            superType <- if e.hasAttr('superType') then
    XML!Element.allInstances()->any(c | (c.getAttrVal('identity') = e.getAttrVal('superType')))
else
    OclUndefined
endif
        )
}

rule Role {
    from
        e : XML!Element (
            (e.name = 'Role')
        )
    to
        out : DSL!Role (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            min <- e.getAttrVal('min').toInteger(),
            max <- e.getAttrVal('max').toInteger(),
            isUnbounded <- e.getAttrBool('isUnbounded'),
            accepts <- e.getAttrVal('accepts'),
            isOrdered <- e.getAttrBool('isOrdered'),
            isNavigableFrom <- e.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- e.getAttrBool('isPropertyGenerator'),
            source <- XML!Element.allInstances()->any(c | (c.getAttrVal('identity') = e.getAttrVal('source'))),
            type <- XML!Element.allInstances()->any(c | (c.getAttrVal('identity') = e.getAttrVal('type')))
        )
}

rule ValueProperty {
    from
        e : XML!Element (
            (e.name = 'ValueProperty')
        )
    to
        out : DSL!ValueProperty (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            type <- thisModule.findType(e.getAttrVal('type'))
        )
}

rule Enumeration {
    from
        e : XML!Element (
            (e.name = 'Enumeration')
        )
    to
        out : DSL!Enumeration (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            namespace <- e.getAttrVal('namespace'),
            literals <- e.children->select(c | (c.name = 'EnumerationLiteral'))
        )
}

rule EnumerationLiteral {
    from
        e : XML!Element (
            (e.name = 'EnumerationLiteral')
        )
    to
        out : DSL!EnumerationLiteral (
            name <- e.getAttrVal('name'),
            identity <- e.getAttrVal('identity'),
            value <- e.getAttrVal('value').toInteger()
        )
}

