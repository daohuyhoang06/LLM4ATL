-- T4: the Document named 'double' creates two Reports; the other creates none.
module Document2Report_All;

create OUT : Report from IN : Document;

rule DoubleDocument2Reports {
  from
    d : Document!Document (
      d.title = 'double'
    )
  to
    first : Report!Report (
      title <- d.title,
      author <- d.author
    ),
    second : Report!Report (
      title <- d.title,
      author <- d.author
    )
}
