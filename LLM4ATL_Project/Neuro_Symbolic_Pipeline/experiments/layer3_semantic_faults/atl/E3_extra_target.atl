-- Syntactically/type-correct and metamodel-conformant.
-- Semantically wrong: each Document creates two Reports instead of one.
module Document2Report_All;

create OUT : Report from IN : Document;

rule Document2Report {
  from
    d : Document!Document
  to
    report : Report!Report (
      title <- d.title,
      author <- d.author,
      sections <- d.sections
    ),
    duplicate : Report!Report (
      title <- d.title,
      author <- d.author
    )
}

rule Section2Section {
  from
    s : Document!Section
  to
    targetSection : Report!Section (
      title <- s.title,
      content <- s.content,
      order <- s.order
    )
}
