global inv SourcePetriNetInputIsValid:
  PetriNet.allInstances()->notEmpty() and
  PetriNet.allInstances()->forAll(n |
    n.name <> '' and n.elements->notEmpty() and n.arcs->notEmpty() and
    n.elements->exists(e | e.oclIsKindOf(Place)) and
    n.elements->exists(e | e.oclIsKindOf(Transition)) and
    n.elements->forAll(e | e.name <> '' and e.location <> '') and
    n.arcs->forAll(a | a.name <> '' and a.location <> '')
  )

context PetriNet
inv SourcePetriNetHasNamedStructure:
  self.name <> '' and self.elements->notEmpty() and self.arcs->notEmpty()
