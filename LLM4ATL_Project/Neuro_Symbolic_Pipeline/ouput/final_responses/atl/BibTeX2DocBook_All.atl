module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
    BibTeX!Author.allInstances()->select(e | (BibTeX!Author.allInstances()->select(e1 | (e1.author = e.author))->first() = e));

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
    BibTeX!TitledEntry.allInstances()->select(e | (BibTeX!TitledEntry.allInstances()->select(e1 | (e1.title = e.title))->first() = e));

helper def: articleSet : Set(BibTeX!Article) =
    BibTeX!Article.allInstances()->select(e | (BibTeX!Article.allInstances()->select(e1 | (e1.journal = e.journal))->first() = e));

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    ((((((((((self.id + ' ') + self.oclType().name) + if self.oclIsKindOf(BibTeX!TitledEntry) then
        (' ' + self.title)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!AuthoredEntry) then
        (' ' + self.authors->collect(a | a.author)->first())
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!DatedEntry) then
        (' ' + self.year)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!BookTitledEntry) then
        (' ' + self.booktitle)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!ThesisEntry) then
        (' ' + self.school)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Article) then
        (' ' + self.journal)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Unpublished) then
        (' ' + self.note)
    else
        ''
    endif) + if self.oclIsKindOf(BibTeX!Book) then
        (' ' + self.publisher)
    else
        ''
    endif);

rule Main {
    from
        e : BibTeX!BibTeXFile
    to
        doc : DocBook!DocBook (
            books <- b
        ),
        b : DocBook!Book (
            articles <- a
        ),
        a : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Set{se1, se2, se3, se4}
        ),
        se1 : DocBook!Sect1 (
            title <- 'References List',
            paras <- BibTeX!BibTeXEntry.allInstances()->sortedBy(e | e.id)
        ),
        se2 : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- thisModule.authorSet->sortedBy(a | a.author)
        ),
        se3 : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- thisModule.titledEntrySet->sortedBy(e | e.title)->collect(e | thisModule.resolveTemp(e, 'p_title'))
        ),
        se4 : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- thisModule.articleSet->sortedBy(a | a.journal)->collect(a | thisModule.resolveTemp(a, 'p_journal'))
        )
}

rule Author {
    from
        a : BibTeX!Author (
            thisModule.authorSet->includes(a)
        )
    to
        p : DocBook!Para (
            content <- a.author
        )
}

rule UntitledEntry {
    from
        e : BibTeX!BibTeXEntry (
            not e.oclIsKindOf(BibTeX!TitledEntry)
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- e.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule Article_Title_Journal {
    from
        a : BibTeX!Article (
            (thisModule.titledEntrySet->includes(a) and thisModule.articleSet->includes(a))
        )
    to
        p : DocBook!Para (
            content <- a.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- a.title
        ),
        p_journal : DocBook!Para (
            content <- a.journal
        )
}

rule Article_NoTitle_Journal {
    from
        a : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(a) and thisModule.articleSet->includes(a))
        )
    to
        p : DocBook!Para (
            content <- a.buildEntryPara()
        ),
        p_journal : DocBook!Para (
            content <- a.journal
        )
}

rule Article_Title_NoJournal {
    from
        a : BibTeX!Article (
            (thisModule.titledEntrySet->includes(a) and not thisModule.articleSet->includes(a))
        )
    to
        p : DocBook!Para (
            content <- a.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- a.title
        )
}

rule Article_NoTitle_NoJournal {
    from
        a : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(a) and not thisModule.articleSet->includes(a))
        )
    to
        p : DocBook!Para (
            content <- a.buildEntryPara()
        )
}

