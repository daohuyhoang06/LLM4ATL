module BibTeX2DocBook;
create OUT : DocBook from IN : BibTeX;

helper def: authorSet : Set(BibTeX!Author) =
    BibTeX!Author.allInstances()->asSet();

helper def: titledEntrySet : Set(BibTeX!TitledEntry) =
    BibTeX!TitledEntry.allInstances()->asSet();

helper def: articleSet : Set(BibTeX!Article) =
    BibTeX!Article.allInstances()->asSet();

helper context BibTeX!BibTeXEntry def: buildEntryPara() : String =
    self.id;

helper context BibTeX!TitledEntry def: buildEntryPara() : String =
    (self.id + (' ' + self.title));

helper context BibTeX!Article def: buildEntryPara() : String =
    (self.id + (self.title + (' ' + self.journal)));

rule Main {
    from
        bib : BibTeX!BibTeXFile
    to
        d : DocBook!DocBook (
            books <- Set{book}
        ),
        book : DocBook!Book (
            articles <- Set{art}
        ),
        art : DocBook!Article (
            title <- 'BibTeXML to DocBook',
            sections_1 <- Set{s1, s2, s3, s4}
        ),
        s1 : DocBook!Sect1 (
            title <- 'References List',
            paras <- BibTeX!BibTeXEntry.allInstances()->collect(e | thisModule.resolveTemp(e, 'p'))
        ),
        s2 : DocBook!Sect1 (
            title <- 'Authors list',
            paras <- thisModule.authorSet->collect(a | thisModule.resolveTemp(a, 'p'))
        ),
        s3 : DocBook!Sect1 (
            title <- 'Titles List',
            paras <- thisModule.titledEntrySet->collect(e | thisModule.resolveTemp(e, 'p_title'))
        ),
        s4 : DocBook!Sect1 (
            title <- 'Journals List',
            paras <- thisModule.articleSet->collect(e | thisModule.resolveTemp(e, 'p_journal'))
        )
}

rule UntitledEntry {
    from
        e : BibTeX!BibTeXEntry (
            not e.oclIsKindOf(BibTeX!TitledEntry)
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule TitledEntry_Title_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- e.title
        )
}

rule TitledEntry_NoTitle_NoArticle {
    from
        e : BibTeX!TitledEntry (
            (not e.oclIsKindOf(BibTeX!Article) and not thisModule.titledEntrySet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule Article_Title_Journal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- e.title
        ),
        p_journal : DocBook!Para (
            content <- e.journal
        )
}

rule Article_NoTitle_Journal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        p_journal : DocBook!Para (
            content <- e.journal
        )
}

rule Article_Title_NoJournal {
    from
        e : BibTeX!Article (
            (thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        ),
        p_title : DocBook!Para (
            content <- e.title
        )
}

rule Article_NoTitle_NoJournal {
    from
        e : BibTeX!Article (
            (not thisModule.titledEntrySet->includes(e) and not thisModule.articleSet->includes(e))
        )
    to
        p : DocBook!Para (
            content <- e.buildEntryPara()
        )
}

rule Author {
    from
        a : BibTeX!Author (
            thisModule.authorSet->includes(a)
        )
    to
        p : DocBook!Para (
            content <- a.author
        )
}
