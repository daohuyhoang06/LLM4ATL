module ER2REL;
create OUT : REL from IN : ER;

rule ERSchema2RELSchema {
    from
        s : ER!ERSchema
    to
        t : REL!RELSchema (
            relations <- s.entities->union(s.relships)
        )
}

rule Entity2Relation {
    from
        s : ER!Entity
    to
        t : REL!Relation (
            name <- s.name,
            attrs <- s.attrs
        )
}

rule Relship2Relation {
    from
        s : ER!Relship
    to
        t : REL!Relation (
            name <- s.name,
            attrs <- s.attrs->union(s.ends->collect(e | e.entity.attrs->select(a | a.isKey)))
        )
}

rule ERAttribute2RELAttribute {
    from
        s : ER!ERAttribute
    to
        t : REL!RELAttribute (
            name <- s.name,
            isKey <- s.isKey
        )
}

