module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
    let
        attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute))->collect(c | c.oclAsType(XML!Attribute))->any(a | (a.name = name))
    in
        if attr.oclIsUndefined() then
        ''
    else
        attr.value
    endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    (self.getAttrVal(name) = 'true');

helper context XML!Element def: get(name : String) : Set(XML!Element) =
    self.children->select(c | c.oclIsTypeOf(XML!Element))->collect(c | c.oclAsType(XML!Element))->select(c | (c.name = name))->asSet();

helper context XML!Element def: getType : DSL!Type =
    thisModule.findType(self.getAttrVal('type'));

helper context XML!Element def: getEnumId : Integer =
    self.getAttrVal('value').toInteger();

helper context XML!Element def: getText : String =
    let
        textNode : XML!Text = self.children->select(c | c.oclIsTypeOf(XML!Text))->collect(c | c.oclAsType(XML!Text))->any(t | true)
    in
        if textNode.oclIsUndefined() then
        ''
    else
        textNode.value
    endif;

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    let
        parentOpt : XML!Element = self.get(name)->any(e | true)
    in
        if parentOpt.oclIsUndefined() then
        Set{}
    else
        parentOpt.children->select(c | c.oclIsTypeOf(XML!Element))->collect(c | c.oclAsType(XML!Element))->asSet()
    endif;

helper context XML!Element def: hasChildren : Boolean =
    self.children->select(c | c.oclIsTypeOf(XML!Element))->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->select(c | c.oclIsTypeOf(XML!Attribute))->collect(c | c.oclAsType(XML!Attribute))->exists(a | (a.name = name));

helper context XML!Element def: isAbstract : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById : Set(XML!Element) =
    XML!Element.allInstances()->select(e | e.hasAttr('identity'));

helper def: getSubTypes(id : String) : Set(XML!Element) =
    thisModule.dslElementsById->select(e | (e.getAttrVal('superType') = id));

helper def: findType(name : String) : DSL!Type =
    DSL!SimpleType.allInstances()->union(DSL!Enumeration.allInstances())->any(t | (t.name = name));

rule DomainModel {
    from
        s : XML!Root
    to
        t : DSL!DomainModel (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            classifiers <- s.getSeq('classifiers'),
            types <- s.getSeq('types')->union(Set{t_string, t_integer, t_boolean, t_real})
        ),
        t_string : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- s.getAttrVal('namespace')
        ),
        t_integer : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- s.getAttrVal('namespace')
        ),
        t_boolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- s.getAttrVal('namespace')
        ),
        t_real : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- s.getAttrVal('namespace')
        )
}

rule Class {
    from
        s : XML!Element (
            (s.name = 'Class')
        )
    to
        t : DSL!Class (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.isAbstract,
            properties <- s.getSeq('properties'),
            superType <- thisModule.dslElementsById->any(e | (e.getAttrVal('identity') = s.getAttrVal('superType'))),
            subTypes <- thisModule.getSubTypes(s.getAttrVal('identity'))
        )
}

rule Relationship {
    from
        s : XML!Element (
            (s.name = 'Relationship')
        )
    to
        t : DSL!Relationship (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.isAbstract,
            isEmbedding <- s.getAttrBool('isEmbedding'),
            properties <- s.getSeq('properties'),
            superType <- thisModule.dslElementsById->any(e | (e.getAttrVal('identity') = s.getAttrVal('superType'))),
            subTypes <- thisModule.getSubTypes(s.getAttrVal('identity')),
            roles <- s.getSeq('roles')
        )
}

rule Role {
    from
        s : XML!Element (
            (s.name = 'Role')
        )
    to
        t : DSL!Role (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            min <- s.getAttrVal('min').toInteger(),
            max <- s.getAttrVal('max').toInteger(),
            isUnbounded <- s.getAttrBool('isUnbounded'),
            accepts <- s.getAttrVal('accepts'),
            isOrdered <- s.getAttrBool('isOrdered'),
            isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById->any(e | (e.getAttrVal('identity') = s.getAttrVal('source'))),
            type <- thisModule.dslElementsById->any(e | (e.getAttrVal('identity') = s.getAttrVal('type')))
        )
}

rule ValueProperty {
    from
        s : XML!Element (
            (s.name = 'ValueProperty')
        )
    to
        t : DSL!ValueProperty (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            type <- s.getType
        )
}

rule Enumeration {
    from
        s : XML!Element (
            (s.name = 'Enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            literals <- s.getSeq('literals')
        )
}

rule EnumerationLiteral {
    from
        s : XML!Element (
            (s.name = 'EnumerationLiteral')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            value <- s.getEnumId
        )
}
