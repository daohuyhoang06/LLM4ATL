module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    if self.get(name).oclIsUndefined() then
        false
    else
        (self.get(name).value = 'true')
    endif;

helper context XML!Element def: getAttrVal(name : String) : String =
    if self.get(name).oclIsUndefined() then
        ''
    else
        self.get(name).value
    endif;

helper context XML!Element def: get(name : String) : XML!Node =
    self.children->select(c | c.oclIsKindOf(XML!Attribute))->any(c | (c.name = name));

helper context XML!Element def: getType() : DSL!Type =
    thisModule.findType(self.getAttrVal('type'));

helper context XML!Element def: getEnumId() : String =
    self.getAttrVal('value');

helper context XML!Element def: getText() : String =
    if self.children->select(c | c.oclIsKindOf(XML!Text))->any(c | true).oclIsUndefined() then
        ''
    else
        self.children->select(c | c.oclIsKindOf(XML!Text))->any(c | true).value
    endif;

helper context XML!Element def: getSeq(name : String) : Set(XML!Element) =
    self.children->select(c | c.oclIsKindOf(XML!Element))->select(c | (c.name = name));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    not self.get(name).oclIsUndefined();

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById(id : String) : XML!Element =
    XML!Element.allInstances()->any(e | (e.getAttrVal('identity') = id));

helper def: getSubTypes(c : XML!Element) : Set(XML!Element) =
    XML!Element.allInstances()->select(e | ((e.name = 'Class') or (e.name = 'Relationship')))->select(e | (e.getAttrVal('superType') = c.getAttrVal('identity')));

helper def: findType(name : String) : DSL!Type =
    XML!Element.allInstances()->select(e | ((e.name = 'Enumeration') or (e.name = 'SimpleType')))->any(e | ((e.getAttrVal('name') = name) or (e.getAttrVal('identity') = name)));

rule DomainModel {
    from
        s : XML!Element (
            (s.name = 'DomainModel')
        )
    to
        t : DSL!DomainModel (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            classifiers <- s.getSeq('Class')->union(s.getSeq('Relationship')),
            types <- Set{st_string, st_integer, st_boolean, st_double}->union(s.getSeq('Enumeration'))
        ),
        st_string : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        st_integer : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        st_boolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        st_double : DSL!SimpleType (
            name <- 'Double',
            identity <- 'Double',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        s : XML!Element (
            (s.name = 'Class')
        )
    to
        t : DSL!Class (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.getAttrBool('isAbstract'),
            properties <- s.getSeq('ValueProperty'),
            superType <- thisModule.dslElementsById(s.getAttrVal('superType'))
        )
}

rule Relationship {
    from
        s : XML!Element (
            (s.name = 'Relationship')
        )
    to
        t : DSL!Relationship (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.getAttrBool('isAbstract'),
            isEmbedding <- s.getAttrBool('isEmbedding'),
            properties <- s.getSeq('ValueProperty'),
            roles <- s.getSeq('Role'),
            superType <- thisModule.dslElementsById(s.getAttrVal('superType'))
        )
}

rule Role {
    from
        s : XML!Element (
            (s.name = 'Role')
        )
    to
        t : DSL!Role (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            min <- s.getAttrVal('min').toInteger(),
            max <- s.getAttrVal('max').toInteger(),
            isUnbounded <- s.getAttrBool('isUnbounded'),
            accepts <- s.getAttrVal('accepts'),
            isOrdered <- s.getAttrBool('isOrdered'),
            isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById(s.getAttrVal('source')),
            type <- thisModule.dslElementsById(s.getAttrVal('type'))
        )
}

rule ValueProperty {
    from
        s : XML!Element (
            (s.name = 'ValueProperty')
        )
    to
        t : DSL!ValueProperty (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            type <- s.getType()
        )
}

rule Enumeration {
    from
        s : XML!Element (
            (s.name = 'Enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            literals <- s.getSeq('EnumerationLiteral')
        )
}

rule EnumerationLiteral {
    from
        s : XML!Element (
            (s.name = 'EnumerationLiteral')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            value <- s.getEnumId().toInteger()
        )
}

