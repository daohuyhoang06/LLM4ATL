# Choose one provider for each pipeline run: gemini, openai, or claude.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
OPENAI_REASONING_EFFORT=
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=


# Full
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER3_GENERATION=true

# Without L1 feedback
ABLATION_RUN_LABEL=without_l1
ABLATION_ENABLE_LAYER1_SCHEMA=false
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER3_GENERATION=true

# Without L2 feedback
ABLATION_RUN_LABEL=without_l2
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=false
ABLATION_ENABLE_LAYER3_GENERATION=true

# Without L3 feedback
ABLATION_RUN_LABEL=without_l3
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER3_GENERATION=false

# eFinder bounded-search settings. Increase EFINDER_SCOPE when the
# transformation needs more objects; larger values may increase solver time.
EFINDER_SCOPE=5
EFINDER_REFERENCE_SCOPE=10
EFINDER_TIMEOUT_MS=900000
