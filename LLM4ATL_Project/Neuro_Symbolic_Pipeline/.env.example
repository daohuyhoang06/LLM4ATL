# Choose one provider for each pipeline run: gemini, openai, or claude.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
OPENAI_REASONING_EFFORT=
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# Validation and generation layers. Omit a variable to use the default value: true.
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER2_TYPE_CHECK=true
ABLATION_ENABLE_LAYER2_EXISTENCE_CHECK=true
ABLATION_ENABLE_LAYER2_NULL_SAFETY=true
ABLATION_ENABLE_LAYER3_GENERATION=true

# eFinder bounded-search settings. Increase EFINDER_SCOPE when the
# transformation needs more objects; larger values may increase solver time.
EFINDER_SCOPE=5
EFINDER_REFERENCE_SCOPE=10
EFINDER_TIMEOUT_MS=900000

# Headless AgileUML DSS structural mapping. The three generated artefacts are
# stored in output/dss/<case>/ (or the legacy ouput/dss/<case>/ directory).
# Only forward.tl is added to the LLM prompt.
DSS_ENABLED=true
DSS_SOURCE_CHAIN=1
DSS_TARGET_CHAIN=1
DSS_TYPE_MATCH=fuzzy
DSS_REVIEW=none
# Optional override; the default is <repository>/Third_Party/agileuml-dss.
# AGILEUML_DSS_DIR=D:\path\to\LLM4ATL\Third_Party\agileuml-dss
