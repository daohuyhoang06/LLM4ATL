# Choose one provider for each pipeline run: gemini, openai, or claude.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
OPENAI_REASONING_EFFORT=
# GEMINI_API_KEY is required only when calling Gemini's native API directly.
# To call a Gemini model through the configured gateway, set both
# ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL instead.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_or_gateway_api_key_here
ANTHROPIC_BASE_URL=


# Validation and generation layers. Omit a variable to use the default value: true.
ABLATION_ENABLE_LAYER1_SCHEMA=true
ABLATION_ENABLE_LAYER2_SEMANTIC=true
ABLATION_ENABLE_LAYER3_GENERATION=true

# Set a unique label whenever one of L1/L2/L3 is false. Outputs and metrics
# are then written under output/ablation/<label>/ and cannot overwrite a full run.
# ABLATION_RUN_LABEL=without_l1

# eFinder bounded-search settings. Increase EFINDER_SCOPE when the
# transformation needs more objects; larger values may increase solver time.
EFINDER_SCOPE=5
EFINDER_REFERENCE_SCOPE=10
EFINDER_TIMEOUT_MS=900000
