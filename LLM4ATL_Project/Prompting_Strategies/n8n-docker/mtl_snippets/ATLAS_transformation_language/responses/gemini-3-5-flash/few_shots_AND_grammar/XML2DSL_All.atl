module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
  let attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute) and c.name = name)->first() in
  if attr.oclIsUndefined() then '' else attr.value endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
  self.getAttrVal(name) = 'true';

helper context XML!Element def: get(name : String) : XML!Element =
  self.children->select(c | c.oclIsTypeOf(XML!Element) and c.name = name)->first();

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
  self.children->select(c | c.oclIsTypeOf(XML!Element) and c.name = name);

helper context XML!Element def: hasChildren(name : String) : Boolean =
  self.getSeq(name)->size() > 0;

helper context XML!Element def: hasAttr(name : String) : Boolean =
  not self.children->select(c | c.oclIsTypeOf(XML!Attribute) and c.name = name)->first().oclIsUndefined();

helper context XML!Element def: getText() : String =
  let t : XML!Text = self.children->select(c | c.oclIsTypeOf(XML!Text))->first() in
  if t.oclIsUndefined() then '' else t.value endif;

helper context XML!Element def: getType(name : String) : String =
  self.getAttrVal(name);

helper context XML!Element def: getEnumId(name : String) : String =
  self.getAttrVal(name);

helper context XML!Element def: isAbstract() : Boolean =
  self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
  XML!Element.allInstances()->iterate(e; acc : Map(String, XML!Element) = Map {} |
    if e.hasAttr('identity') then
      acc.insert(e.getAttrVal('identity'), e)
    else
      acc
    endif
  );

helper def: getSubTypes(superId : String) : Sequence(XML!Element) =
  XML!Element.allInstances()->select(e |
    (e.name = 'Class' or e.name = 'Relationship') and e.getAttrVal('superType') = superId
  );

helper def: findType(id : String) : DSL!Type =
  if id = 'String' or id = 'string' then
    thisModule.resolveTemp(XML!Root.allInstances()->first(), 'tString')
  else
    if id = 'Integer' or id = 'integer' or id = 'int' then
      thisModule.resolveTemp(XML!Root.allInstances()->first(), 'tInteger')
    else
      if id = 'Boolean' or id = 'boolean' or id = 'bool' then
        thisModule.resolveTemp(XML!Root.allInstances()->first(), 'tBoolean')
      else
        if id = 'Double' or id = 'double' or id = 'real' or id = 'Real' then
          thisModule.resolveTemp(XML!Root.allInstances()->first(), 'tDouble')
        else
          let xmlEnum : XML!Element = XML!Element.allInstances()->select(e | e.name = 'Enumeration' and e.getAttrVal('identity') = id)->first() in
          if xmlEnum.oclIsUndefined() then
            OclUndefined
          else
            xmlEnum
          endif
        endif
      endif
    endif
  endif;

rule DomainModel {
  from
    s : XML!Root (s.name = 'DomainModel')
  to
    t : DSL!DomainModel (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      isLoaded <- s.getAttrBool('isLoaded'),
      namespace <- s.getAttrVal('namespace'),
      classifiers <- s.getSeq('Class')->union(s.getSeq('Relationship')),
      types <- Sequence{tString, tInteger, tBoolean, tDouble}->union(s.getSeq('Enumeration'))
    ),
    tString : DSL!SimpleType (
      name <- 'String',
      identity <- 'String',
      namespace <- t.namespace
    ),
    tInteger : DSL!SimpleType (
      name <- 'Integer',
      identity <- 'Integer',
      namespace <- t.namespace
    ),
    tBoolean : DSL!SimpleType (
      name <- 'Boolean',
      identity <- 'Boolean',
      namespace <- t.namespace
    ),
    tDouble : DSL!SimpleType (
      name <- 'Double',
      identity <- 'Double',
      namespace <- t.namespace
    )
}

rule Class {
  from
    s : XML!Element (s.name = 'Class')
  to
    t : DSL!Class (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      isLoaded <- s.getAttrBool('isLoaded'),
      namespace <- s.getAttrVal('namespace'),
      isAbstract <- s.getAttrBool('isAbstract'),
      properties <- s.getSeq('ValueProperty'),
      superType <- let superId : String = s.getAttrVal('superType') in
                   if superId = '' then OclUndefined else thisModule.dslElementsById.get(superId) endif,
      subTypes <- thisModule.getSubTypes(s.getAttrVal('identity'))
    )
}

rule Relationship {
  from
    s : XML!Element (s.name = 'Relationship')
  to
    t : DSL!Relationship (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      isLoaded <- s.getAttrBool('isLoaded'),
      namespace <- s.getAttrVal('namespace'),
      isAbstract <- s.getAttrBool('isAbstract'),
      isEmbedding <- s.getAttrBool('isEmbedding'),
      properties <- s.getSeq('ValueProperty'),
      roles <- s.getSeq('Role'),
      superType <- let superId : String = s.getAttrVal('superType') in
                   if superId = '' then OclUndefined else thisModule.dslElementsById.get(superId) endif,
      subTypes <- thisModule.getSubTypes(s.getAttrVal('identity'))
    )
}

rule Role {
  from
    s : XML!Element (s.name = 'Role')
  to
    t : DSL!Role (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      min <- if s.getAttrVal('min') = '' then 0 else s.getAttrVal('min').toInteger() endif,
      max <- if s.getAttrVal('max') = '' then 0 else s.getAttrVal('max').toInteger() endif,
      isUnbounded <- s.getAttrBool('isUnbounded'),
      accepts <- s.getAttrVal('accepts'),
      isOrdered <- s.getAttrBool('isOrdered'),
      isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
      isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
      source <- thisModule.dslElementsById.get(s.getAttrVal('source')),
      type <- thisModule.dslElementsById.get(s.getAttrVal('type'))
    )
}

rule ValueProperty {
  from
    s : XML!Element (s.name = 'ValueProperty')
  to
    t : DSL!ValueProperty (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      type <- thisModule.findType(s.getAttrVal('type'))
    )
}

rule Enumeration {
  from
    s : XML!Element (s.name = 'Enumeration')
  to
    t : DSL!Enumeration (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      namespace <- s.getAttrVal('namespace'),
      literals <- s.getSeq('EnumerationLiteral')
    )
}

rule EnumerationLiteral {
  from
    s : XML!Element (s.name = 'EnumerationLiteral')
  to
    t : DSL!EnumerationLiteral (
      name <- s.getAttrVal('name'),
      identity <- s.getAttrVal('identity'),
      value <- if s.getAttrVal('value') = '' then 0 else s.getAttrVal('value').toInteger() endif
    )
}