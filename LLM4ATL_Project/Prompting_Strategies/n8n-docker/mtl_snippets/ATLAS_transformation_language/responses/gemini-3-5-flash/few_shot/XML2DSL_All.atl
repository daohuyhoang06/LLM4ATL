module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
  let attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute))->any(a | a.name = name) in
  if attr.oclIsUndefined() then '' else attr.value endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
  self.getAttrVal(name) = 'true';

helper context XML!Element def: get(name : String) : Sequence(XML!Element) =
  self.children->select(c | c.oclIsTypeOf(XML!Element) and c.name = name);

helper context XML!Element def: getType : String =
  self.getAttrVal('type');

helper context XML!Element def: getEnumId : String =
  self.getAttrVal('enum');

helper context XML!Element def: getText : String =
  let text : XML!Text = self.children->select(c | c.oclIsTypeOf(XML!Text))->first() in
  if text.oclIsUndefined() then '' else text.value endif;

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
  self.get(name);

helper context XML!Element def: hasChildren : Boolean =
  self.children->exists(c | c.oclIsTypeOf(XML!Element));

helper context XML!Element def: hasAttr(name : String) : Boolean =
  self.children->select(c | c.oclIsTypeOf(XML!Attribute))->exists(a | a.name = name);

helper context XML!Element def: isAbstract : Boolean =
  self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
  XML!Element.allInstances()
    ->select(e | e.hasAttr('id') or e.hasAttr('identity'))
    ->iterate(e; acc : Map(String, XML!Element) = Map {} |
      let id : String = if e.hasAttr('id') then e.getAttrVal('id') else e.getAttrVal('identity') endif in
      acc.including(id, e)
    );

helper def: getSubTypes(classifierId : String) : Sequence(XML!Element) =
  XML!Element.allInstances()
    ->select(e | e.name = 'class' or e.name = 'relationship')
    ->select(e | e.getAttrVal('superType') = classifierId);

helper def: findType(typeId : String) : DSL!Type =
  let name : String =
    if typeId = 'Int32' or typeId = 'Integer' then
      'Integer'
    else
      if typeId = 'Boolean' then
        'Boolean'
      else
        if typeId = 'Double' or typeId = 'Real' then
          'Double'
        else
          if typeId = 'String' then
            'String'
          else
            ''
          endif
        endif
      endif
    endif in
  let st : DSL!SimpleType = DSL!SimpleType.allInstances()->any(t | t.name = name) in
  if not st.oclIsUndefined() then
    st
  else
    thisModule.dslElementsById.get(typeId)
  endif;

rule DomainModel {
  from
    s : XML!Element (s.name = 'domainModel')
  to
    t : DSL!DomainModel (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      isLoaded <- if s.hasAttr('isLoaded') then s.getAttrBool('isLoaded') else true endif,
      namespace <- s.getAttrVal('namespace'),
      classifiers <- s.get('class')->union(s.get('relationship')),
      types <- s.get('enumeration')->union(Sequence{st_string, st_integer, st_boolean, st_double})
    ),
    st_string : DSL!SimpleType (
      name <- 'String',
      identity <- 'st_string',
      namespace <- s.getAttrVal('namespace')
    ),
    st_integer : DSL!SimpleType (
      name <- 'Integer',
      identity <- 'st_integer',
      namespace <- s.getAttrVal('namespace')
    ),
    st_boolean : DSL!SimpleType (
      name <- 'Boolean',
      identity <- 'st_boolean',
      namespace <- s.getAttrVal('namespace')
    ),
    st_double : DSL!SimpleType (
      name <- 'Double',
      identity <- 'st_double',
      namespace <- s.getAttrVal('namespace')
    )
}

rule Class {
  from
    s : XML!Element (s.name = 'class')
  to
    t : DSL!Class (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      namespace <- s.getAttrVal('namespace'),
      isLoaded <- if s.hasAttr('isLoaded') then s.getAttrBool('isLoaded') else true endif,
      isAbstract <- s.getAttrBool('isAbstract'),
      properties <- s.get('valueProperty')->union(s.get('property')),
      superType <- thisModule.dslElementsById.get(s.getAttrVal('superType')),
      subTypes <- thisModule.getSubTypes(if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif)
    )
}

rule Relationship {
  from
    s : XML!Element (s.name = 'relationship')
  to
    t : DSL!Relationship (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      namespace <- s.getAttrVal('namespace'),
      isLoaded <- if s.hasAttr('isLoaded') then s.getAttrBool('isLoaded') else true endif,
      isAbstract <- s.getAttrBool('isAbstract'),
      isEmbedding <- s.getAttrBool('isEmbedding'),
      properties <- s.get('valueProperty')->union(s.get('property')),
      superType <- thisModule.dslElementsById.get(s.getAttrVal('superType')),
      subTypes <- thisModule.getSubTypes(if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif),
      roles <- s.get('role')
    )
}

rule Role {
  from
    s : XML!Element (s.name = 'role')
  to
    t : DSL!Role (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      min <- if s.getAttrVal('min') <> '' then s.getAttrVal('min').toInteger() else 0 endif,
      max <- if s.getAttrVal('max') <> '' then s.getAttrVal('max').toInteger() else 1 endif,
      isUnbounded <- s.getAttrBool('isUnbounded'),
      accepts <- s.getAttrVal('accepts'),
      isOrdered <- s.getAttrBool('isOrdered'),
      isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
      isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
      source <- thisModule.dslElementsById.get(s.getAttrVal('source')),
      type <- thisModule.dslElementsById.get(s.getAttrVal('type')),
      relation <- s.parent
    )
}

rule ValueProperty {
  from
    s : XML!Element (s.name = 'valueProperty' or s.name = 'property')
  to
    t : DSL!ValueProperty (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      owner <- s.parent,
      type <- thisModule.findType(s.getAttrVal('type'))
    )
}

rule Enumeration {
  from
    s : XML!Element (s.name = 'enumeration')
  to
    t : DSL!Enumeration (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      namespace <- s.getAttrVal('namespace'),
      literals <- s.get('literal')
    )
}

rule EnumerationLiteral {
  from
    s : XML!Element (s.name = 'literal')
  to
    t : DSL!EnumerationLiteral (
      name <- s.getAttrVal('name'),
      identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
      value <- if s.getAttrVal('value') <> '' then s.getAttrVal('value').toInteger() else 0 endif
    )
}