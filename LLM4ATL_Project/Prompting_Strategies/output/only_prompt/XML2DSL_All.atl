module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
	let attr : XML!Attribute = self.children->select(c | c.oclIsKindOf(XML!Attribute))->select(a | a.name = name)->first() in
	if attr.oclIsUndefined() then
		''
	else
		attr.value
	endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
	self.getAttrVal(name) = 'true';

helper context XML!Element def: get(name : String) : XML!Element =
	self.children->select(c | c.oclIsKindOf(XML!Element))->select(e | e.name = name)->first();

helper context XML!Element def: getType : String =
	self.getAttrVal('type');

helper context XML!Element def: getEnumId : String =
	self.getAttrVal('enumeration');

helper context XML!Element def: getText() : String =
	let textNode : XML!Text = self.children->select(c | c.oclIsKindOf(XML!Text))->first() in
	if textNode.oclIsUndefined() then
		''
	else
		textNode.value
	endif;

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
	let child : XML!Element = self.get(name) in
	if child.oclIsUndefined() then
		Sequence{}
	else
		child.children->select(c | c.oclIsKindOf(XML!Element))
	endif;

helper context XML!Element def: hasChildren() : Boolean =
	self.children->select(c | c.oclIsKindOf(XML!Element))->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
	self.children->select(c | c.oclIsKindOf(XML!Attribute))->exists(a | a.name = name);

helper context XML!Element def: isAbstract : Boolean =
	self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
	XML!Element.allInstances()->select(e | e.hasAttr('identity'))->iterate(e; acc : Map(String, XML!Element) = Map{} |
		acc.insert(e.getAttrVal('identity'), e)
	);

helper def: getSubTypes(id : String) : Sequence(XML!Element) =
	XML!Element.allInstances()->select(e | e.name = 'Class' or e.name = 'Relationship')->select(e | e.getAttrVal('superType') = id);

helper def: findType(name : String) : DSL!Type =
	DSL!Type.allInstances()->select(t | t.name = name or t.identity = name)->first();

rule DomainModel {
	from
		s : XML!Element (
			s.name = 'DomainModel'
		)
	to
		t : DSL!DomainModel (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- s.getAttrBool('isLoaded'),
			classifiers <- s.getSeq('classifiers'),
			types <- s.getSeq('types')->union(Sequence{st1, st2, st3, st4})
		),
		st1 : DSL!SimpleType (
			name <- 'String',
			identity <- 'String',
			namespace <- s.getAttrVal('namespace')
		),
		st2 : DSL!SimpleType (
			name <- 'Boolean',
			identity <- 'Boolean',
			namespace <- s.getAttrVal('namespace')
		),
		st3 : DSL!SimpleType (
			name <- 'Integer',
			identity <- 'Integer',
			namespace <- s.getAttrVal('namespace')
		),
		st4 : DSL!SimpleType (
			name <- 'Double',
			identity <- 'Double',
			namespace <- s.getAttrVal('namespace')
		)
}

rule Class {
	from
		s : XML!Element (
			s.name = 'Class'
		)
	to
		t : DSL!Class (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- s.getAttrBool('isLoaded'),
			isAbstract <- s.isAbstract,
			properties <- s.getSeq('properties'),
			superType <- thisModule.dslElementsById.get(s.getAttrVal('superType'))
		)
}

rule Relationship {
	from
		s : XML!Element (
			s.name = 'Relationship'
		)
	to
		t : DSL!Relationship (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- s.getAttrBool('isLoaded'),
			isAbstract <- s.isAbstract,
			isEmbedding <- s.getAttrBool('isEmbedding'),
			properties <- s.getSeq('properties'),
			roles <- s.getSeq('roles'),
			superType <- thisModule.dslElementsById.get(s.getAttrVal('superType'))
		)
}

rule Role {
	from
		s : XML!Element (
			s.name = 'Role'
		)
	to
		t : DSL!Role (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			min <- s.getAttrVal('min').toInteger(),
			max <- s.getAttrVal('max').toInteger(),
			isUnbounded <- s.getAttrBool('isUnbounded'),
			accepts <- s.getAttrVal('accepts'),
			isOrdered <- s.getAttrBool('isOrdered'),
			isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
			isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
			source <- thisModule.dslElementsById.get(s.getAttrVal('source')),
			type <- thisModule.dslElementsById.get(s.getAttrVal('type'))
		)
}

rule ValueProperty {
	from
		s : XML!Element (
			s.name = 'ValueProperty'
		)
	to
		t : DSL!ValueProperty (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			type <- thisModule.findType(if s.hasAttr('type') then s.getType else s.getEnumId endif)
		)
}

rule Enumeration {
	from
		s : XML!Element (
			s.name = 'Enumeration'
		)
	to
		t : DSL!Enumeration (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			namespace <- s.getAttrVal('namespace'),
			literals <- s.getSeq('literals')
		)
}

rule EnumerationLiteral {
	from
		s : XML!Element (
			s.name = 'EnumerationLiteral'
		)
	to
		t : DSL!EnumerationLiteral (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('identity'),
			value <- s.getAttrVal('value').toInteger()
		)
}