module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
	let attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute))->select(a | a.name = name)->first()
	in if attr.oclIsUndefined() then '' else attr.value endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
	self.getAttrVal(name) = 'true' or self.getAttrVal(name) = '1';

helper context XML!Element def: hasAttr(name : String) : Boolean =
	self.children->select(c | c.oclIsTypeOf(XML!Attribute))->exists(a | a.name = name);

helper context XML!Element def: get(name : String) : XML!Element =
	self.children->select(c | c.oclIsTypeOf(XML!Element))->select(e | e.name = name)->first();

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
	self.children->select(c | c.oclIsTypeOf(XML!Element))->select(e | e.name = name);

helper context XML!Element def: hasChildren(name : String) : Boolean =
	self.getSeq(name)->notEmpty();

helper context XML!Element def: getText() : String =
	let text : XML!Text = self.children->select(c | c.oclIsTypeOf(XML!Text))->first()
	in if text.oclIsUndefined() then '' else text.value endif;

helper context XML!Element def: getType() : String =
	if self.hasAttr('type') then
		self.getAttrVal('type')
	else
		if self.hasChildren('Type') then
			self.get('Type').getAttrVal('name')
		else
			''
		endif
	endif;

helper context XML!Element def: getEnumId() : String =
	if self.hasAttr('enumeration') then
		self.getAttrVal('enumeration')
	else
		if self.hasChildren('Enumeration') then
			self.get('Enumeration').getAttrVal('id')
		else
			''
		endif
	endif;

helper context XML!Element def: isAbstract() : Boolean =
	self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
	XML!Element.allInstances()->select(e | e.hasAttr('id') or e.hasAttr('Id'))->iterate(e; map : Map(String, XML!Element) = Map {} |
		map.insert(if e.hasAttr('id') then e.getAttrVal('id') else e.getAttrVal('Id') endif, e)
	);

helper def: getSubTypes(id : String) : Sequence(XML!Element) =
	XML!Element.allInstances()->select(e | e.name = 'Class' or e.name = 'Relationship')->select(e |
		if e.hasAttr('superType') then
			e.getAttrVal('superType') = id
		else
			if e.hasChildren('SuperType') then
				e.get('SuperType').getAttrVal('id') = id
			else
				false
			endif
		endif
	);

helper def: findType(name : String) : DSL!Type =
	let st : DSL!SimpleType = DSL!SimpleType.allInstances()->select(t | t.name = name)->first()
	in if not st.oclIsUndefined() then
		st
	else
		DSL!Enumeration.allInstances()->select(e | e.name = name or e.identity = name)->first()
	endif;

rule DomainModel {
	from
		s : XML!Element (
			s.name = 'DomainModel'
		)
	to
		t : DSL!DomainModel (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- if s.hasAttr('isLoaded') then s.getAttrBool('isLoaded') else true endif,
			classifiers <- s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | e.name = 'Class' or e.name = 'Relationship'),
			types <- Sequence {stringType, booleanType, integerType, doubleType}->union(
				s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | e.name = 'Enumeration')
			)
		),
		stringType : DSL!SimpleType (
			name <- 'String',
			identity <- 'String',
			namespace <- s.getAttrVal('namespace')
		),
		booleanType : DSL!SimpleType (
			name <- 'Boolean',
			identity <- 'Boolean',
			namespace <- s.getAttrVal('namespace')
		),
		integerType : DSL!SimpleType (
			name <- 'Integer',
			identity <- 'Integer',
			namespace <- s.getAttrVal('namespace')
		),
		doubleType : DSL!SimpleType (
			name <- 'Double',
			identity <- 'Double',
			namespace <- s.getAttrVal('namespace')
		)
}

rule Class {
	from
		s : XML!Element (
			s.name = 'Class'
		)
	to
		t : DSL!Class (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- if s.hasAttr('isLoaded') then s.getAttrBool('isLoaded') else true endif,
			isAbstract <- s.isAbstract(),
			properties <- s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | e.name = 'ValueProperty'),
			superType <- if s.hasAttr('superType') then thisModule.dslElementsById.get(s.getAttrVal('superType')) else OclUndefined endif,
			subTypes <- thisModule.getSubTypes(if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif)
		)
}

rule Relationship {
	from
		s : XML!Element (
			s.name = 'Relationship'
		)
	to
		t : DSL!Relationship (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- if s.hasAttr('isLoaded') then s.getAttrBool('isLoaded') else true endif,
			isAbstract <- s.isAbstract(),
			isEmbedding <- s.getAttrBool('isEmbedding'),
			properties <- s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | e.name = 'ValueProperty'),
			roles <- s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | e.name = 'Role'),
			superType <- if s.hasAttr('superType') then thisModule.dslElementsById.get(s.getAttrVal('superType')) else OclUndefined endif,
			subTypes <- thisModule.getSubTypes(if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif)
		)
}

rule Role {
	from
		s : XML!Element (
			s.name = 'Role'
		)
	to
		t : DSL!Role (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			min <- if s.hasAttr('min') then s.getAttrVal('min').toInteger() else 0 endif,
			max <- if s.hasAttr('max') then s.getAttrVal('max').toInteger() else 0 endif,
			isUnbounded <- s.getAttrBool('isUnbounded'),
			accepts <- s.getAttrVal('accepts'),
			isOrdered <- s.getAttrBool('isOrdered'),
			isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
			isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
			source <- if s.hasAttr('source') then thisModule.dslElementsById.get(s.getAttrVal('source')) else OclUndefined endif,
			type <- if s.hasAttr('type') then thisModule.dslElementsById.get(s.getAttrVal('type')) else OclUndefined endif,
			relation <- s.parent
		)
}

rule ValueProperty {
	from
		s : XML!Element (
			s.name = 'ValueProperty'
		)
	to
		t : DSL!ValueProperty (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			owner <- s.parent,
			type <- thisModule.findType(s.getAttrVal('type'))
		)
}

rule Enumeration {
	from
		s : XML!Element (
			s.name = 'Enumeration'
		)
	to
		t : DSL!Enumeration (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			namespace <- s.getAttrVal('namespace'),
			literals <- s.children->select(e | e.oclIsTypeOf(XML!Element))->select(e | e.name = 'EnumerationLiteral')
		)
}

rule EnumerationLiteral {
	from
		s : XML!Element (
			s.name = 'EnumerationLiteral'
		)
	to
		t : DSL!EnumerationLiteral (
			name <- s.getAttrVal('name'),
			identity <- if s.hasAttr('id') then s.getAttrVal('id') else s.getAttrVal('identity') endif,
			value <- if s.hasAttr('value') then s.getAttrVal('value').toInteger() else 0 endif
		)
}