module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : CPL!Element =
	if self.oclIsKindOf(CPL!Node) then
		self
	else
		if self.oclIsKindOf(CPL!NodeContainer) then
			if self.contents.oclIsUndefined() then
				OclUndefined
			else
				self.contents.statement
			endif
		else
			OclUndefined
		endif
	endif;

helper context CPL!Element def: locations : Sequence(CPL!Location) =
	if self.oclIsKindOf(CPL!Location) then
		if self.contents.oclIsUndefined() then
			Sequence{self}
		else
			self.contents.locations->prepend(self)
		endif
	else
		if self.oclIsKindOf(CPL!NodeContainer) then
			if self.contents.oclIsUndefined() then
				Sequence{}
			else
				self.contents.locations
			endif
		else
			Sequence{}
		endif
	endif;

helper context CPL!Proxy def: isSimple : Boolean =
	self.busy.oclIsUndefined() and
	self.noAnswer.oclIsUndefined() and
	self.redirection.oclIsUndefined() and
	self.failure.oclIsUndefined() and
	self.default.oclIsUndefined();

rule CPL2Program {
	from
		c : CPL!CPL
	to
		p : SPL!Program (
			service <- s
		),
		s : SPL!Service (
			name <- 'cpl',
			declarations <- c.subActions,
			sessions <- d
		),
		d : SPL!Dialog (
			methods <- c.incoming
		)
}

rule SubAction2Function {
	from
		s : CPL!SubAction
	to
		f : SPL!LocalFunctionDeclaration (
			name <- s.id,
			returnType <- t,
			statements <- s.statement
		),
		t : SPL!SimpleType (
			type <- #void
		)
}

rule Incoming2Method {
	from
		i : CPL!Incoming
	to
		m : SPL!Method (
			direction <- #in,
			methodName <- mName,
			type <- t,
			statements <- i.statement
		),
		mName : SPL!SIPMethodName (
			name <- #INVITE
		),
		t : SPL!SimpleType (
			type <- #void
		)
}

rule Proxy2Return {
	from
		p : CPL!Proxy (
			p.isSimple
		)
	to
		r : SPL!ReturnStat (
			returnedValue <- f
		),
		f : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- thisModule.Location2URIConstant(p.locations)
		)
}

rule Proxy2Select {
	from
		p : CPL!Proxy (
			not p.isSimple
		)
	to
		s : SPL!SelectStat (
			matchedExp <- f,
			selectCases <- p.busy,
			selectCases <- p.noAnswer,
			selectCases <- p.redirection,
			selectDefault <- p.default
		),
		f : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- thisModule.Location2URIConstant(p.locations)
		)
}

rule Busy2SelectCase {
	from
		b : CPL!Busy
	to
		s : SPL!SelectCase (
			values <- c,
			statements <- b.statement
		),
		c : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #BUSY_HERE
		)
}

rule NoAnswer2SelectCase {
	from
		n : CPL!NoAnswer
	to
		s : SPL!SelectCase (
			values <- c,
			statements <- n.statement
		),
		c : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #REQUEST_TIMEOUT
		)
}

rule Redirection2SelectCase {
	from
		r : CPL!Redirection
	to
		s : SPL!SelectCase (
			values <- c,
			statements <- r.statement
		),
		c : SPL!ResponseConstant (
			response <- e
		),
		e : SPL!RedirectionErrorResponse (
			errorKind <- #MULTIPLE_CHOICES
		)
}

rule Default2SelectDefault {
	from
		d : CPL!Default
	to
		s : SPL!SelectDefault (
			statements <- d.statement
		)
}

rule SubCall2Return {
	from
		s : CPL!SubCall
	to
		r : SPL!ReturnStat (
			returnedValue <- c
		),
		c : SPL!FunctionCallExp (
			functionCall <- f
		),
		f : SPL!FunctionCall (
			function <- s.ref
		)
}

rule Redirect2Return {
	from
		r : CPL!Redirect
	to
		s : SPL!ReturnStat (
			returnedValue <- f
		),
		f : SPL!WithExp (
			exp <- e,
			msgFields <- m
		),
		e : SPL!ConstantExp (
			value <- c
		),
		c : SPL!ResponseConstant (
			response <- res
		),
		res : SPL!RedirectionErrorResponse (
			errorKind <- #MOVED_TEMPORARILY
		),
		m : SPL!HeadedMessageField (
			headerId <- 'Contact',
			exp <- thisModule.Location2URIConstant(r.locations)
		)
}

rule AddressSwitch2SelectStat {
	from
		a : CPL!AddressSwitch
	to
		s : SPL!SelectStat (
			matchedExp <- p,
			selectCases <- a.addresses,
			selectDefault <- a.otherwise
		),
		p : SPL!SIPHeaderPlace (
			header <- if a.field = 'origin' then #FROM else #TO endif
		)
}

rule SwitchedAddress2SelectCase {
	from
		a : CPL!SwitchedAddress
	to
		s : SPL!SelectCase (
			values <- c,
			statements <- a.statement
		),
		c : SPL!URIConstant (
			uri <- a.is
		)
}

rule Otherwise2SelectDefault {
	from
		o : CPL!Otherwise
	to
		s : SPL!SelectDefault (
			statements <- o.statement
		)
}

rule Location2URIConstant(locations : Sequence(CPL!Location)) {
	to
		u : SPL!URIConstant (
			uri <- locations->first().url
		)
	do {
		u;
	}
}