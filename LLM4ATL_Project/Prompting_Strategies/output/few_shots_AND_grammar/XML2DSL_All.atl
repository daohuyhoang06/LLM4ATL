module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: hasAttr(name : String) : Boolean =
	self.children->select(e | e.oclIsKindOf(XML!Attribute))->exists(a | a.name = name);

helper context XML!Element def: getAttrVal(name : String) : String =
	if self.hasAttr(name) then
		self.children->select(e | e.oclIsKindOf(XML!Attribute))->select(a | a.name = name)->first().value
	else
		''
	endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
	if self.hasAttr(name) then
		self.getAttrVal(name) = 'true'
	else
		false
	endif;

helper context XML!Element def: get(name : String) : XML!Element =
	self.children->select(e | e.oclIsKindOf(XML!Element))->select(e | e.name = name)->first();

helper context XML!Element def: getType(name : String) : String =
	let c : XML!Element = self.get(name) in
	if c.oclIsUndefined() then
		''
	else
		let sub : XML!Element = c.children->select(e | e.oclIsKindOf(XML!Element))->first() in
		if sub.oclIsUndefined() then
			''
		else
			sub.getAttrVal('Name')
		endif
	endif;

helper context XML!Element def: getEnumId(name : String) : String =
	let c : XML!Element = self.get(name) in
	if c.oclIsUndefined() then
		''
	else
		let sub : XML!Element = c.children->select(e | e.oclIsKindOf(XML!Element))->first() in
		if sub.oclIsUndefined() then
			''
		else
			sub.getAttrVal('Id')
		endif
	endif;

helper context XML!Element def: getText() : String =
	let t : XML!Text = self.children->select(e | e.oclIsKindOf(XML!Text))->first() in
	if t.oclIsUndefined() then
		''
	else
		t.value
	endif;

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
	let c : XML!Element = self.get(name) in
	if c.oclIsUndefined() then
		Sequence {}
	else
		c.children->select(e | e.oclIsKindOf(XML!Element))
	endif;

helper context XML!Element def: hasChildren() : Boolean =
	self.children->select(e | e.oclIsKindOf(XML!Element))->notEmpty();

helper context XML!Element def: isAbstract() : Boolean =
	self.getAttrBool('IsAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
	XML!Element.allInstances()->select(e | e.hasAttr('Id'))->iterate(e; acc : Map(String, XML!Element) = Map {} |
		acc.insert(e.getAttrVal('Id'), e)
	);

helper def: getSubTypes(c : XML!Element) : Sequence(DSL!Classifier) =
	DSL!Classifier.allInstances()->select(e |
		if e.superType.oclIsUndefined() then
			false
		else
			e.superType.name = c.getAttrVal('Name')
		endif
	);

helper def: findType(name : String) : DSL!Type =
	DSL!Type.allInstances()->select(t | t.name = name)->first();

rule DomainModel {
	from
		s : XML!Element (
			s.name = 'DomainModel'
		)
	to
		t : DSL!DomainModel (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			namespace <- s.getAttrVal('Namespace'),
			isLoaded <- true,
			classifiers <- s.getSeq('Classifiers'),
			types <- Sequence {stringType, booleanType, integerType, doubleType}->union(s.getSeq('Types'))
		),
		stringType : DSL!SimpleType (
			name <- 'String',
			identity <- 'String',
			namespace <- s.getAttrVal('Namespace')
		),
		booleanType : DSL!SimpleType (
			name <- 'Boolean',
			identity <- 'Boolean',
			namespace <- s.getAttrVal('Namespace')
		),
		integerType : DSL!SimpleType (
			name <- 'Integer',
			identity <- 'Integer',
			namespace <- s.getAttrVal('Namespace')
		),
		doubleType : DSL!SimpleType (
			name <- 'Double',
			identity <- 'Double',
			namespace <- s.getAttrVal('Namespace')
		)
}

rule Class {
	from
		s : XML!Element (
			s.name = 'Class'
		)
	to
		t : DSL!Class (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			namespace <- s.getAttrVal('Namespace'),
			isLoaded <- true,
			isAbstract <- s.isAbstract(),
			properties <- s.getSeq('Properties'),
			superType <- DSL!Classifier.allInstances()->select(c | c.name = s.getType('BaseClass'))->first()
		)
}

rule Relationship {
	from
		s : XML!Element (
			s.name = 'Relationship'
		)
	to
		t : DSL!Relationship (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			namespace <- s.getAttrVal('Namespace'),
			isLoaded <- true,
			isAbstract <- s.isAbstract(),
			isEmbedding <- s.getAttrBool('IsEmbedding'),
			properties <- s.getSeq('Properties'),
			roles <- s.getSeq('Roles'),
			superType <- DSL!Classifier.allInstances()->select(c | c.name = s.getType('BaseRelationship'))->first()
		)
}

rule Role {
	from
		s : XML!Element (
			s.name = 'Role'
		)
	to
		t : DSL!Role (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			min <- if s.hasAttr('Min') then s.getAttrVal('Min').toInteger() else 0 endif,
			max <- if s.hasAttr('Max') then s.getAttrVal('Max').toInteger() else 0 endif,
			isUnbounded <- s.getAttrBool('IsUnbounded'),
			accepts <- s.getAttrVal('Accepts'),
			isOrdered <- s.getAttrBool('IsOrdered'),
			isNavigableFrom <- s.getAttrBool('IsNavigableFrom'),
			isPropertyGenerator <- s.getAttrBool('IsPropertyGenerator'),
			source <- DSL!Classifier.allInstances()->select(c | c.name = s.getType('Source'))->first(),
			type <- DSL!Classifier.allInstances()->select(c | c.name = s.getType('Type'))->first()
		)
}

rule ValueProperty {
	from
		s : XML!Element (
			s.name = 'ValueProperty'
		)
	to
		t : DSL!ValueProperty (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			type <- thisModule.findType(s.getType('Type'))
		)
}

rule Enumeration {
	from
		s : XML!Element (
			s.name = 'Enumeration'
		)
	to
		t : DSL!Enumeration (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			namespace <- s.getAttrVal('Namespace'),
			literals <- s.getSeq('Literals')
		)
}

rule EnumerationLiteral {
	from
		s : XML!Element (
			s.name = 'EnumerationLiteral'
		)
	to
		t : DSL!EnumerationLiteral (
			name <- s.getAttrVal('Name'),
			identity <- s.getAttrVal('Id'),
			value <- if s.hasAttr('Value') then s.getAttrVal('Value').toInteger() else 0 endif
		)
}