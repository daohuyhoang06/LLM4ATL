module DSL2KM3;
create OUT : KM3 from IN : DSL;

helper context DSL!Relationship def: needTurnOnClass() : Boolean =
	not self.superType.oclIsUndefined() or self.subTypes->notEmpty() or self.properties->notEmpty() or DSL!Role.allInstances()->exists(r | r.type = self);

helper def: getRoles(c : DSL!Class) : Sequence(DSL!Role) =
	DSL!Role.allInstances()->select(r | r.source = c and not r.relation.needTurnOnClass());

helper context DSL!Role def: isEmbedding() : Boolean =
	self.relation.isEmbedding;

rule Metamodel {
	from
		s : DSL!DomainModel
	to
		t : KM3!Metamodel (
			contents <- Sequence{p, p_pt}
		),
		p : KM3!Package (
			name <- s.name,
			contents <- s.classifiers->union(s.types)
		),
		p_pt : KM3!Package (
			name <- 'PrimitiveTypes',
			contents <- Sequence{pt_b, pt_i, pt_s}
		),
		pt_b : KM3!DataType (
			name <- 'Boolean'
		),
		pt_i : KM3!DataType (
			name <- 'Integer'
		),
		pt_s : KM3!DataType (
			name <- 'String'
		)
}

rule Class {
	from
		s : DSL!Class
	to
		t : KM3!Class (
			name <- s.name,
			isAbstract <- s.isAbstract,
			supertypes <- s.superType,
			structuralFeatures <- s.properties->union(thisModule.getRoles(s))
		)
}

rule Relation2Class {
	from
		s : DSL!Relationship (
			s.needTurnOnClass()
		)
	to
		t : KM3!Class (
			name <- s.name,
			isAbstract <- s.isAbstract,
			supertypes <- s.superType,
			structuralFeatures <- s.properties->union(s.roles)
		)
}

rule SimpleReference {
	from
		s : DSL!Role (
			not s.relation.needTurnOnClass()
		)
	to
		t : KM3!Reference (
			name <- s.name,
			lower <- s.min,
			upper <- if s.isUnbounded then
				0 - 1
			else
				s.max
			endif,
			isOrdered <- s.isOrdered,
			isUnique <- true,
			type <- s.type,
			isContainer <- s.isEmbedding(),
			opposite <- s.relation.roles->select(r | r <> s)->first()
		)
}

rule ComplexReference {
	from
		s : DSL!Role (
			s.relation.needTurnOnClass()
		)
	to
		t : KM3!Reference (
			name <- s.name,
			lower <- s.min,
			upper <- if s.isUnbounded then
				0 - 1
			else
				s.max
			endif,
			isOrdered <- s.isOrdered,
			isUnique <- true,
			type <- s.type,
			isContainer <- s.isEmbedding()
		)
}

rule Attribute {
	from
		s : DSL!ValueProperty
	to
		t : KM3!Attribute (
			name <- s.name,
			lower <- 1,
			upper <- 1,
			type <- s.type
		)
}

rule Enumeration {
	from
		s : DSL!Enumeration
	to
		t : KM3!Enumeration (
			name <- s.name,
			literals <- s.literals
		)
}

rule EnumLiteral {
	from
		s : DSL!EnumerationLiteral
	to
		t : KM3!EnumLiteral (
			name <- s.name
		)
}

rule DataType {
	from
		s : DSL!SimpleType
	to
		t : KM3!DataType (
			name <- s.name
		)
}