module DSL2KM3;
create OUT : KM3 from IN : DSL;

helper context DSL!Relationship def: needTurnOnClass() : Boolean =
	not self.properties->isEmpty() or
	not self.superType.oclIsUndefined() or
	not self.subTypes->isEmpty() or
	DSL!Role.allInstances()->exists(r | r.type = self);

helper context DSL!Class def: getRoles() : Set(DSL!Role) =
	DSL!Role.allInstances()->select(r | r.source = self and not r.relation.needTurnOnClass());

helper context DSL!Role def: isEmbedding() : Boolean =
	if self.relation.isEmbedding then
		self.relation.roles->first() = self
	else
		false
	endif;

rule Metamodel {
	from
		s : DSL!DomainModel
	to
		out : KM3!Metamodel (
			contents <- Sequence{p, pt}
		),
		p : KM3!Package (
			name <- s.namespace,
			contents <- s.classifiers->union(s.types->select(t | t.oclIsKindOf(DSL!Enumeration)))
		),
		pt : KM3!Package (
			name <- 'PrimitiveTypes',
			contents <- s.types->select(t | t.oclIsKindOf(DSL!SimpleType))
		)
}

rule Class {
	from
		s : DSL!Class
	to
		out : KM3!Class (
			name <- s.name,
			isAbstract <- s.isAbstract,
			supertypes <- if s.superType.oclIsUndefined() then Sequence{} else Sequence{s.superType} endif,
			structuralFeatures <- s.properties->union(s.getRoles())
		)
}

rule Relation2Class {
	from
		s : DSL!Relationship (
			s.needTurnOnClass()
		)
	to
		out : KM3!Class (
			name <- s.name,
			isAbstract <- s.isAbstract,
			supertypes <- if s.superType.oclIsUndefined() then Sequence{} else Sequence{s.superType} endif,
			structuralFeatures <- s.properties->union(s.roles)
		)
}

rule SimpleReference {
	from
		s : DSL!Role (
			not s.relation.needTurnOnClass()
		)
	to
		out : KM3!Reference (
			name <- s.name,
			lower <- s.min,
			upper <- if s.isUnbounded then 0 - 1 else s.max endif,
			isOrdered <- s.isOrdered,
			isUnique <- true,
			isContainer <- s.isEmbedding(),
			type <- s.type,
			opposite <- s.relation.roles->select(r | r <> s)->first()
		)
}

rule ComplexReference {
	from
		s : DSL!Role (
			s.relation.needTurnOnClass()
		)
	to
		out : KM3!Reference (
			name <- s.name,
			lower <- s.min,
			upper <- if s.isUnbounded then 0 - 1 else s.max endif,
			isOrdered <- s.isOrdered,
			isUnique <- true,
			isContainer <- s.isEmbedding(),
			type <- s.type
		)
}

rule Attribute {
	from
		s : DSL!ValueProperty
	to
		out : KM3!Attribute (
			name <- s.name,
			lower <- 1,
			upper <- 1,
			isOrdered <- false,
			isUnique <- false,
			type <- s.type
		)
}

rule Enumeration {
	from
		s : DSL!Enumeration
	to
		out : KM3!Enumeration (
			name <- s.name,
			literals <- s.literals
		)
}

rule EnumLiteral {
	from
		s : DSL!EnumerationLiteral
	to
		out : KM3!EnumLiteral (
			name <- s.name
		)
}

rule DataType {
	from
		s : DSL!SimpleType
	to
		out : KM3!DataType (
			name <- s.name
		)
}