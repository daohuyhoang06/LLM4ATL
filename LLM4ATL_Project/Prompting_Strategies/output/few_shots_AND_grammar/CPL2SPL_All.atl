module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : CPL!Element =
	if self.oclIsKindOf(CPL!NodeContainer) then
		if self.contents.oclIsUndefined() then
			self
		else
			self.contents.statement
		endif
	else
		self
	endif;

helper context CPL!Element def: locations : Sequence(CPL!Location) =
	if self.oclIsKindOf(CPL!Location) then
		if self.contents.oclIsUndefined() then
			Sequence{self}
		else
			self.contents.locations->prepend(self)
		endif
	else
		if self.oclIsKindOf(CPL!NodeContainer) then
			if self.contents.oclIsUndefined() then
				Sequence{}
			else
				self.contents.locations
			endif
		else
			Sequence{}
		endif
	endif;

helper context CPL!Proxy def: isSimple() : Boolean =
	self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined() and self.redirection.oclIsUndefined() and self.failure.oclIsUndefined() and self.default.oclIsUndefined();

rule CPL2Program {
	from
		cpl : CPL!CPL
	to
		prog : SPL!Program (
			service <- service
		),
		service : SPL!Service (
			name <- 'cpl',
			declarations <- cpl.subActions,
			sessions <- Sequence{dialog}
		),
		dialog : SPL!Dialog (
			methods <- cpl.incoming
		)
}

rule SubAction2Function {
	from
		s : CPL!SubAction
	to
		f : SPL!LocalFunctionDeclaration (
			name <- s.id,
			returnType <- voidTypes,
			statements <- Sequence{s.statement}
		),
		voidTypes : SPL!SimpleType (
			type <- #void
		)
}

rule Incoming2Method {
	from
		i : CPL!Incoming
	to
		m : SPL!Method (
			type <- voidTypes,
			direction <- #"in",
			methodName <- name,
			statements <- Sequence{i.statement}
		),
		voidTypes : SPL!SimpleType (
			type <- #void
		),
		name : SPL!SIPMethodName (
			name <- #INVITE
		)
}

rule Proxy2Return {
	from
		p : CPL!Proxy (
			p.isSimple()
		)
	to
		r : SPL!ReturnStat (
			returnedValue <- fwd
		),
		fwd : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- exp
		),
		exp : SPL!SequenceConstant (
			values <- p.locations->collect(l | thisModule.Location2URIConstant(l))
		)
}

rule Proxy2Select {
	from
		p : CPL!Proxy (
			not p.isSimple()
		)
	to
		s : SPL!SelectStat (
			matchedExp <- fwd,
			selectCases <- Sequence{p.busy, p.noAnswer, p.redirection}->select(e | not e.oclIsUndefined()),
			selectDefault <- p.default
		),
		fwd : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- exp
		),
		exp : SPL!SequenceConstant (
			values <- p.locations->collect(l | thisModule.Location2URIConstant(l))
		)
}

rule Busy2SelectCase {
	from
		b : CPL!Busy
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- Sequence{b.statement}
		),
		v : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #BUSY_HERE
		)
}

rule NoAnswer2SelectCase {
	from
		n : CPL!NoAnswer
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- Sequence{n.statement}
		),
		v : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #REQUEST_TIMEOUT
		)
}

rule Redirection2SelectCase {
	from
		r : CPL!Redirection
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- Sequence{r.statement}
		),
		v : SPL!ResponseConstant (
			response <- resp
		),
		resp : SPL!RedirectionErrorResponse (
			errorKind <- #MULTIPLE_CHOICES
		)
}

rule Default2SelectDefault {
	from
		d : CPL!Default
	to
		c : SPL!SelectDefault (
			statements <- Sequence{d.statement}
		)
}

rule SubCall2Return {
	from
		s : CPL!SubCall
	to
		r : SPL!ReturnStat (
			returnedValue <- call
		),
		call : SPL!FunctionCallExp (
			functionCall <- fc
		),
		fc : SPL!FunctionCall (
			function <- CPL!SubAction.allInstances()->select(sa | sa.id = s.ref)->first()
		)
}

rule Redirect2Return {
	from
		r : CPL!Redirect
	to
		ret : SPL!ReturnStat (
			returnedValue <- with
		),
		with : SPL!WithExp (
			exp <- resp,
			msgFields <- Sequence{field}
		),
		resp : SPL!ResponseConstant (
			response <- err
		),
		err : SPL!RedirectionErrorResponse (
			errorKind <- #MOVED_TEMPORARILY
		),
		field : SPL!HeadedMessageField (
			headerId <- 'Contact',
			exp <- exp
		),
		exp : SPL!SequenceConstant (
			values <- r.locations->collect(l | thisModule.Location2URIConstant(l))
		)
}

rule AddressSwitch2SelectStat {
	from
		a : CPL!AddressSwitch
	to
		s : SPL!SelectStat (
			matchedExp <- p,
			selectCases <- a.addresses,
			selectDefault <- a.otherwise
		),
		p : SPL!SIPHeaderPlace (
			header <- if a.field = 'origin' then #FROM else #TO endif
		)
}

rule SwitchedAddress2SelectCase {
	from
		s : CPL!SwitchedAddress
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- Sequence{s.statement}
		),
		v : SPL!StringConstant (
			value <- s.is
		)
}

rule Otherwise2SelectDefault {
	from
		o : CPL!Otherwise
	to
		d : SPL!SelectDefault (
			statements <- Sequence{o.statement}
		)
}

lazy rule Location2URIConstant {
	from
		l : CPL!Location
	to
		u : SPL!URIConstant (
			uri <- l.url
		)
}