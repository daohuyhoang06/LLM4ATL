module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : CPL!Element =
	if self.oclIsKindOf(CPL!NodeContainer) then
		if self.contents.oclIsUndefined() then
			self
		else
			self.contents.statement
		endif
	else
		self
	endif;

helper context CPL!Element def: locations : Sequence(CPL!Location) =
	if self.oclIsKindOf(CPL!Location) then
		self.contents.locations->prepend(self)
	else
		if self.oclIsKindOf(CPL!NodeContainer) then
			if self.contents.oclIsUndefined() then
				Sequence {}
			else
				self.contents.locations
			endif
		else
			Sequence {}
		endif
	endif;

helper context CPL!Proxy def: isSimple : Boolean =
	self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined() and self.redirection.oclIsUndefined() and self.failure.oclIsUndefined() and self.default.oclIsUndefined();

rule CPL2Program {
	from
		c : CPL!CPL
	to
		p : SPL!Program (
			service <- s
		),
		s : SPL!Service (
			name <- 'CPLService',
			declarations <- c.subActions,
			sessions <- d
		),
		d : SPL!Dialog (
			methods <- c.incoming
		)
}

rule SubAction2Function {
	from
		s : CPL!SubAction
	to
		f : SPL!LocalFunctionDeclaration (
			name <- s.id,
			returnType <- rt,
			statements <- s.statement
		),
		rt : SPL!SimpleType (
			type <- #void
		)
}

rule Incoming2Method {
	from
		i : CPL!Incoming
	to
		m : SPL!Method (
			type <- t,
			direction <- 'in',
			methodName <- mn,
			statements <- i.statement
		),
		t : SPL!SimpleType (
			type <- #void
		),
		mn : SPL!SIPMethodName (
			name <- #INVITE
		)
}

rule Proxy2Return {
	from
		p : CPL!Proxy (
			p.isSimple
		)
	to
		r : SPL!ReturnStat (
			returnedValue <- f
		),
		f : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- l
		),
		l : SPL!SequenceConstant (
			values <- p.locations->collect(loc | thisModule.Location2URIConstant(loc))
		)
}

rule Proxy2Select {
	from
		p : CPL!Proxy (
			not p.isSimple
		)
	to
		s : SPL!SelectStat (
			matchedExp <- r,
			selectCases <- Sequence {p.busy, p.noAnswer, p.redirection}->select(e | not e.oclIsUndefined()),
			selectDefault <- p.default
		),
		r : SPL!ReasonExp
}

rule Busy2SelectCase {
	from
		b : CPL!Busy
	to
		c : SPL!SelectCase (
			values <- Sequence {v},
			statements <- b.statement
		),
		v : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #BUSY_HERE
		)
}

rule NoAnswer2SelectCase {
	from
		n : CPL!NoAnswer
	to
		c : SPL!SelectCase (
			values <- Sequence {v},
			statements <- n.statement
		),
		v : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #REQUEST_TIMEOUT
		)
}

rule Redirection2SelectCase {
	from
		r : CPL!Redirection
	to
		c : SPL!SelectCase (
			values <- Sequence {v},
			statements <- r.statement
		),
		v : SPL!ResponseConstant (
			response <- res
		),
		res : SPL!RedirectionErrorResponse (
			errorKind <- #MULTIPLE_CHOICES
		)
}

rule Default2SelectDefault {
	from
		d : CPL!Default
	to
		s : SPL!SelectDefault (
			statements <- d.statement
		)
}

rule SubCall2Return {
	from
		s : CPL!SubCall
	to
		r : SPL!ReturnStat (
			returnedValue <- c
		),
		c : SPL!FunctionCallExp (
			functionCall <- fc
		),
		fc : SPL!FunctionCall (
			function <- s.ref
		)
}

rule Redirect2Return {
	from
		r : CPL!Redirect
	to
		stat : SPL!ReturnStat (
			returnedValue <- f
		),
		f : SPL!WithExp (
			exp <- re,
			msgFields <- m
		),
		re : SPL!RedirectionErrorResponse (
			errorKind <- #MOVED_TEMPORARILY
		),
		m : SPL!HeadedMessageField (
			headerId <- 'Contact',
			exp <- l
		),
		l : SPL!SequenceConstant (
			values <- r.locations->collect(loc | thisModule.Location2URIConstant(loc))
		)
}

rule AddressSwitch2SelectStat {
	from
		a : CPL!AddressSwitch
	to
		s : SPL!SelectStat (
			matchedExp <- v,
			selectCases <- a.addresses,
			selectDefault <- a.otherwise
		),
		v : SPL!SIPHeaderPlace (
			header <- #TO
		)
}

rule SwitchedAddress2SelectCase {
	from
		a : CPL!SwitchedAddress
	to
		c : SPL!SelectCase (
			values <- Sequence {v},
			statements <- a.statement
		),
		v : SPL!StringConstant (
			value <- if not a.is.oclIsUndefined() then
					a.is
				else
					if not a.contains.oclIsUndefined() then
						a.contains
					else
						a.subDomainOf
					endif
				endif
		)
}

rule Otherwise2SelectDefault {
	from
		o : CPL!Otherwise
	to
		s : SPL!SelectDefault (
			statements <- o.statement
		)
}

lazy rule Location2URIConstant {
	from
		i : CPL!Location
	to
		o : SPL!URIConstant (
			uri <- i.url
		)
}