module Make2Ant;
create OUT : Ant from IN : Make;

rule Makefile2Project {
	from
		s : Make!Makefile
	to
		out : Ant!Project (
			name <- s.name,
			properties <- s.elements->select(e | e.oclIsKindOf(Make!Macro)),
			targets <- s.elements->select(e | e.oclIsKindOf(Make!Rule)),
			default <- s.elements->select(e | e.oclIsKindOf(Make!Rule))->first()
		)
}

rule Macro2Property {
	from
		s : Make!Macro
	to
		out : Ant!PropertyValue (
			name <- s.name,
			value <- s.value
		)
}

rule Rule2Target {
	from
		s : Make!Rule
	to
		out : Ant!Target (
			name <- s.name,
			tasks <- s.shellLines,
			depends <- s.dependencies->select(e | e.oclIsKindOf(Make!RuleDep))->collect(e | e.ruledep)
		)
}

rule ShellLine2Task_Display {
	from
		s : Make!ShellLine (
			s.display
		)
	to
		outEcho : Ant!Echo (
			message <- s.command
		),
		outExec : Ant!Exec (
			executable <- s.command
		)
}

rule ShellLine2Task_NoDisplay {
	from
		s : Make!ShellLine (
			not s.display
		)
	to
		outExec : Ant!Exec (
			executable <- s.command
		)
}