module XML2DSL;
create OUT : DSL from IN : XML;

helper def : dslElementsById : Map(String, XML!Element) =
	XML!Element.allInstances()->select(e |
		e.hasAttr('identity')
	)->iterate(e; acc : Map(String, XML!Element) = Map {} |
		acc.insert(e.getAttrVal('identity'), e)
	);

helper def : getSubTypes(id : String) : Sequence(XML!Element) =
	XML!Element.allInstances()->select(e |
		(e.name = 'Class' or e.name = 'Relationship') and e.hasAttr('superType') and e.getAttrVal('superType') = id
	);

helper def : findType(name : String) : DSL!Type =
	DSL!Type.allInstances()->select(t |
		t.name = name or t.identity = name
	)->first();

helper context XML!Element def : getAttrBool(name : String) : Boolean =
	if self.hasAttr(name) then
		self.getAttrVal(name) = 'true'
	else
		false
	endif;

helper context XML!Element def : getAttrVal(name : String) : String =
	let attr : XML!Attribute = self.children->select(c |
		c.oclIsTypeOf(XML!Attribute) and c.name = name
	)->first() in
	if attr.oclIsUndefined() then
		''
	else
		attr.value
	endif;

helper context XML!Element def : get(name : String) : XML!Element =
	self.children->select(c |
		c.oclIsTypeOf(XML!Element) and c.name = name
	)->first();

helper context XML!Element def : getType() : DSL!Type =
	if self.hasAttr('type') then
		thisModule.findType(self.getAttrVal('type'))
	else
		OclUndefined
	endif;

helper context XML!Element def : getEnumId() : String =
	if self.hasAttr('enumeration') then
		self.getAttrVal('enumeration')
	else
		''
	endif;

helper context XML!Element def : getText() : String =
	let textNode : XML!Node = self.children->select(c |
		c.oclIsTypeOf(XML!Text)
	)->first() in
	if textNode.oclIsUndefined() then
		''
	else
		textNode.value
	endif;

helper context XML!Element def : getSeq(name : String) : Sequence(XML!Element) =
	self.children->select(c |
		c.oclIsTypeOf(XML!Element) and c.name = name
	);

helper context XML!Element def : hasChildren() : Boolean =
	self.children->exists(c |
		c.oclIsTypeOf(XML!Element)
	);

helper context XML!Element def : hasAttr(name : String) : Boolean =
	self.children->exists(c |
		c.oclIsTypeOf(XML!Attribute) and c.name = name
	);

helper context XML!Element def : isAbstract() : Boolean =
	self.getAttrBool('isAbstract');

rule DomainModel {
	from
		e : XML!Element (
			e.name = 'DomainModel'
		)
	to
		out : DSL!DomainModel (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			namespace <- e.getAttrVal('namespace'),
			isLoaded <- e.getAttrBool('isLoaded'),
			classifiers <- e.getSeq('Class')->union(e.getSeq('Relationship')),
			types <- Sequence{stringType, integerType, booleanType, doubleType}->union(e.getSeq('Enumeration'))
		),
		stringType : DSL!SimpleType (
			name <- 'String',
			identity <- 'String',
			namespace <- 'System'
		),
		integerType : DSL!SimpleType (
			name <- 'Integer',
			identity <- 'Integer',
			namespace <- 'System'
		),
		booleanType : DSL!SimpleType (
			name <- 'Boolean',
			identity <- 'Boolean',
			namespace <- 'System'
		),
		doubleType : DSL!SimpleType (
			name <- 'Double',
			identity <- 'Double',
			namespace <- 'System'
		)
}

rule Class {
	from
		e : XML!Element (
			e.name = 'Class'
		)
	to
		out : DSL!Class (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			namespace <- e.getAttrVal('namespace'),
			isLoaded <- e.getAttrBool('isLoaded'),
			isAbstract <- e.isAbstract(),
			properties <- e.getSeq('ValueProperty'),
			superType <- thisModule.dslElementsById.get(e.getAttrVal('superType')),
			subTypes <- thisModule.getSubTypes(e.getAttrVal('identity'))
		)
}

rule Relationship {
	from
		e : XML!Element (
			e.name = 'Relationship'
		)
	to
		out : DSL!Relationship (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			namespace <- e.getAttrVal('namespace'),
			isLoaded <- e.getAttrBool('isLoaded'),
			isAbstract <- e.isAbstract(),
			isEmbedding <- e.getAttrBool('isEmbedding'),
			properties <- e.getSeq('ValueProperty'),
			superType <- thisModule.dslElementsById.get(e.getAttrVal('superType')),
			subTypes <- thisModule.getSubTypes(e.getAttrVal('identity')),
			roles <- e.getSeq('Role')
		)
}

rule Role {
	from
		e : XML!Element (
			e.name = 'Role'
		)
	to
		out : DSL!Role (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			min <- e.getAttrVal('min').toInteger(),
			max <- e.getAttrVal('max').toInteger(),
			isUnbounded <- e.getAttrBool('isUnbounded'),
			accepts <- e.getAttrVal('accepts'),
			isOrdered <- e.getAttrBool('isOrdered'),
			isNavigableFrom <- e.getAttrBool('isNavigableFrom'),
			isPropertyGenerator <- e.getAttrBool('isPropertyGenerator'),
			source <- thisModule.dslElementsById.get(e.getAttrVal('source')),
			type <- thisModule.dslElementsById.get(e.getAttrVal('type'))
		)
}

rule ValueProperty {
	from
		e : XML!Element (
			e.name = 'ValueProperty'
		)
	to
		out : DSL!ValueProperty (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			type <- e.getType()
		)
}

rule Enumeration {
	from
		e : XML!Element (
			e.name = 'Enumeration'
		)
	to
		out : DSL!Enumeration (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			namespace <- e.getAttrVal('namespace'),
			literals <- e.getSeq('EnumerationLiteral')
		)
}

rule EnumerationLiteral {
	from
		e : XML!Element (
			e.name = 'EnumerationLiteral'
		)
	to
		out : DSL!EnumerationLiteral (
			name <- e.getAttrVal('name'),
			identity <- e.getAttrVal('identity'),
			value <- e.getAttrVal('value').toInteger()
		)
}