module PetriNet2Grafcet;
create OUT : Grafcet from IN : PetriNet;

rule Grafcet {
	from
		n : PetriNet!PetriNet
	to
		g : Grafcet!Grafcet (
			location <- n.location,
			name <- n.name,
			elements <- n.elements,
			connections <- n.arcs
		)
}

rule Step {
	from
		n : PetriNet!Place
	to
		g : Grafcet!Step (
			location <- n.location,
			name <- n.name,
			grafcet <- n.net,
			isInitial <- false,
			isActive <- false,
			incomingConnections <- n.incomingArc,
			outgoingConnections <- n.outgoingArc
		)
}

rule Transition {
	from
		n : PetriNet!Transition
	to
		g : Grafcet!Transition (
			location <- n.location,
			name <- n.name,
			grafcet <- n.net,
			incomingConnections <- n.incomingArc,
			outgoingConnections <- n.outgoingArc
		)
}

rule StepToTransition {
	from
		n : PetriNet!PlaceToTransition
	to
		g : Grafcet!StepToTransition (
			location <- n.location,
			name <- n.name,
			grafcet <- n.net,
			from <- n.from,
			to <- n.to
		)
}

rule TransitionToStep {
	from
		n : PetriNet!TransitionToPlace
	to
		g : Grafcet!TransitionToStep (
			location <- n.location,
			name <- n.name,
			grafcet <- n.net,
			from <- n.from,
			to <- n.to
		)
}