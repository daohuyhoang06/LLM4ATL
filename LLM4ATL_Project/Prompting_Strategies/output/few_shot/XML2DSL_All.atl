module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
	let attr : XML!Attribute =
		self.children->select(c |
			c.oclIsKindOf(XML!Attribute)
		)->select(c |
			c.name = name
		)->first()
	in
		if attr.oclIsUndefined() then
			''
		else
			attr.value
		endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
	self.getAttrVal(name) = 'true';

helper context XML!Element def: hasAttr(name : String) : Boolean =
	not self.children->select(c |
		c.oclIsKindOf(XML!Attribute)
	)->select(c |
		c.name = name
	)->first().oclIsUndefined();

helper context XML!Element def: get(name : String) : XML!Element =
	self.children->select(c |
		c.oclIsKindOf(XML!Element)
	)->select(c |
		c.name = name
	)->first();

helper context XML!Element def: getType(name : String) : String =
	let elem : XML!Element =
		self.get(name)
	in
		if elem.oclIsUndefined() then
			''
		else
			elem.children->select(c |
				c.oclIsKindOf(XML!Element)
			)->first().getAttrVal('name')
		endif;

helper context XML!Element def: getEnumId(name : String) : String =
	let elem : XML!Element =
		self.get(name)
	in
		if elem.oclIsUndefined() then
			''
		else
			elem.children->select(c |
				c.oclIsKindOf(XML!Element)
			)->first().getAttrVal('id')
		endif;

helper context XML!Element def: getText() : String =
	let text : XML!Text =
		self.children->select(c |
			c.oclIsKindOf(XML!Text)
		)->first()
	in
		if text.oclIsUndefined() then
			''
		else
			text.value
		endif;

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
	let elem : XML!Element =
		self.get(name)
	in
		if elem.oclIsUndefined() then
			Sequence {}
		else
			elem.children->select(c |
				c.oclIsKindOf(XML!Element)
			)
		endif;

helper context XML!Element def: hasChildren() : Boolean =
	self.children->select(c |
		c.oclIsKindOf(XML!Element)
	)->notEmpty();

helper context XML!Element def: isAbstract() : Boolean =
	self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
	XML!Element.allInstances()->select(e |
		e.hasAttr('id')
	)->iterate(e; acc : Map(String, XML!Element) = Map {} |
		acc.insert(e.getAttrVal('id'), e)
	);

helper def: getSubTypes(id : String) : Sequence(XML!Element) =
	XML!Element.allInstances()->select(e |
		e.name = 'class' or e.name = 'relationship'
	)->select(e |
		e.hasAttr('superType') and e.getAttrVal('superType') = id
	);

helper def: findType(name : String) : DSL!Type =
	DSL!Type.allInstances()->select(t |
		t.name = name
	)->first();

rule DomainModel {
	from
		s : XML!Element (
			s.name = 'domainModel'
		)
	to
		t : DSL!DomainModel (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- true,
			classifiers <- s.getSeq('classifiers'),
			types <- Sequence {t_string, t_boolean, t_integer, t_double}->union(s.getSeq('types'))
		),
		t_string : DSL!SimpleType (
			name <- 'String',
			identity <- 'String',
			namespace <- s.getAttrVal('namespace')
		),
		t_boolean : DSL!SimpleType (
			name <- 'Boolean',
			identity <- 'Boolean',
			namespace <- s.getAttrVal('namespace')
		),
		t_integer : DSL!SimpleType (
			name <- 'Integer',
			identity <- 'Integer',
			namespace <- s.getAttrVal('namespace')
		),
		t_double : DSL!SimpleType (
			name <- 'Double',
			identity <- 'Double',
			namespace <- s.getAttrVal('namespace')
		)
}

rule Class {
	from
		s : XML!Element (
			s.name = 'class'
		)
	to
		t : DSL!Class (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- true,
			isAbstract <- s.isAbstract(),
			properties <- s.getSeq('properties'),
			superType <- if s.hasAttr('superType') then
				thisModule.dslElementsById.get(s.getAttrVal('superType'))
			else
				OclUndefined
			endif,
			subTypes <- thisModule.getSubTypes(s.getAttrVal('id'))
		)
}

rule Relationship {
	from
		s : XML!Element (
			s.name = 'relationship'
		)
	to
		t : DSL!Relationship (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- true,
			isAbstract <- s.isAbstract(),
			isEmbedding <- s.getAttrBool('isEmbedding'),
			properties <- s.getSeq('properties'),
			roles <- s.getSeq('roles'),
			superType <- if s.hasAttr('superType') then
				thisModule.dslElementsById.get(s.getAttrVal('superType'))
			else
				OclUndefined
			endif,
			subTypes <- thisModule.getSubTypes(s.getAttrVal('id'))
		)
}

rule Role {
	from
		s : XML!Element (
			s.name = 'role'
		)
	to
		t : DSL!Role (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			min <- s.getAttrVal('min').toInteger(),
			max <- s.getAttrVal('max').toInteger(),
			isUnbounded <- s.getAttrBool('isUnbounded'),
			accepts <- s.getAttrVal('accepts'),
			isOrdered <- s.getAttrBool('isOrdered'),
			isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
			isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
			source <- thisModule.dslElementsById.get(s.getAttrVal('source')),
			type <- thisModule.dslElementsById.get(s.getAttrVal('type'))
		)
}

rule ValueProperty {
	from
		s : XML!Element (
			s.name = 'valueProperty'
		)
	to
		t : DSL!ValueProperty (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			type <- thisModule.findType(s.getType('type'))
		)
}

rule Enumeration {
	from
		s : XML!Element (
			s.name = 'enumeration'
		)
	to
		t : DSL!Enumeration (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			literals <- s.getSeq('literals')
		)
}

rule EnumerationLiteral {
	from
		s : XML!Element (
			s.name = 'enumerationLiteral'
		)
	to
		t : DSL!EnumerationLiteral (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			value <- s.getAttrVal('value').toInteger()
		)
}