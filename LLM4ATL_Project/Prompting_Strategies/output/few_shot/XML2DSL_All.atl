module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: hasAttr(name : String) : Boolean =
	not self.children->select(c | c.oclIsTypeOf(XML!Attribute))->detect(c | c.name = name).oclIsUndefined();

helper context XML!Element def: getAttrVal(name : String) : String =
	let attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute))->detect(c | c.name = name) in
	if attr.oclIsUndefined() then
		''
	else
		attr.value
	endif;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
	if self.hasAttr(name) then
		self.getAttrVal(name) = 'true'
	else
		false
	endif;

helper context XML!Element def: get(name : String) : XML!Element =
	self.children->select(c | c.oclIsTypeOf(XML!Element))->detect(c | c.name = name);

helper context XML!Element def: getType() : String =
	if self.hasAttr('type') then
		self.getAttrVal('type')
	else
		if not self.get('type').oclIsUndefined() then
			self.get('type').getAttrVal('name')
		else
			''
		endif
	endif;

helper context XML!Element def: getEnumId() : String =
	if self.hasAttr('enum') then
		self.getAttrVal('enum')
	else
		if self.hasAttr('type') then
			self.getAttrVal('type')
		else
			''
		endif
	endif;

helper context XML!Element def: getText() : String =
	let t : XML!Text = self.children->select(c | c.oclIsTypeOf(XML!Text))->first() in
	if t.oclIsUndefined() then
		''
	else
		t.value
	endif;

helper context XML!Element def: getSeq(name : String) : Sequence(XML!Element) =
	let child : XML!Element = self.get(name) in
	if child.oclIsUndefined() then
		self.children->select(c | c.oclIsTypeOf(XML!Element) and c.name = name)
	else
		if child.children->select(c | c.oclIsTypeOf(XML!Element))->isEmpty() then
			self.children->select(c | c.oclIsTypeOf(XML!Element) and c.name = name)
		else
			child.children->select(c | c.oclIsTypeOf(XML!Element))
		endif
	endif;

helper context XML!Element def: hasChildren() : Boolean =
	self.children->exists(c | c.oclIsTypeOf(XML!Element));

helper context XML!Element def: isAbstract() : Boolean =
	self.getAttrBool('isAbstract');

helper def: dslElementsById : Map(String, XML!Element) =
	XML!Element.allInstances()->inject(
		Map{},
		(acc, e) |
			if e.hasAttr('id') then
				acc.insert(e.getAttrVal('id'), e)
			else
				acc
			endif
	);

helper def: getSubTypes(id : String) : Sequence(XML!Element) =
	XML!Element.allInstances()->select(e |
		(e.name = 'Class' or e.name = 'Relationship') and
		e.hasAttr('superType') and
		e.getAttrVal('superType') = id
	);

helper def: findType(name : String) : DSL!Type =
	DSL!Type.allInstances()->detect(t | t.name = name or t.identity = name);

rule DomainModel {
	from
		s : XML!Element (
			s.name = 'DomainModel'
		)
	to
		t : DSL!DomainModel (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- true,
			classifiers <- s.getSeq('Classifiers')->union(s.getSeq('Classes'))->union(s.getSeq('Relationships')),
			types <- Sequence{st1, st2, st3, st4}->union(s.getSeq('Types'))->union(s.getSeq('Enumerations'))
		),
		st1 : DSL!SimpleType (
			name <- 'String',
			identity <- 'String',
			namespace <- s.getAttrVal('namespace')
		),
		st2 : DSL!SimpleType (
			name <- 'Boolean',
			identity <- 'Boolean',
			namespace <- s.getAttrVal('namespace')
		),
		st3 : DSL!SimpleType (
			name <- 'Integer',
			identity <- 'Integer',
			namespace <- s.getAttrVal('namespace')
		),
		st4 : DSL!SimpleType (
			name <- 'Double',
			identity <- 'Double',
			namespace <- s.getAttrVal('namespace')
		)
}

rule Class {
	from
		s : XML!Element (
			s.name = 'Class'
		)
	to
		t : DSL!Class (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- true,
			isAbstract <- s.isAbstract(),
			properties <- s.getSeq('Properties')->union(s.getSeq('ValueProperty')),
			superType <- if s.hasAttr('superType') then
							let stId : String = s.getAttrVal('superType') in
							let stElem : XML!Element = thisModule.dslElementsById.get(stId) in
							if stElem.oclIsUndefined() then
								XML!Element.allInstances()->detect(e | (e.name = 'Class' or e.name = 'Relationship') and e.getAttrVal('name') = stId)
							else
								stElem
							endif
						 else
							OclUndefined
						 endif,
			subTypes <- thisModule.getSubTypes(s.getAttrVal('id'))
		)
}

rule Relationship {
	from
		s : XML!Element (
			s.name = 'Relationship' or s.name = 'DomainRelationship'
		)
	to
		t : DSL!Relationship (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			isLoaded <- true,
			isAbstract <- s.isAbstract(),
			isEmbedding <- s.getAttrBool('isEmbedding'),
			properties <- s.getSeq('Properties')->union(s.getSeq('ValueProperty')),
			superType <- if s.hasAttr('superType') then
							let stId : String = s.getAttrVal('superType') in
							let stElem : XML!Element = thisModule.dslElementsById.get(stId) in
							if stElem.oclIsUndefined() then
								XML!Element.allInstances()->detect(e | (e.name = 'Class' or e.name = 'Relationship') and e.getAttrVal('name') = stId)
							else
								stElem
							endif
						 else
							OclUndefined
						 endif,
			subTypes <- thisModule.getSubTypes(s.getAttrVal('id')),
			roles <- s.getSeq('Roles')->union(s.getSeq('Role'))
		)
}

rule Role {
	from
		s : XML!Element (
			s.name = 'Role' or s.name = 'DomainRole'
		)
	to
		t : DSL!Role (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			min <- if s.hasAttr('min') then s.getAttrVal('min').toInteger() else 0 endif,
			max <- if s.hasAttr('max') then s.getAttrVal('max').toInteger() else 1 endif,
			isUnbounded <- s.getAttrBool('isUnbounded'),
			accepts <- s.getAttrVal('accepts'),
			isOrdered <- s.getAttrBool('isOrdered'),
			isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
			isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
			source <- if s.hasAttr('source') then
						let srcId : String = s.getAttrVal('source') in
						let srcElem : XML!Element = thisModule.dslElementsById.get(srcId) in
						if srcElem.oclIsUndefined() then
							XML!Element.allInstances()->detect(e | (e.name = 'Class' or e.name = 'Relationship') and e.getAttrVal('name') = srcId)
						else
							srcElem
						endif
					  else
						OclUndefined
					  endif,
			type <- if s.hasAttr('type') then
						let typeId : String = s.getAttrVal('type') in
						let typeElem : XML!Element = thisModule.dslElementsById.get(typeId) in
						if typeElem.oclIsUndefined() then
							XML!Element.allInstances()->detect(e | (e.name = 'Class' or e.name = 'Relationship') and e.getAttrVal('name') = typeId)
						else
							typeElem
						endif
					else
						OclUndefined
					endif
		)
}

rule ValueProperty {
	from
		s : XML!Element (
			s.name = 'ValueProperty' or s.name = 'Property'
		)
	to
		t : DSL!ValueProperty (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			type <- thisModule.findType(s.getType())
		)
}

rule Enumeration {
	from
		s : XML!Element (
			s.name = 'Enumeration'
		)
	to
		t : DSL!Enumeration (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			namespace <- s.getAttrVal('namespace'),
			literals <- s.getSeq('Literals')->union(s.getSeq('EnumerationLiteral'))
		)
}

rule EnumerationLiteral {
	from
		s : XML!Element (
			s.name = 'EnumerationLiteral' or s.name = 'Literal'
		)
	to
		t : DSL!EnumerationLiteral (
			name <- s.getAttrVal('name'),
			identity <- s.getAttrVal('id'),
			value <- if s.hasAttr('value') then s.getAttrVal('value').toInteger() else 0 endif
		)
}