module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : CPL!Element =
	if self.oclIsKindOf(CPL!NodeContainer) then
		if self.contents.oclIsUndefined() then
			self
		else
			self.contents.statement
		endif
	else
		self
	endif;

helper context CPL!Element def: locations : Sequence(CPL!Location) =
	if self.oclIsKindOf(CPL!Location) then
		if self.contents.oclIsUndefined() then
			Sequence{self}
		else
			self.contents.locations->prepend(self)
		endif
	else
		if self.oclIsKindOf(CPL!NodeContainer) then
			if self.contents.oclIsUndefined() then
				Sequence{}
			else
				self.contents.locations
			endif
		else
			Sequence{}
		endif
	endif;

helper context CPL!Proxy def: isSimple : Boolean =
	self.busy.oclIsUndefined() and
	self.noAnswer.oclIsUndefined() and
	self.redirection.oclIsUndefined() and
	self.failure.oclIsUndefined() and
	self.default.oclIsUndefined();

rule CPL2Program {
	from
		c : CPL!CPL
	to
		p : SPL!Program (
			service <- s
		),
		s : SPL!Service (
			name <- 'cpl',
			declarations <- c.subActions,
			sessions <- c.incoming
		)
}

rule SubAction2Function {
	from
		s : CPL!SubAction
	to
		f : SPL!LocalFunctionDeclaration (
			name <- s.id,
			returnType <- rt,
			statements <- s.statement
		),
		rt : SPL!SimpleType (
			type <- #void
		)
}

rule Incoming2Method {
	from
		i : CPL!Incoming
	to
		d : SPL!Dialog (
			methods <- Sequence{m}
		),
		m : SPL!Method (
			type <- t,
			direction <- #"in",
			methodName <- mn,
			statements <- i.statement
		),
		t : SPL!SimpleType (
			type <- #response
		),
		mn : SPL!SIPMethodName (
			name <- #INVITE
		)
}

rule Proxy2Return {
	from
		p : CPL!Proxy (
			p.isSimple
		)
	to
		r : SPL!ReturnStat (
			returnedValue <- f
		),
		f : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- if p.locations->size() = 1 then
						thisModule.Location2URIConstant(p.locations->first())
				   else
						seq
				   endif
		),
		seq : SPL!SequenceConstant (
			values <- p.locations->collect(l | thisModule.Location2URIConstant(l))
		)
}

rule Proxy2Select {
	from
		p : CPL!Proxy (
			not p.isSimple
		)
	to
		s : SPL!SelectStat (
			matchedExp <- f,
			selectCases <- Sequence{p.busy, p.noAnswer, p.redirection}->reject(e | e.oclIsUndefined()),
			selectDefault <- p.default
		),
		f : SPL!ForwardExp (
			isParallel <- p.ordering = 'parallel',
			exp <- if p.locations->size() = 1 then
						thisModule.Location2URIConstant(p.locations->first())
				   else
						seq
				   endif
		),
		seq : SPL!SequenceConstant (
			values <- p.locations->collect(l | thisModule.Location2URIConstant(l))
		)
}

rule Busy2SelectCase {
	from
		b : CPL!Busy
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- b.statement
		),
		v : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #BUSY_HERE
		)
}

rule NoAnswer2SelectCase {
	from
		n : CPL!NoAnswer
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- n.statement
		),
		v : SPL!ResponseConstant (
			response <- r
		),
		r : SPL!ClientErrorResponse (
			errorKind <- #REQUEST_TIMEOUT
		)
}

rule Redirection2SelectCase {
	from
		r : CPL!Redirection
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- r.statement
		),
		v : SPL!ResponseConstant (
			response <- res
		),
		res : SPL!RedirectionErrorResponse (
			errorKind <- #MOVED_TEMPORARILY
		)
}

rule Default2SelectDefault {
	from
		d : CPL!Default
	to
		c : SPL!SelectDefault (
			statements <- d.statement
		)
}

rule SubCall2Return {
	from
		s : CPL!SubCall
	to
		r : SPL!ReturnStat (
			returnedValue <- c
		),
		c : SPL!FunctionCallExp (
			functionCall <- fc
		),
		fc : SPL!FunctionCall (
			function <- CPL!SubAction.allInstances()->select(e | e.id = s.ref)->first()
		)
}

rule Redirect2Return {
	from
		r : CPL!Redirect
	to
		s : SPL!ReturnStat (
			returnedValue <- w
		),
		w : SPL!WithExp (
			exp <- if r.permanent = 'true' then
						p
				   else
						t
				   endif,
			msgFields <- Sequence{m}
		),
		p : SPL!ConstantExp (
			value <- pr
		),
		pr : SPL!ResponseConstant (
			response <- prr
		),
		prr : SPL!RedirectionErrorResponse (
			errorKind <- #MOVED_PERMANENTLY
		),
		t : SPL!ConstantExp (
			value <- tr
		),
		tr : SPL!ResponseConstant (
			response <- trr
		),
		trr : SPL!RedirectionErrorResponse (
			errorKind <- #MOVED_TEMPORARILY
		),
		m : SPL!HeadedMessageField (
			headerId <- 'Contact',
			exp <- if r.locations->size() = 1 then
						thisModule.Location2URIConstant(r.locations->first())
				   else
						seq
				   endif
		),
		seq : SPL!SequenceConstant (
			values <- r.locations->collect(l | thisModule.Location2URIConstant(l))
		)
}

rule AddressSwitch2SelectStat {
	from
		a : CPL!AddressSwitch
	to
		s : SPL!SelectStat (
			matchedExp <- v,
			selectCases <- a.addresses,
			selectDefault <- a.otherwise
		),
		v : SPL!SIPHeaderPlace (
			header <- if a.field = 'destination' then
						#TO
					  else
						#FROM
					  endif
		)
}

rule SwitchedAddress2SelectCase {
	from
		a : CPL!SwitchedAddress
	to
		c : SPL!SelectCase (
			values <- Sequence{v},
			statements <- a.statement
		),
		v : SPL!URIConstant (
			uri <- if not a.is.oclIsUndefined() then
						a.is
				   else
						if not a.contains.oclIsUndefined() then
							a.contains
						else
							a.subDomainOf
						endif
				   endif
		)
}

rule Otherwise2SelectDefault {
	from
		o : CPL!Otherwise
	to
		c : SPL!SelectDefault (
			statements <- o.statement
		)
}

lazy rule Location2URIConstant {
	from
		l : CPL!Location
	to
		u : SPL!URIConstant (
			uri <- l.url
		)
}