module PetriNet2Grafcet;
create OUT : Grafcet from IN : PetriNet;

rule Grafcet {
	from
		pn : PetriNet!PetriNet
	to
		g : Grafcet!Grafcet (
			location <- pn.location,
			name <- pn.name,
			elements <- pn.elements,
			connections <- pn.arcs
		)
}

rule Step {
	from
		p : PetriNet!Place
	to
		s : Grafcet!Step (
			location <- p.location,
			name <- p.name,
			isInitial <- false,
			isActive <- false,
			grafcet <- p.net,
			incomingConnections <- p.incomingArc,
			outgoingConnections <- p.outgoingArc
		)
}

rule Transition {
	from
		t : PetriNet!Transition
	to
		gt : Grafcet!Transition (
			location <- t.location,
			name <- t.name,
			grafcet <- t.net,
			incomingConnections <- t.incomingArc,
			outgoingConnections <- t.outgoingArc
		)
}

rule StepToTransition {
	from
		p2t : PetriNet!PlaceToTransition
	to
		s2t : Grafcet!StepToTransition (
			location <- p2t.location,
			name <- p2t.name,
			grafcet <- p2t.net,
			from <- p2t.from,
			to <- p2t.to
		)
}

rule TransitionToStep {
	from

		t2p : PetriNet!TransitionToPlace
	to
		t2s : Grafcet!TransitionToStep (
			location <- t2p.location,
			name <- t2p.name,
			grafcet <- t2p.net,
			from <- t2p.from,
			to <- t2p.to
		)
}