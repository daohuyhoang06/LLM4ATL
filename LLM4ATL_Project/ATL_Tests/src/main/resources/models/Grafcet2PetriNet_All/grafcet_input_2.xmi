<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="MissingOutgoing" location="counterexample">
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="S1" location="counterexample"
        isInitial="true" isActive="true" action="noop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T1" location="counterexample" condition="true"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="S1ToT1"
        location="counterexample" from="s1" to="t1"/>
  </Grafcet:Grafcet>
</xmi:XMI>
