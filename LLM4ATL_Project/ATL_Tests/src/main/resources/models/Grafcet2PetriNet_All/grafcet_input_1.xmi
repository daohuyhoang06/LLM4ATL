<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="MissingIncoming" location="counterexample">
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T1" location="counterexample" condition="true"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="S1" location="counterexample"
        isInitial="false" isActive="false" action="noop"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c1" name="T1ToS1"
        location="counterexample" from="t1" to="s1"/>
  </Grafcet:Grafcet>
</xmi:XMI>
