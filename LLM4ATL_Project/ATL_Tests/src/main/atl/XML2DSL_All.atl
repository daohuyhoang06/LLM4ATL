module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
    self.children->XML!Node(c | (c.name = name))->XML!Node(c | c.value)->asBag()->sum();

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    (self.getAttrVal(name) = 'true');

helper context XML!Element def: get(name : String) : OclAny =
    self.children->XML!Node(c | (c.name = name));

helper context XML!Element def: getType() : String =
    self.getAttrVal('type');

helper context XML!Element def: getEnumId() : String =
    self.getAttrVal('enumId');

helper context XML!Element def: getText() : String =
    self.children->XML!Node(c | c.value)->asBag()->sum();

helper context XML!Element def: getSeq(name : String) : OclAny =
    self.children->XML!Node(c | (c.name = name));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.children->XML!Node(c | (c.name = name))->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->XML!Node(c | (c.name = name))->notEmpty();

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById(id : String) : OclAny =
    XML!Element.allInstances()->XML!Element(e | (e.getAttrVal('identity') = id));

helper def: getSubTypes(classifierName : String) : OclAny =
    XML!Element.allInstances()->XML!Element(e | (((e.name = 'Class') or (e.name = 'Relationship')) and (e.getAttrVal('superType') = classifierName)));

helper def: findType(name : String) : OclAny =
    if (name = 'String') then
        XML!Element.allInstances()->XML!Element(e | (e.name = 'DomainModel'))->XML!Element(e | thisModule.resolveTemp(e, 'stringType'))
    else
        if (name = 'Integer') then
        XML!Element.allInstances()->XML!Element(e | (e.name = 'DomainModel'))->XML!Element(e | thisModule.resolveTemp(e, 'integerType'))
    else
        if (name = 'Boolean') then
        XML!Element.allInstances()->XML!Element(e | (e.name = 'DomainModel'))->XML!Element(e | thisModule.resolveTemp(e, 'booleanType'))
    else
        if (name = 'Real') then
        XML!Element.allInstances()->XML!Element(e | (e.name = 'DomainModel'))->XML!Element(e | thisModule.resolveTemp(e, 'realType'))
    else
        XML!Element.allInstances()->XML!Element(e | ((e.name = 'Enumeration') and (e.getAttrVal('name') = name)))
    endif
    endif
    endif
    endif;

rule DomainModel {
    from
        self : XML!Element (
            (self.name = 'DomainModel')
        )
    to
        t : DSL!DomainModel (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            namespace <- self.getAttrVal('namespace'),
            isLoaded <- self.getAttrBool('isLoaded'),
            types <- self.children->XML!Node(c | (c.name = 'Enumeration'))->union(Set{stringType, integerType, booleanType, realType}),
            classifiers <- self.children->XML!Node(c | ((c.name = 'Class') or (c.name = 'Relationship')))
        ),
        stringType : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- 'PrimitiveTypes'
        ),
        integerType : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- 'PrimitiveTypes'
        ),
        booleanType : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- 'PrimitiveTypes'
        ),
        realType : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- 'PrimitiveTypes'
        )
}

rule Class {
    from
        self : XML!Element (
            (self.name = 'Class')
        )
    to
        t : DSL!Class (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            namespace <- self.getAttrVal('namespace'),
            isLoaded <- self.getAttrBool('isLoaded'),
            isAbstract <- self.getAttrBool('isAbstract'),
            domainModel <- self.parent,
            properties <- self.children->XML!Node(c | (c.name = 'ValueProperty')),
            superType <- thisModule.dslElementsById(self.getAttrVal('superType'))
        )
}

rule Relationship {
    from
        self : XML!Element (
            (self.name = 'Relationship')
        )
    to
        t : DSL!Relationship (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            namespace <- self.getAttrVal('namespace'),
            isLoaded <- self.getAttrBool('isLoaded'),
            isAbstract <- self.getAttrBool('isAbstract'),
            isEmbedding <- self.getAttrBool('isEmbedding'),
            domainModel <- self.parent,
            properties <- self.children->XML!Node(c | (c.name = 'ValueProperty')),
            superType <- thisModule.dslElementsById(self.getAttrVal('superType')),
            roles <- self.children->XML!Node(c | (c.name = 'Role'))
        )
}

rule Role {
    from
        self : XML!Element (
            (self.name = 'Role')
        )
    to
        t : DSL!Role (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            min <- self.getAttrVal('min').toInteger(),
            max <- self.getAttrVal('max').toInteger(),
            isUnbounded <- self.getAttrBool('isUnbounded'),
            accepts <- self.getAttrVal('accepts'),
            isOrdered <- self.getAttrBool('isOrdered'),
            isNavigableFrom <- self.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- self.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById(self.getAttrVal('source')),
            type <- thisModule.dslElementsById(self.getAttrVal('type')),
            relation <- self.parent
        )
}

rule ValueProperty {
    from
        self : XML!Element (
            (self.name = 'ValueProperty')
        )
    to
        t : DSL!ValueProperty (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            owner <- self.parent,
            type <- thisModule.findType(self.getAttrVal('type'))
        )
}

rule Enumeration {
    from
        self : XML!Element (
            (self.name = 'Enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            namespace <- self.getAttrVal('namespace'),
            literals <- self.children->XML!Node(c | (c.name = 'EnumerationLiteral'))
        )
}

rule EnumerationLiteral {
    from
        self : XML!Element (
            (self.name = 'EnumerationLiteral')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            value <- self.getAttrVal('value').toInteger()
        )
}

