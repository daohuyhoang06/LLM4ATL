module AmaltheaToAscet_All;
create OUT : ASCET from IN : AMALTHEA;

rule ComponentContainer2AscetModule {
    from
        s : AMALTHEA!ComponentContainer
    to
        t : ASCET!AscetModule (
            tasks <- s.tasks->collect(tsk |
                thisModule.Task2SoftwareTask(tsk)
            )
        )
}

rule TaskRoot2SoftwareTask {
    from
        s : AMALTHEA!Task (
            AMALTHEA!ComponentContainer.allInstances()
                ->collect(cc | cc.tasks)
                ->excludes(s)
        )
    to
        t : ASCET!SoftwareTask (
            name <- s.name
        )
}

lazy rule Task2SoftwareTask {
    from
        s : AMALTHEA!Task
    to
        t : ASCET!SoftwareTask (
            name <- s.name
        )
}