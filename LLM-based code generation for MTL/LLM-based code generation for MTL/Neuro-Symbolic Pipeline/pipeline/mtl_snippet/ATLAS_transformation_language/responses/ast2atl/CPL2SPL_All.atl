module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement : CPL!Element =
    if self.oclIsTypeOf(CPL!CPL) then
        if self.incoming.oclIsUndefined() then
        self
    else
        self.incoming.statement
    endif
    else
        if self.oclIsKindOf(CPL!NodeContainer) then
        if self.contents.oclIsUndefined() then
        self
    else
        self.contents.statement
    endif
    else
        self
    endif
    endif;

helper context CPL!Element def: locations : Set(CPL!Location) =
    if self.refImmediateComposite() then
        if self.refImmediateComposite().oclIsTypeOf(CPL!Location) then
        Set{self.refImmediateComposite()}->union(self.refImmediateComposite().locations)
    else
        self.refImmediateComposite().locations
    endif
    else
        Set{}
    endif;

helper context CPL!Proxy def: isSimple : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        s : CPL!CPL
    to
        t : SPL!Program (
            service <- s_service
        ),
        s_service : SPL!Service (
            name <- 'CPL Service',
            declarations <- s.subActions,
            sessions <- s_session
        ),
        s_session : SPL!Dialog (
            methods <- if s.incoming.oclIsUndefined() then
    Set{}
else
    s.incoming->asSet()
endif->union(if s.outgoing.oclIsUndefined() then
    Set{}
else
    s.outgoing->asSet()
endif)
        )
}

rule SubAction2Function {
    from
        s : CPL!SubAction
    to
        t : SPL!LocalFunctionDeclaration (
            name <- s.id,
            returnType <- rt,
            statements <- Set{s.statement}
        ),
        rt : SPL!SimpleType (
            type <- '#void'
        )
}

rule Incoming2Method {
    from
        s : CPL!Incoming
    to
        t : SPL!Method (
            type <- s_type,
            direction <- '#in',
            methodName <- s_methodName,
            statements <- Set{s.statement}
        ),
        s_type : SPL!SimpleType (
            type <- '#void'
        ),
        s_methodName : SPL!SIPMethodName (
            name <- '#INVITE'
        )
}

rule Proxy2Return {
    from
        s : CPL!Proxy (
            s.isSimple
        )
    to
        t : SPL!ReturnStat (
            returnedValue <- fe
        ),
        fe : SPL!ForwardExp (
            isParallel <- (s.ordering = 'parallel'),
            exp <- if s.locations->isEmpty() then
    None
else
    thisModule.Proxy2ConstantExp(s)
endif
        )
}

rule Proxy2Select {
    from
        s : CPL!Proxy (
            not s.isSimple
        )
    to
        t : SPL!SelectStat (
            matchedExp <- me,
            selectCases <- Set{s.busy, s.noAnswer, s.redirection}->reject(x | x.oclIsUndefined()),
            selectDefault <- s.default
        ),
        me : SPL!BODYExp (
        )
}

rule Busy2SelectCase {
    from
        s : CPL!Busy
    to
        t : SPL!SelectCase (
            values <- Set{rc},
            statements <- Set{s.statement}
        ),
        rc : SPL!ResponseConstant (
            response <- cer
        ),
        cer : SPL!ClientErrorResponse (
            errorKind <- '#BUSY_HERE'
        )
}

rule NoAnswer2SelectCase {
    from
        s : CPL!NoAnswer
    to
        t : SPL!SelectCase (
            values <- Set{rc},
            statements <- Set{s.statement}
        ),
        rc : SPL!ResponseConstant (
            response <- cer
        ),
        cer : SPL!ClientErrorResponse (
            errorKind <- '#REQUEST_TIMEOUT'
        )
}

rule Redirection2SelectCase {
    from
        s : CPL!Redirection
    to
        t : SPL!SelectCase (
            values <- Set{rc},
            statements <- Set{s.statement}
        ),
        rc : SPL!ResponseConstant (
            response <- rer
        ),
        rer : SPL!RedirectionErrorResponse (
            errorKind <- '#MULTIPLE_CHOICES'
        )
}

rule Default2SelectDefault {
    from
        s : CPL!Default
    to
        t : SPL!SelectDefault (
            statements <- Set{s.statement}
        )
}

rule SubCall2Return {
    from
        s : CPL!SubCall
    to
        t : SPL!ReturnStat (
            returnedValue <- fce
        ),
        fce : SPL!FunctionCallExp (
            functionCall <- fc
        ),
        fc : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->select(sa | (sa.id = s.ref))
        )
}

rule Redirect2Return {
    from
        s : CPL!Redirect
    to
        t : SPL!ReturnStat (
            returnedValue <- fwe
        ),
        fwe : SPL!ForwardExp (
            isParallel <- false,
            exp <- ce
        ),
        ce : SPL!ConstantExp (
            value <- rc
        ),
        rc : SPL!ResponseConstant (
            response <- rer
        ),
        rer : SPL!RedirectionErrorResponse (
            errorKind <- if (s.permanent = 'true') then
    '#MOVED_PERMANENTLY'
else
    '#MOVED_TEMPORARILY'
endif
        )
}

rule AddressSwitch2SelectStat {
    from
        s : CPL!AddressSwitch
    to
        t : SPL!SelectStat (
            matchedExp <- if s.subField.oclIsUndefined() then
    hp
else
    pcp
endif,
            selectCases <- s.addresses,
            selectDefault <- s.otherwise
        ),
        hp : SPL!SIPHeaderPlace (
            header <- if (s.field = 'to') then
    '#TO'
else
    '#FROM'
endif
        ),
        pcp : SPL!PropertyCallPlace (
            propName <- s.subField,
            source <- hp2
        ),
        hp2 : SPL!SIPHeaderPlace (
            header <- if (s.field = 'to') then
    '#TO'
else
    '#FROM'
endif
        )
}

rule SwitchedAddress2SelectCase {
    from
        s : CPL!SwitchedAddress
    to
        t : SPL!SelectCase (
            values <- Set{uc},
            statements <- Set{s.statement}
        ),
        uc : SPL!URIConstant (
            uri <- if not s.is.oclIsUndefined() then
    s.is
else
    if not s.contains.oclIsUndefined() then
    s.contains
else
    s.subDomainOf
endif
endif
        )
}

rule Otherwise2SelectDefault {
    from
        s : CPL!Otherwise
    to
        t : SPL!SelectDefault (
            statements <- Set{s.statement}
        )
}

lazy rule Location2URIConstant {
    from
        s : CPL!Location
    to
        t : SPL!URIConstant (
            uri <- s.url
        )
}

lazy rule Proxy2ConstantExp {
    from
        s : CPL!Proxy
    to
        t : SPL!ConstantExp (
            value <- sc
        ),
        sc : SPL!SequenceConstant (
            values <- s.locations->collect(l | thisModule.Location2URIConstant(l))
        )
}

