module CPL2SPL;
create OUT : SPL from IN : CPL;

helper context CPL!Element def: statement() : CPL!Element =
    if self.oclIsKindOf(CPL!NodeContainer) then
        if self.oclAsType(CPL!NodeContainer).contents.oclIsUndefined() then
        self
    else
        self.oclAsType(CPL!NodeContainer).contents.statement
    endif
    else
        self
    endif;

helper context CPL!Element def: locations() : Set(CPL!Location) =
    if self.oclIsKindOf(CPL!Location) then
        Set{self.oclAsType(CPL!Location)}->union(if self.oclAsType(CPL!NodeContainer).contents.oclIsUndefined() then
        CPL!Location.allInstances()->CPL!Location(x | false)
    else
        self.oclAsType(CPL!NodeContainer).contents.locations
    endif)
    else
        if self.oclIsKindOf(CPL!NodeContainer) then
        if self.oclAsType(CPL!NodeContainer).contents.oclIsUndefined() then
        CPL!Location.allInstances()->CPL!Location(x | false)
    else
        self.oclAsType(CPL!NodeContainer).contents.locations
    endif
    else
        CPL!Location.allInstances()->CPL!Location(x | false)
    endif
    endif;

helper context CPL!Proxy def: isSimple : Boolean =
    ((((self.busy.oclIsUndefined() and self.noAnswer.oclIsUndefined()) and self.redirection.oclIsUndefined()) and self.failure.oclIsUndefined()) and self.default.oclIsUndefined());

rule CPL2Program {
    from
        c : CPL!CPL
    to
        p : SPL!Program (
            service <- s
        ),
        s : SPL!Service (
            name <- 'CPL',
            declarations <- c.subActions,
            sessions <- c.incoming
        )
}

rule SubAction2Function {
    from
        c : CPL!SubAction
    to
        f : SPL!LocalFunctionDeclaration (
            name <- c.id,
            returnType <- rt,
            statements <- c.statement
        ),
        rt : SPL!SimpleType (
            type <- #void
        )
}

rule Incoming2Method {
    from
        c : CPL!Incoming
    to
        m : SPL!Method (
            type <- t,
            direction <- #in,
            methodName <- mn,
            statements <- c.statement
        ),
        t : SPL!SimpleType (
            type <- #void
        ),
        mn : SPL!SIPMethodName (
            name <- #INVITE
        )
}

rule Proxy2Return {
    from
        c : CPL!Proxy (
            c.isSimple
        )
    to
        r : SPL!ReturnStat (
            returnedValue <- fe
        ),
        fe : SPL!ForwardExp (
            isParallel <- (c.ordering = 'parallel')
        )
}

rule Proxy2Select {
    from
        c : CPL!Proxy (
            not c.isSimple
        )
    to
        s : SPL!SelectStat (
            matchedExp <- fe,
            selectCases <- Set{c.busy, c.noAnswer, c.redirection, c.failure}->CPL!NodeContainer(x | not x.oclIsUndefined()),
            selectDefault <- c.default
        ),
        fe : SPL!ForwardExp (
            isParallel <- (c.ordering = 'parallel')
        )
}

rule Busy2SelectCase {
    from
        c : CPL!Busy
    to
        sc : SPL!SelectCase (
            values <- rc,
            statements <- c.statement
        ),
        rc : SPL!ResponseConstant (
            response <- cer
        ),
        cer : SPL!ClientErrorResponse (
            errorKind <- #BUSY_HERE
        )
}

rule NoAnswer2SelectCase {
    from
        c : CPL!NoAnswer
    to
        sc : SPL!SelectCase (
            values <- rc,
            statements <- c.statement
        ),
        rc : SPL!ResponseConstant (
            response <- cer
        ),
        cer : SPL!ClientErrorResponse (
            errorKind <- #REQUEST_TIMEOUT
        )
}

rule Redirection2SelectCase {
    from
        c : CPL!Redirection
    to
        sc : SPL!SelectCase (
            values <- rc,
            statements <- c.statement
        ),
        rc : SPL!ResponseConstant (
            response <- rer
        ),
        rer : SPL!RedirectionErrorResponse (
        )
}

rule Default2SelectDefault {
    from
        c : CPL!Default
    to
        sd : SPL!SelectDefault (
            statements <- c.statement
        )
}

rule SubCall2Return {
    from
        c : CPL!SubCall
    to
        r : SPL!ReturnStat (
            returnedValue <- fce
        ),
        fce : SPL!FunctionCallExp (
            functionCall <- fc
        ),
        fc : SPL!FunctionCall (
            function <- CPL!SubAction.allInstances()->CPL!SubAction(sa | (sa.id = c.ref))
        )
}

rule Redirect2Return {
    from
        c : CPL!Redirect
    to
        r : SPL!ReturnStat (
            returnedValue <- rc
        ),
        rc : SPL!ResponseConstant (
            response <- rer
        ),
        rer : SPL!RedirectionErrorResponse (
            errorKind <- if (c.permanent = 'true') then
    #MOVED_PERMANENTLY
else
    #MOVED_TEMPORARILY
endif
        )
}

rule AddressSwitch2SelectStat {
    from
        c : CPL!AddressSwitch
    to
        s : SPL!SelectStat (
            matchedExp <- hp,
            selectCases <- c.addresses,
            selectDefault <- c.otherwise
        ),
        hp : SPL!SIPHeaderPlace (
            header <- if (c.field = 'to') then
    #TO
else
    if (c.field = 'from') then
    #FROM
else
    #CONTACT
endif
endif
        )
}

rule SwitchedAddress2SelectCase {
    from
        c : CPL!SwitchedAddress
    to
        sc : SPL!SelectCase (
            values <- uc,
            statements <- c.statement
        ),
        uc : SPL!URIConstant (
            uri <- if not c.is.oclIsUndefined() then
    c.is
else
    if not c.contains.oclIsUndefined() then
    c.contains
else
    c.subDomainOf
endif
endif
        )
}

rule Otherwise2SelectDefault {
    from
        c : CPL!Otherwise
    to
        sd : SPL!SelectDefault (
            statements <- c.statement
        )
}

lazy rule Location2URIConstant {
    from
        c : CPL!Location
    to
        uc : SPL!URIConstant (
            uri <- c.url
        )
}

