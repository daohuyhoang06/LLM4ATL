module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrVal(name : String) : String =
    self.children->asBag()->select(c | (c.oclIsTypeOf(XML!Attribute) and (c.name = name)))->any(c | true).value;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    if self.getAttrVal(name).oclIsUndefined() then
        false
    else
        (self.getAttrVal(name) = 'true')
    endif;

helper context XML!Element def: get(name : String) : Bag(XML!Node) =
    self.children->asBag()->select(c | (c.name = name));

helper context XML!Element def: getSeq(name : String) : Bag(XML!Node) =
    self.children->asBag()->select(c | (c.name = name));

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->asBag()->select(c | (c.oclIsTypeOf(XML!Attribute) and (c.name = name)))->notEmpty();

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.children->asBag()->select(c | (c.oclIsTypeOf(XML!Element) and (c.name = name)))->notEmpty();

helper context XML!Element def: getText() : String =
    let
        textNode :  = self.children->asBag()->select(c | c.oclIsTypeOf(XML!Text))->any(c | true)
    in
        if textNode.oclIsUndefined() then
        ''
    else
        textNode.value
    endif;

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('isAbstract');

helper context XML!Element def: getEnumId(name : String) : String =
    self.getAttrVal(name);

helper context XML!Element def: getType(name : String) : DSL!Type =
    thisModule.findType(name);

helper def: dslElementsById(id : String) : XML!Element =
    XML!Element.allInstances()->asBag()->select(e | (e.getAttrVal('identity') = id))->any(e | true);

helper def: getSubTypes(name : String) : Bag(XML!Element) =
    XML!Element.allInstances()->asBag()->select(e | ((e.name = 'Class') and (e.getAttrVal('superType') = name)));

helper def: findType(name : String) : DSL!Type =
    DSL!Type.allInstances()->asBag()->any(t | ((t.identity = name) or (t.name = name)));

rule DomainModel {
    from
        s : XML!Root (
            (s.name = 'DomainModel')
        )
    to
        dm : DSL!DomainModel (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            classifiers <- XML!Element.allInstances()->asBag()->select(e | ((e.name = 'Class') or (e.name = 'Relationship'))),
            types <- Bag{simpleTypeString, simpleTypeInteger, simpleTypeBoolean, simpleTypeReal}->union(XML!Element.allInstances()->asBag()->select(e | (e.name = 'Enumeration')))
        ),
        simpleTypeString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- s.getAttrVal('namespace')
        ),
        simpleTypeInteger : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- s.getAttrVal('namespace')
        ),
        simpleTypeBoolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- s.getAttrVal('namespace')
        ),
        simpleTypeReal : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- s.getAttrVal('namespace')
        )
}

rule Class {
    from
        s : XML!Element (
            (s.name = 'Class')
        )
    to
        t : DSL!Class (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.getAttrBool('isAbstract'),
            properties <- s.children->asBag()->select(e | (e.name = 'ValueProperty')),
            superType <- if s.getAttrVal('superType').oclIsUndefined() then
    None
else
    thisModule.dslElementsById(s.getAttrVal('superType'))
endif,
            subTypes <- thisModule.getSubTypes(s.getAttrVal('identity')),
            domainModel <- s.parent
        )
}

rule Relationship {
    from
        s : XML!Element (
            (s.name = 'Relationship')
        )
    to
        t : DSL!Relationship (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            isLoaded <- s.getAttrBool('isLoaded'),
            isAbstract <- s.getAttrBool('isAbstract'),
            isEmbedding <- s.getAttrBool('isEmbedding'),
            properties <- s.children->asBag()->select(e | (e.name = 'ValueProperty')),
            roles <- s.children->asBag()->select(e | (e.name = 'Role')),
            superType <- if s.getAttrVal('superType').oclIsUndefined() then
    None
else
    thisModule.dslElementsById(s.getAttrVal('superType'))
endif,
            subTypes <- thisModule.getSubTypes(s.getAttrVal('identity')),
            domainModel <- s.parent
        )
}

rule Role {
    from
        s : XML!Element (
            (s.name = 'Role')
        )
    to
        t : DSL!Role (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            min <- s.getAttrVal('min').toInteger(),
            max <- s.getAttrVal('max').toInteger(),
            isUnbounded <- s.getAttrBool('isUnbounded'),
            accepts <- s.getAttrVal('accepts'),
            isOrdered <- s.getAttrBool('isOrdered'),
            isNavigableFrom <- s.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- s.getAttrBool('isPropertyGenerator'),
            source <- thisModule.dslElementsById(s.getAttrVal('source')),
            type <- thisModule.dslElementsById(s.getAttrVal('type')),
            relation <- s.parent
        )
}

rule ValueProperty {
    from
        s : XML!Element (
            (s.name = 'ValueProperty')
        )
    to
        t : DSL!ValueProperty (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            owner <- s.parent,
            type <- thisModule.findType(s.getAttrVal('type'))
        )
}

rule Enumeration {
    from
        s : XML!Element (
            (s.name = 'Enumeration')
        )
    to
        t : DSL!Enumeration (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            namespace <- s.getAttrVal('namespace'),
            literals <- s.children->asBag()->select(e | (e.name = 'EnumerationLiteral'))
        )
}

rule EnumerationLiteral {
    from
        s : XML!Element (
            (s.name = 'EnumerationLiteral')
        )
    to
        t : DSL!EnumerationLiteral (
            name <- s.getAttrVal('name'),
            identity <- s.getAttrVal('identity'),
            value <- s.getAttrVal('value').toInteger()
        )
}

