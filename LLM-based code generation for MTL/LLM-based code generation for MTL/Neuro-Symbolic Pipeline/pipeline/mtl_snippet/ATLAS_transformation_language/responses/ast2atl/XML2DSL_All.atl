module XML2DSL;
create OUT : DSL from IN : XML;

helper context XML!Element def: getAttrBool(name : String) : Boolean =
    let
        attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute))->any(c | (c.name = name))
    in
        if attr.oclIsUndefined() then
        false
    else
        (attr.value = 'true')
    endif;

helper context XML!Element def: getAttrVal(name : String) : String =
    let
        attr : XML!Attribute = self.children->select(c | c.oclIsTypeOf(XML!Attribute))->any(c | (c.name = name))
    in
        if attr.oclIsUndefined() then
        ''
    else
        attr.value
    endif;

helper context XML!Element def: get(name : String) : XML!Element =
    self.children->select(c | c.oclIsTypeOf(XML!Element))->any(c | (c.name = name));

helper context XML!Element def: getType(name : String) : DSL!Type =
    thisModule.findType(self.getAttrVal(name));

helper context XML!Element def: getEnumId(name : String) : String =
    self.getAttrVal(name);

helper context XML!Element def: getText() : String =
    let
        text : XML!Text = self.children->select(c | c.oclIsTypeOf(XML!Text))->any(c | true)
    in
        if text.oclIsUndefined() then
        ''
    else
        text.value
    endif;

helper context XML!Element def: getSeq(name : String) : Set(XML!Node) =
    self.children->select(c | (c.name = name));

helper context XML!Element def: hasChildren(name : String) : Boolean =
    self.getSeq(name)->notEmpty();

helper context XML!Element def: hasAttr(name : String) : Boolean =
    self.children->select(c | c.oclIsTypeOf(XML!Attribute))->exists(c | (c.name = name));

helper context XML!Element def: isAbstract() : Boolean =
    self.getAttrBool('isAbstract');

helper def: dslElementsById : Set(DSL!NamedElement) =
    DSL!NamedElement.allInstances();

helper def: getSubTypes(classifier : DSL!Classifier) : Set(DSL!Classifier) =
    DSL!Classifier.allInstances()->select(c | (c.superType = classifier));

helper def: findType(name : String) : DSL!Type =
    DSL!Type.allInstances()->any(t | (t.name = name));

rule DomainModel {
    from
        self : XML!Element (
            (self.name = 'DomainModel')
        )
    to
        dm : DSL!DomainModel (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            isLoaded <- self.getAttrBool('isLoaded'),
            namespace <- self.getAttrVal('namespace'),
            classifiers <- self.children->select(c | (c.oclIsTypeOf(XML!Element) and ((c.name = 'Class') or (c.name = 'Relationship')))),
            types <- self.children->select(c | (c.oclIsTypeOf(XML!Element) and (c.name = 'Enumeration')))->union(Set{tString, tInteger, tBoolean, tReal})
        ),
        tString : DSL!SimpleType (
            name <- 'String',
            identity <- 'String',
            namespace <- self.getAttrVal('namespace')
        ),
        tInteger : DSL!SimpleType (
            name <- 'Integer',
            identity <- 'Integer',
            namespace <- self.getAttrVal('namespace')
        ),
        tBoolean : DSL!SimpleType (
            name <- 'Boolean',
            identity <- 'Boolean',
            namespace <- self.getAttrVal('namespace')
        ),
        tReal : DSL!SimpleType (
            name <- 'Real',
            identity <- 'Real',
            namespace <- self.getAttrVal('namespace')
        )
}

rule Class {
    from
        self : XML!Element (
            (self.name = 'Class')
        )
    to
        c : DSL!Class (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            isLoaded <- self.getAttrBool('isLoaded'),
            namespace <- self.getAttrVal('namespace'),
            isAbstract <- self.getAttrBool('isAbstract'),
            properties <- self.children->select(p | (p.oclIsTypeOf(XML!Element) and (p.name = 'ValueProperty'))),
            superType <- DSL!Classifier.allInstances()->any(cl | (cl.identity = self.getAttrVal('superType')))
        )
}

rule Relationship {
    from
        self : XML!Element (
            (self.name = 'Relationship')
        )
    to
        r : DSL!Relationship (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            isLoaded <- self.getAttrBool('isLoaded'),
            namespace <- self.getAttrVal('namespace'),
            isAbstract <- self.getAttrBool('isAbstract'),
            isEmbedding <- self.getAttrBool('isEmbedding'),
            properties <- self.children->select(p | (p.oclIsTypeOf(XML!Element) and (p.name = 'ValueProperty'))),
            superType <- DSL!Classifier.allInstances()->any(cl | (cl.identity = self.getAttrVal('superType'))),
            roles <- self.children->select(rl | (rl.oclIsTypeOf(XML!Element) and (rl.name = 'Role')))
        )
}

rule Role {
    from
        self : XML!Element (
            (self.name = 'Role')
        )
    to
        ro : DSL!Role (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            min <- self.getAttrVal('min').toInteger(),
            max <- self.getAttrVal('max').toInteger(),
            isUnbounded <- self.getAttrBool('isUnbounded'),
            accepts <- self.getAttrVal('accepts'),
            isOrdered <- self.getAttrBool('isOrdered'),
            isNavigableFrom <- self.getAttrBool('isNavigableFrom'),
            isPropertyGenerator <- self.getAttrBool('isPropertyGenerator'),
            source <- DSL!Classifier.allInstances()->any(cl | (cl.identity = self.getAttrVal('source'))),
            type <- DSL!Classifier.allInstances()->any(cl | (cl.identity = self.getAttrVal('type')))
        )
}

rule ValueProperty {
    from
        self : XML!Element (
            (self.name = 'ValueProperty')
        )
    to
        vp : DSL!ValueProperty (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            owner <- self.parent,
            type <- self.getType('type')
        )
}

rule Enumeration {
    from
        self : XML!Element (
            (self.name = 'Enumeration')
        )
    to
        e : DSL!Enumeration (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            namespace <- self.getAttrVal('namespace'),
            literals <- self.children->select(l | (l.oclIsTypeOf(XML!Element) and (l.name = 'EnumerationLiteral')))
        )
}

rule EnumerationLiteral {
    from
        self : XML!Element (
            (self.name = 'EnumerationLiteral')
        )
    to
        el : DSL!EnumerationLiteral (
            name <- self.getAttrVal('name'),
            identity <- self.getAttrVal('identity'),
            value <- self.getAttrVal('value').toInteger()
        )
}

