    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\n// Đọc file mapping\nconst mappingPath = '/data/models/mapping.json';\nlet mapping = {};\ntry {\n  mapping = JSON.parse(fs.readFileSync(mappingPath, 'utf8'));\n} catch (e) {\n  throw new Error('Lỗi khi đọc file mapping.json: ' + e.message);\n}\n\nfor (const item of $input.all()) {\n  const baseName = item.json.baseName;\n  const modelFiles = mapping[baseName];\n  \n  if (!modelFiles) {\n    item.json.model = '// CẢNH BÁO: Không tìm thấy khai báo model nào trong mapping.json cho ' + baseName;\n    continue;\n  }\n  \n  let combinedModels = '';\n  for (const relativePath of modelFiles) {\n    const fullPath = path.join('/data/models', relativePath);\n    if (fs.existsSync(fullPath)) {\n      const content = fs.readFileSync(fullPath, 'utf8');\n      combinedModels += content + '\\n\\n';\n    } else {\n      combinedModels += '// CẢNH BÁO: Không tìm thấy file ' + fullPath + '\\n\\n';\n    }\n  }\n  item.json.model = combinedModels.trim();\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        -208
      ],
      "id": "read_mapped_models_id",
      "name": "Select and Read Models"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "for (const item of $input.all()) {\n  try {\n    const fs = require('fs');\n    // Read baseName that was generated by Save file name node\n    const baseName = item.json.baseName;\n    \n    const filePath = '/data/snippets/ATLAS_transformation_language/responses/ast/' + baseName + '.json';\n    item.json.fileExists = fs.existsSync(filePath);\n  } catch (error) {\n    item.json.fileExists = false;\n    item.json.fsError = error.message;\n  }\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ],
      "id": "check_file_exists_id",
      "name": "Check File Exists",
      "settings": {}
    },
    {
