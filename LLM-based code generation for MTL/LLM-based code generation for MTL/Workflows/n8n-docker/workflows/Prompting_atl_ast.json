      "id": "validate_pydantic_id",
      "name": "Validate Pydantic",
      "settings": {
        "continueOnFail": true
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "for (const item of $input.all()) {\n  try {\n    const result = JSON.parse(item.json.stdout);\n    item.json.validation_status = result.status;\n    item.json.validation_error = result.message || \"\";\n  } catch(e) {\n    item.json.validation_status = \"error\";\n    item.json.validation_error = item.json.stderr || item.json.stdout || \"Unknown execution error\";\n  }\n  item.json.retry_count = (item.json.retry_count || 0) + 1;\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
