      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1400,
        100
      ],
      "id": "skip_if_exists_id",
      "name": "Skip if exists"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\nconst stateDir = '/data/snippets/ATLAS_transformation_language/responses/ast/.validation_state';\nlet base = {};\ntry { base = $node['Init Retry Counter'].json || {}; } catch (error) { base = {}; }\nlet baseName = base.baseName;\ntry { baseName = $node['Save file name'].json.baseName || baseName; } catch (error) {}\nconst statePath = path.join(stateDir, (baseName || 'unknown') + '.json');\n\nlet previousRetry = 0;\ntry {\n  if (fs.existsSync(statePath)) {\n    previousRetry = Number(JSON.parse(fs.readFileSync(statePath, 'utf8')).retry_count || 0);\n  }\n} catch (error) {}\n\nconst output = [];\nfor (const item of $input.all()) {\n  const stdout = item.json.stdout || '';\n  let result;\n  try {\n    result = JSON.parse(stdout);\n  } catch (error) {\n    result = {\n      valid: false,\n      error_type: 'ValidatorOutputError',\n      error: 'syntax check.py did not return JSON. stdout: ' + String(stdout).slice(0, 2000),\n      stderr: item.json.stderr || ''\n    };\n  }\n\n  const retryCount = previousRetry + 1;\n  const validationError = result.valid ? '' : String(result.error || JSON.stringify(result)).slice(0, 12000);\n  const nextJson = {\n    ...base,\n    retry_count: retryCount,\n    validation_valid: Boolean(result.valid),\n    validation_error: validationError,\n    validation_result: result,\n    validator_stdout: stdout,\n    validator_stderr: item.json.stderr || ''\n  };\n\n  try {\n    fs.mkdirSync(stateDir, { recursive: true });\n    fs.writeFileSync(statePath, JSON.stringify({\n      retry_count: retryCount,\n      validation_valid: nextJson.validation_valid,\n      validation_error: validationError\n    }, null, 2));\n  } catch (error) {\n    nextJson.validation_state_error = error.message;\n  }\n\n  output.push({ json: nextJson });\n}\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        -112
      ],
      "id": "check_result_increment_id",
      "name": "Check Result & Increment",
      "settings": {}
